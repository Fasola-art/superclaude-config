{
  "name": "light",
  "version": "1.0.0",
  "description": "라이트 테마 - 기본 출력 스타일",

  "colors": {
    "background": "#ffffff",
    "text": "#333333",
    "text_secondary": "#666666",
    "heading": "#1a1a1a",
    "link": "#0066cc",
    "link_hover": "#004499",
    "code_bg": "#f5f5f5",
    "code_text": "#d63384",
    "border": "#e0e0e0",
    "table_header": "#f8f9fa",
    "table_border": "#dee2e6",
    "blockquote_bg": "#f8f9fa",
    "blockquote_border": "#0066cc",
    "success": "#28a745",
    "warning": "#ffc107",
    "error": "#dc3545",
    "info": "#17a2b8"
  },

  "fonts": {
    "body": {
      "family": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "size": "16px",
      "line_height": "1.6"
    },
    "heading": {
      "family": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "weight": "600"
    },
    "code": {
      "family": "JetBrains Mono, Menlo, Monaco, Consolas, monospace",
      "size": "14px"
    }
  },

  "spacing": {
    "section": "2rem",
    "paragraph": "1rem",
    "list_item": "0.5rem"
  },

  "code_block": {
    "border_radius": "8px",
    "padding": "1rem",
    "syntax_theme": "github-light"
  },

  "table": {
    "border_radius": "4px",
    "header_bg": "#f8f9fa",
    "stripe_bg": "#fafafa"
  }
}
