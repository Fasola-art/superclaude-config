{
  "module": "news-collector",
  "version": "1.1.0",
  "enabled": true,
  "lastUpdated": "2026-01-29",
  "fetchInterval": 3600,
  "maxArticlesPerSource": 50,
  "archiveRetentionDays": 90,
  "sources": {
    "configFile": "sources/rss_sources.json",
    "totalSources": 14,
    "enabledSources": 13,
    "categories": ["technology", "ai", "crypto", "finance"]
  },
  "filters": {
    "configFile": "filters/filter_rules.json",
    "totalRules": 7,
    "keywords": {
      "include": ["AI", "GPT", "LLM", "Claude", "OpenAI", "Anthropic", "crypto", "bitcoin"],
      "exclude": ["광고", "sponsored", "AD"]
    },
    "categories": ["ai", "crypto", "technology", "finance"],
    "languages": ["ko", "en"],
    "maxAgeHours": 24
  },
  "deduplication": {
    "enabled": true,
    "similarityThreshold": 0.8,
    "windowSeconds": 86400
  },
  "sentiment": {
    "enabled": true,
    "model": "local",
    "positiveThreshold": 0.3,
    "negativeThreshold": -0.3
  },
  "summarization": {
    "enabled": true,
    "maxLength": 200,
    "language": "ko"
  },
  "alerts": {
    "enabled": true,
    "channels": ["desktop"],
    "triggers": {
      "criticalKeywords": ["breaking", "속보", "urgent"],
      "priorityLevels": ["critical", "high"]
    }
  },
  "components": {
    "sources": "sources/",
    "filters": "filters/",
    "alerts": "alerts/",
    "archive": "archive/"
  }
}
