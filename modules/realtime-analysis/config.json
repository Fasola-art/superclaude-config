{
  "module": "realtime-analysis",
  "version": "1.1.0",
  "enabled": true,
  "lastUpdated": "2026-01-29",
  "server": {
    "port": 8080,
    "host": "localhost",
    "maxConnections": 100
  },
  "processing": {
    "workers": 24,
    "bufferSize": 10000,
    "batchInterval": 100,
    "tickBufferSize": 10000,
    "candleMaxHistory": 1000
  },
  "streams": {
    "configFile": "streams/stream_config.json",
    "totalStreams": 6,
    "enabledStreams": 4,
    "market": {
      "enabled": true,
      "sources": ["binance_btc", "binance_eth"]
    },
    "news": {
      "enabled": true,
      "sources": ["news_feed"]
    },
    "signals": {
      "enabled": true,
      "sources": ["trading_signals"]
    }
  },
  "websocket": {
    "maxConcurrentConnections": 10,
    "reconnectDelay": 5000,
    "maxReconnectAttempts": 10,
    "pingInterval": 30000,
    "messageQueueSize": 1000
  },
  "indicators": {
    "sma": [20, 50],
    "ema": [12, 26],
    "rsi": 14,
    "volatility": 20,
    "momentum": 10
  },
  "anomalyDetection": {
    "enabled": true,
    "zScoreThreshold": 3.0,
    "lookbackPeriod": 100
  },
  "storage": {
    "enabled": false,
    "type": "file",
    "path": "~/.claude/modules/realtime-analysis/data",
    "retentionDays": 30
  },
  "dashboards": {
    "default": "market_overview",
    "refreshInterval": 1000,
    "snapshotDir": "dashboards/"
  },
  "alerts": {
    "enabled": true,
    "channels": ["desktop", "sound"],
    "cooldownSeconds": 60,
    "triggers": {
      "anomaly": true,
      "priceThreshold": 0.05,
      "volumeThreshold": 2.0
    }
  },
  "optimization": {
    "cpuAffinity": true,
    "zeroCopy": true,
    "batchInsert": true
  },
  "components": {
    "streams": "streams/",
    "processors": "processors/",
    "websocket": "websocket/",
    "dashboards": "dashboards/"
  }
}
