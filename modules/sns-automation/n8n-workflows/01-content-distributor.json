{
  "name": "01-Content-Distributor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "content",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// 입력 데이터 파싱\nconst data = $input.first().json;\n\nconst mediaUrl = data.media_url || '';\nconst caption = data.caption || '';\nconst platforms = data.platforms || ['instagram'];\n\n// 플랫폼별 설정\nconst platformConfigs = {\n  instagram: { ratio: '1:1', maxLength: 2200 },\n  tiktok: { ratio: '9:16', maxLength: 150 },\n  youtube: { ratio: '9:16', maxLength: 100 },\n  twitter: { ratio: '16:9', maxLength: 280 }\n};\n\nreturn {\n  json: {\n    mediaUrl,\n    caption,\n    platforms,\n    platformConfigs,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "parse-input",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "content": "=다음 캡션을 {{ $json.platforms.join(', ') }} 플랫폼에 맞게 최적화해주세요.\n\n원본 캡션:\n{{ $json.caption }}\n\n각 플랫폼별로 해시태그와 함께 최적화된 캡션을 JSON 형식으로 반환해주세요."
            }
          ]
        },
        "options": {}
      },
      "id": "ai-caption",
      "name": "AI Caption Optimizer",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// AI 응답 파싱\nconst aiResponse = $input.first().json;\nconst originalData = $('Parse Input').first().json;\n\nlet optimizedCaptions = {};\ntry {\n  optimizedCaptions = JSON.parse(aiResponse.message.content);\n} catch (e) {\n  // 파싱 실패 시 원본 사용\n  originalData.platforms.forEach(p => {\n    optimizedCaptions[p] = originalData.caption;\n  });\n}\n\nreturn {\n  json: {\n    ...originalData,\n    optimizedCaptions,\n    status: 'ready_to_post'\n  }\n};"
      },
      "id": "prepare-posts",
      "name": "Prepare Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.platforms.includes('instagram') }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-instagram",
      "name": "Instagram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.platforms.includes('tiktok') }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-tiktok",
      "name": "TikTok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.INSTAGRAM_BUSINESS_ID }}/media",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $('Prepare Posts').first().json.mediaUrl }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Prepare Posts').first().json.optimizedCaptions.instagram }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}"
            }
          ]
        }
      },
      "id": "post-instagram",
      "name": "Post to Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/content/init/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TIKTOK_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "post_info",
              "value": "={{ JSON.stringify({ title: $('Prepare Posts').first().json.optimizedCaptions.tiktok, video_url: $('Prepare Posts').first().json.mediaUrl }) }}"
            }
          ]
        }
      },
      "id": "post-tiktok",
      "name": "Post to TikTok",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "jsCode": "// 결과 집계\nconst results = {\n  instagram: $('Post to Instagram').first()?.json || null,\n  tiktok: $('Post to TikTok').first()?.json || null,\n  timestamp: new Date().toISOString(),\n  status: 'completed'\n};\n\nreturn { json: results };"
      },
      "id": "aggregate-results",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📤 콘텐츠 배포 완료\n\n플랫폼: {{ Object.keys($json).filter(k => $json[k] !== null && k !== 'timestamp' && k !== 'status').join(', ') }}\n시간: {{ $json.timestamp }}"
      },
      "id": "telegram-notify",
      "name": "Telegram Notify",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1650, 300],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1850, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Parse Input", "type": "main", "index": 0 }]]
    },
    "Parse Input": {
      "main": [[{ "node": "AI Caption Optimizer", "type": "main", "index": 0 }]]
    },
    "AI Caption Optimizer": {
      "main": [[{ "node": "Prepare Posts", "type": "main", "index": 0 }]]
    },
    "Prepare Posts": {
      "main": [
        [
          { "node": "Instagram?", "type": "main", "index": 0 },
          { "node": "TikTok?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Instagram?": {
      "main": [
        [{ "node": "Post to Instagram", "type": "main", "index": 0 }],
        []
      ]
    },
    "TikTok?": {
      "main": [
        [{ "node": "Post to TikTok", "type": "main", "index": 0 }],
        []
      ]
    },
    "Post to Instagram": {
      "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]]
    },
    "Post to TikTok": {
      "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]]
    },
    "Aggregate Results": {
      "main": [[{ "node": "Telegram Notify", "type": "main", "index": 0 }]]
    },
    "Telegram Notify": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["sns-automation", "content"],
  "triggerCount": 0,
  "updatedAt": "2026-01-30T00:00:00.000Z",
  "versionId": "1.0.0"
}
