{
  "module": "trading",
  "version": "1.1.0",
  "enabled": true,
  "lastUpdated": "2026-01-29",
  "dataSource": {
    "provider": "yahoo",
    "apiKey": null,
    "rateLimit": 5
  },
  "defaultTimeframe": "1d",
  "defaultPeriod": "1y",
  "indicators": {
    "sma": { "periods": [20, 50, 200] },
    "ema": { "periods": [12, 26] },
    "rsi": { "period": 14 },
    "macd": { "fast": 12, "slow": 26, "signal": 9 },
    "bollinger": { "period": 20, "stdDev": 2 },
    "atr": { "period": 14 },
    "adx": { "period": 14 },
    "stochastic": { "kPeriod": 14, "dPeriod": 3 }
  },
  "strategies": {
    "available": ["momentum", "mean_reversion", "custom"],
    "default": "momentum",
    "settings": {
      "momentum": {
        "useRsi": true,
        "useMacd": true,
        "useMaCross": true,
        "minConfidence": 0.5
      },
      "mean_reversion": {
        "bbPeriod": 20,
        "bbStd": 2.0,
        "zScoreThreshold": 2.0,
        "useRsi": true
      }
    }
  },
  "backtesting": {
    "initialCapital": 10000,
    "commission": 0.001,
    "slippage": 0.001,
    "parallelWorkers": 24,
    "maxDrawdownLimit": 0.2,
    "riskPerTrade": 0.02
  },
  "alerts": {
    "enabled": true,
    "channels": ["desktop"],
    "cooldownSeconds": 300,
    "triggers": {
      "priceAlert": true,
      "signalAlert": true,
      "drawdownAlert": true
    }
  },
  "components": {
    "strategies": "strategies/",
    "indicators": "indicators/",
    "backtesting": "backtesting/",
    "alerts": "alerts/"
  }
}
