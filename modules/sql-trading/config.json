{
  "module": "sql-trading",
  "version": "1.0.0",
  "description": "SQL 기반 대체 데이터 트레이딩 워크플로우",

  "database": {
    "type": "postgresql",
    "connection": "postgresql://reim@localhost:5432/claude_mcp",
    "host": "localhost",
    "port": 5432,
    "database": "claude_mcp",
    "user": "reim",
    "ssl": false,
    "pool_size": 10,
    "timeout": 30
  },

  "data_sources": {
    "logistics": {
      "un_comtrade": {
        "enabled": true,
        "base_url": "https://comtradeapi.un.org/data/v1/get",
        "rate_limit": "100/month",
        "api_key_required": false,
        "description": "UN 국제 무역 통계"
      },
      "marine_traffic_free": {
        "enabled": true,
        "base_url": "https://www.marinetraffic.com/",
        "description": "기본 선박 AIS 데이터 (웹 스크래핑)"
      },
      "open_sea_map": {
        "enabled": true,
        "base_url": "https://openseamap.org/",
        "api_key_required": false,
        "description": "오픈소스 해상 지도 데이터"
      },
      "freightos_baltic": {
        "enabled": true,
        "base_url": "https://fbx.freightos.com/",
        "description": "Freightos Baltic Index (운임 지수)"
      }
    },
    "satellite": {
      "sentinel_hub": {
        "enabled": false,
        "base_url": "https://services.sentinel-hub.com/",
        "api_key_required": true,
        "description": "Sentinel-2 위성 이미지"
      },
      "nasa_earthdata": {
        "enabled": false,
        "base_url": "https://earthdata.nasa.gov/",
        "api_key_required": true,
        "description": "NASA 지구 관측 데이터"
      }
    },
    "market": {
      "yahoo_finance": {
        "enabled": true,
        "description": "Yahoo Finance 시장 데이터"
      },
      "fred": {
        "enabled": true,
        "base_url": "https://api.stlouisfed.org/fred/",
        "api_key_path": "~/.claude/credentials/api-keys.json",
        "description": "Federal Reserve Economic Data"
      }
    }
  },

  "collection_schedule": {
    "logistics": {
      "trade_statistics": "0 6 1 * *",
      "freight_indices": "0 9 * * 1-5",
      "vessel_tracking": "0 */4 * * *"
    },
    "market": {
      "snapshots": "0 9,16 * * 1-5",
      "indicators": "0 8 * * 1-5"
    }
  },

  "analysis": {
    "default_lookback_days": 30,
    "signal_confidence_threshold": 0.7,
    "alert_channels": ["console", "file"],
    "output_format": "markdown"
  },

  "queries_path": "~/.claude/modules/sql-trading/queries/",
  "collectors_path": "~/.claude/modules/sql-trading/collectors/",

  "logging": {
    "level": "INFO",
    "file": "~/.claude/logs/sql-trading.log",
    "max_size_mb": 10,
    "backup_count": 5
  }
}
