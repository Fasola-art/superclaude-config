#!/bin/bash
# SQL Trading CLI - 간단한 명령어 도구
# Usage: trade [command]

# psql 경로 자동 탐색
find_psql() {
    # PATH에서 먼저 검색
    if command -v psql &>/dev/null; then
        echo "psql"
        return
    fi
    # 플랫폼별 후보 경로
    local candidates
    if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
        candidates=(
            "/c/Program Files/PostgreSQL/16/bin/psql"
            "/c/Program Files/PostgreSQL/15/bin/psql"
            "/c/Program Files/PostgreSQL/14/bin/psql"
        )
    else
        candidates=(
            "/opt/homebrew/opt/postgresql@16/bin/psql"
            "/opt/homebrew/bin/psql"
            "/usr/local/bin/psql"
            "/usr/bin/psql"
        )
    fi
    for p in "${candidates[@]}"; do
        if [[ -f "$p" || -f "${p}.exe" ]]; then
            echo "$p"
            return
        fi
    done
    echo "psql"  # 최후 fallback
}

PSQL_BIN="$(find_psql)"
PSQL="$PSQL_BIN -U reim -d claude_mcp -t"
MODULE_DIR="$HOME/.claude/modules/sql-trading"

# 색상
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

show_help() {
    echo ""
    echo "🚢 SQL Trading CLI"
    echo "===================="
    echo ""
    echo "  trade              전체 현황 (기본)"
    echo "  trade signals      트레이딩 신호"
    echo "  trade stocks       종목 현황"
    echo "  trade sectors      섹터 현황"
    echo "  trade freight      운임 지수"
    echo "  trade collect      데이터 수집 (수동)"
    echo "  trade dashboard    대시보드 열기"
    echo "  trade logs         로그 확인"
    echo "  trade status       서비스 상태"
    echo ""
}

show_summary() {
    echo ""
    echo -e "${BLUE}🚢 SQL Trading 현황${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    $PSQL -c "
    SELECT
        '📊 총 레코드: ' || COUNT(*) || '개'
    FROM market_snapshots
    WHERE timestamp > NOW() - INTERVAL '24 hours';
    " 2>/dev/null | grep -v "^$" | head -1

    $PSQL -c "
    SELECT
        '📈 매수 신호: ' || COUNT(*) || '개'
    FROM trading_signals
    WHERE timestamp > NOW() - INTERVAL '2 hours'
      AND signal_type IN ('BUY', 'STRONG_BUY');
    " 2>/dev/null | grep -v "^$" | head -1

    $PSQL -c "
    SELECT
        '📉 매도 신호: ' || COUNT(*) || '개'
    FROM trading_signals
    WHERE timestamp > NOW() - INTERVAL '2 hours'
      AND signal_type IN ('SELL', 'STRONG_SELL');
    " 2>/dev/null | grep -v "^$" | head -1

    $PSQL -c "
    SELECT
        '🕐 최신 수집: ' || TO_CHAR(MAX(timestamp), 'HH24:MI:SS')
    FROM market_snapshots;
    " 2>/dev/null | grep -v "^$" | head -1

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
}

show_signals() {
    echo ""
    echo -e "${YELLOW}🎯 트레이딩 신호${NC}"
    echo ""
    $PSQL -c "
    SELECT
        symbol as 종목,
        signal_type as 신호,
        ROUND(confidence * 100) || '%' as 신뢰도,
        '$' || ROUND(price::numeric, 2) as 가격,
        LEFT(reason, 40) as 근거
    FROM trading_signals
    WHERE timestamp > NOW() - INTERVAL '2 hours'
      AND signal_type != 'HOLD'
    ORDER BY
        CASE signal_type
            WHEN 'STRONG_BUY' THEN 1
            WHEN 'BUY' THEN 2
            WHEN 'SELL' THEN 3
            WHEN 'STRONG_SELL' THEN 4
        END
    LIMIT 15;
    " 2>/dev/null
}

show_stocks() {
    echo ""
    echo -e "${GREEN}📈 종목 현황${NC}"
    echo ""
    $PSQL -c "
    SELECT DISTINCT ON (symbol)
        symbol as 종목,
        '$' || ROUND(price::numeric, 2) as 가격,
        ROUND(change_pct::numeric, 2) || '%' as 변동,
        metadata->>'sector' as 섹터
    FROM market_snapshots
    WHERE timestamp > NOW() - INTERVAL '3 hours'
    ORDER BY symbol, timestamp DESC;
    " 2>/dev/null
}

show_sectors() {
    echo ""
    echo -e "${BLUE}📊 섹터 현황${NC}"
    echo ""
    $PSQL -c "
    SELECT
        CASE metadata->>'sector'
            WHEN 'dry_bulk' THEN '🏭 Dry Bulk'
            WHEN 'container' THEN '📦 Container'
            WHEN 'tanker' THEN '🛢️ Tanker'
            WHEN 'commodity' THEN '💎 Commodity'
            WHEN 'index' THEN '📊 Index'
        END as 섹터,
        COUNT(DISTINCT symbol) || '종목' as 종목수,
        ROUND(AVG(change_pct)::numeric, 2) || '%' as 평균변동
    FROM market_snapshots
    WHERE timestamp > NOW() - INTERVAL '3 hours'
      AND metadata->>'sector' IS NOT NULL
    GROUP BY metadata->>'sector'
    ORDER BY AVG(change_pct) DESC;
    " 2>/dev/null
}

show_freight() {
    echo ""
    echo -e "${YELLOW}📉 운임 지수${NC}"
    echo ""
    $PSQL -c "
    SELECT DISTINCT ON (index_name, route)
        index_name as 지수,
        LEFT(route, 25) as 항로,
        value as 현재값,
        change_pct || '%' as 변동
    FROM freight_indices
    ORDER BY index_name, route, date DESC;
    " 2>/dev/null
}

run_collect() {
    echo "📦 데이터 수집 중..."
    python3 "$MODULE_DIR/collectors/realtime_collector.py" 2>/dev/null
    echo -e "${GREEN}✅ 수집 완료${NC}"
}

open_dashboard() {
    # 서버 확인
    if ! curl -s http://localhost:8080/api/summary > /dev/null 2>&1; then
        echo "🚀 대시보드 서버 시작 중..."
        cd "$MODULE_DIR/dashboard"
        nohup python3 api_server.py > /dev/null 2>&1 &
        sleep 2
    fi
    echo "🌐 대시보드 열기: http://localhost:8080"
    # 크로스플랫폼 브라우저 열기
    if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
        start http://localhost:8080
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        open http://localhost:8080
    else
        xdg-open http://localhost:8080
    fi
}

show_logs() {
    echo ""
    echo -e "${BLUE}📋 최근 로그${NC}"
    echo ""
    echo "=== 수집 로그 ==="
    tail -5 ~/.claude/logs/sql-trading-collector.log 2>/dev/null || echo "로그 없음"
    echo ""
    echo "=== 알림 로그 ==="
    tail -5 ~/.claude/logs/sql-trading-alert.log 2>/dev/null || echo "로그 없음"
}

show_status() {
    echo ""
    echo -e "${BLUE}⚙️ 서비스 상태${NC}"
    echo ""

    # 크로스플랫폼 서비스 상태 확인
    if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
        # Windows: schtasks로 예약 작업 확인
        if schtasks /Query /TN "sql-trading-collector" &>/dev/null; then
            echo -e "📦 데이터 수집: ${GREEN}✅ 활성${NC} (30분 주기)"
        else
            echo -e "📦 데이터 수집: ${RED}❌ 비활성${NC}"
        fi

        if schtasks /Query /TN "sql-trading-alert" &>/dev/null; then
            echo -e "🔔 신호 알림:   ${GREEN}✅ 활성${NC} (5분 주기)"
        else
            echo -e "🔔 신호 알림:   ${RED}❌ 비활성${NC}"
        fi
    else
        # macOS: launchctl
        if launchctl list | grep -q "sql-trading-collector"; then
            echo -e "📦 데이터 수집: ${GREEN}✅ 활성${NC} (30분 주기)"
        else
            echo -e "📦 데이터 수집: ${RED}❌ 비활성${NC}"
        fi

        if launchctl list | grep -q "sql-trading-alert"; then
            echo -e "🔔 신호 알림:   ${GREEN}✅ 활성${NC} (5분 주기)"
        else
            echo -e "🔔 신호 알림:   ${RED}❌ 비활성${NC}"
        fi
    fi

    if curl -s http://localhost:8080/api/summary > /dev/null 2>&1; then
        echo -e "🌐 대시보드:    ${GREEN}✅ 실행중${NC} (http://localhost:8080)"
    else
        echo -e "🌐 대시보드:    ${YELLOW}⏸️ 중지${NC}"
    fi
    echo ""
}

# 메인
case "${1:-}" in
    ""|"summary")
        show_summary
        ;;
    "signals"|"sig"|"s")
        show_signals
        ;;
    "stocks"|"stock"|"st")
        show_stocks
        ;;
    "sectors"|"sector"|"sec")
        show_sectors
        ;;
    "freight"|"fr")
        show_freight
        ;;
    "collect"|"c")
        run_collect
        ;;
    "dashboard"|"dash"|"d")
        open_dashboard
        ;;
    "logs"|"log"|"l")
        show_logs
        ;;
    "status"|"stat")
        show_status
        ;;
    "help"|"-h"|"--help")
        show_help
        ;;
    *)
        echo "❌ 알 수 없는 명령: $1"
        show_help
        ;;
esac
