FROM python:3.11-slim

WORKDIR /app

# 시스템 의존성
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc cron && \
    rm -rf /var/lib/apt/lists/*

# Python 의존성
COPY deploy/requirements-collector.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 수집기 소스 복사
COPY collectors/ ./collectors/

# cron 설정 (1시간마다 수집)
COPY deploy/collector-cron /etc/cron.d/collector-cron
RUN chmod 0644 /etc/cron.d/collector-cron && crontab /etc/cron.d/collector-cron

# 환경변수를 cron에 전달하는 엔트리포인트
COPY deploy/collector-entry.sh /entry.sh
RUN chmod +x /entry.sh

CMD ["/entry.sh"]
