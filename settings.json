{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Grep",
      "Glob",
      "Bash(npm install*)",
      "Bash(npm search*)",
      "Bash(npm uninstall*)",
      "Bash(npx *)",
      "Bash(claude mcp*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(ls*)",
      "Bash(pwd*)",
      "Bash(cat*)",
      "Bash(echo*)",
      "Bash(which*)",
      "Bash(npm run*)",
      "Bash(python*)",
      "Bash(python3*)",
      "Bash(node*)",
      "Bash(npm test*)",
      "Bash(npm build*)",
      "Bash(npx shadcn*)",
      "Bash(npx playwright*)",
      "Bash(gh *)",
      "Bash(mkdir*)",
      "Bash(curl*)",
      "Bash(export*)",
      "Bash(cd*)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch*)",
      "Bash(sudo *)",
      "mcp__context7__*",
      "mcp__taskmaster-ai__*",
      "mcp__ide__*",
      "mcp__mcp-router__*",
      "mcp__filesystem__*",
      "mcp__memory__*",
      "mcp__sequential-thinking__*",
      "Bash(explorer *)",
      "Bash(start *)",
      "Bash(choco *)",
      "Bash(winget *)",
      "Bash(wsl *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(taskkill *)",
      "Bash(lsof *)",
      "Bash(netstat *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf*)"
    ]
  },
  "model": "sonnet",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/UserPromptSubmit/keyword-detector.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/UserPromptSubmit/plan-mode-analyzer.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/UserPromptSubmit/language-enforcer.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/UserPromptSubmit/intent-clarifier.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/UserPromptSubmit/codex-router.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/UserPromptSubmit/context-threshold-85.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PreToolUse/writer-reviewer-hook.py"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PreToolUse/safety-snapshot.py"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PreToolUse/ralph-preflight.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PreToolUse/agent-rules-injector.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PreToolUse/agent-memory-loader.py"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PreToolUse/plan-session-logger.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/Stop/session-saver.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUse/format-python.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUse/format-js-ts.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUse/quality-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUse/error-auto-resolver.py"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUse/ralph-loop-checker.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUse/agent-memory-saver.py"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUse/ralph-loop-checker.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUse/error-auto-resolver.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/MSI/.claude/hooks/PostToolUseFailure/error-collector.py"
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "stable",
  "dangerouslySkipPermissions": true,
  "effortLevel": "medium",
  "files": {
    "autoSave": "onFocusChange",
    "maxMemoryForLargeFilesMB": 4096
  },
  "performance": {
    "enableBackgroundTasks": true,
    "maxConcurrentTasks": 8
  },
  "skipDangerousModePermissionPrompt": true
}
