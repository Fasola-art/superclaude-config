{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Grep",
      "Glob",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(brew *)",
      "Bash(python*)",
      "Bash(python3*)",
      "Bash(node*)",
      "Bash(bun *)",
      "Bash(bun)",
      "Bash(pnpm *)",
      "Bash(go *)",
      "Bash(cargo *)",
      "Bash(gh *)",
      "Bash(claude *)",
      "Bash(ls*)",
      "Bash(pwd*)",
      "Bash(cat*)",
      "Bash(echo*)",
      "Bash(which*)",
      "Bash(open *)",
      "Bash(mkdir*)",
      "Bash(curl*)",
      "Bash(export*)",
      "Bash(cd*)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch*)",
      "Bash(chmod*)",
      "Bash(ln *)",
      "Bash(source*)",
      "Bash(launchctl*)",
      "Bash(sudo *)",
      "Bash(kill *)",
      "Bash(lsof *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(date*)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(docker *)",
      "Bash(psql *)",
      "Bash(ruff *)",
      "Bash(pytest*)",
      "Bash(security *)",
      "Bash(hdiutil *)",
      "Bash(test *)",
      "Bash([ *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(env *)",
      "Bash(printf *)",
      "Bash(true*)",
      "Bash(false*)",
      "mcp__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf*)"
    ]
  },
  "model": "claude-opus-4-6",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/handoff-loader.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/jarvis-morning-briefing.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/context-cleaner.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/auto-context-manager.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/todo-continuation.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/language-enforcer.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/persona-activator.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/intent-clarifier.py"
          }
        ]
      },
      {
        "matcher": "PRD|prd|requirements|spec|specification|create project|create app|create service|build|develop|implement|\\.prd\\.md|PRD\\.md|requirements\\.md|spec\\.md",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/plan-mode-analyzer.py"
          }
        ]
      },
      {
        "matcher": "quick|qk|fast|experiment|exp|parallel|para|fix|undo|rollback|continue|cont|verify|chk|check|test|tst|deploy|dep|cleanup|clean|performance|perf|plan|analyze|map|ultrawork|ulw|deepsearch|ds|strategic|str|visual|vis",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/UserPromptSubmit/keyword-detector.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PreToolUse/writer-reviewer-hook.py"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PreToolUse/rollback-guard.py"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PreToolUse/agent-rules-injector.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PreToolUse/agent-memory-loader.py"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PreToolUse/plan-session-logger.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/Stop/session-saver.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Read|Bash|Grep|Glob|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/jarvis-work-tracker.py"
          }
        ]
      },
      {
        "matcher": "TodoWrite|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/jarvis-task-completion.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/session-snapshot.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/format-python.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/format-js-ts.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/run-tests.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/quality-gate.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/pattern-tracker.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/auto-retry-loop.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/background-notification.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/error-auto-resolver.py"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/ralph-loop-checker.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/PostToolUse/agent-memory-saver.py"
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
