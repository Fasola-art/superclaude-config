{
  "$schema": "https://claude.ai/schemas/mcp.json",
  "version": "1.0.0",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/reim/Documents", "/Users/reim/.claude", "/Users/reim/Desktop"],
      "description": "파일시스템 접근",
      "enabled": true,
      "priority": 10
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "description": "지식 그래프 메모리",
      "enabled": true,
      "priority": 8
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "description": "웹 페이지 가져오기",
      "enabled": true,
      "priority": 7,
      "timeout": 60000
    },
    "time": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-time"],
      "description": "시간/타임존 유틸리티",
      "enabled": true,
      "priority": 5,
      "timeout": 30000
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "단계별 사고 프로세스",
      "enabled": true,
      "priority": 6
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
      },
      "description": "GitHub 연동",
      "enabled": true,
      "priority": 9
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "T0AB8AF7QP9"
      },
      "description": "Slack 연동 (Fasola-Art)",
      "enabled": true,
      "priority": 6
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://reim@localhost:5432/claude_mcp"],
      "description": "PostgreSQL 연동 (claude_mcp DB)",
      "enabled": true,
      "priority": 7
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Brave 검색",
      "enabled": true,
      "priority": 8
    },
    "gdrive": {
      "command": "npx",
      "args": ["-y", "@isaacphi/mcp-gdrive"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/Users/reim/.claude/credentials/gcp-oauth.keys.json"
      },
      "description": "Google Drive 연동",
      "enabled": true,
      "priority": 7
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": {
        "SENTRY_ACCESS_TOKEN": "${SENTRY_ACCESS_TOKEN}"
      },
      "description": "Sentry 에러 트래킹",
      "enabled": true,
      "priority": 5
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-linear"],
      "env": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      },
      "description": "Linear 이슈 트래킹",
      "enabled": true,
      "priority": 5
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${NOTION_TOKEN}\", \"Notion-Version\": \"2022-06-28\"}"
      },
      "description": "Notion 연동",
      "enabled": true,
      "priority": 5
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "description": "Exa AI 검색 (의미론적 웹 검색)",
      "enabled": true,
      "priority": 9,
      "timeout": 60000
    },
    "kie-ai": {
      "command": "python3",
      "args": ["/Users/reim/.claude/mcp-servers/kie-ai/server.py"],
      "env": {
        "KIE_API_KEY": "${KIE_API_KEY}"
      },
      "description": "Kie.ai 통합 API (영상/이미지/음악 생성)",
      "enabled": true,
      "priority": 8,
      "timeout": 120000
    }
  },
  "routing": {
    "default": "filesystem",
    "rules": [
      {"pattern": "file|read|write|directory|path|folder", "server": "filesystem"},
      {"pattern": "memory|remember|recall|knowledge|entity|relation", "server": "memory"},
      {"pattern": "fetch|url|web|http|download", "server": "fetch"},
      {"pattern": "time|date|timezone|clock", "server": "time"},
      {"pattern": "think|reason|step|analyze", "server": "sequential-thinking"},
      {"pattern": "github|repo|issue|pull|commit", "server": "github"},
      {"pattern": "slack|message|channel", "server": "slack"},
      {"pattern": "sql|query|database|postgres", "server": "postgres"},
      {"pattern": "search|brave|find", "server": "brave-search"},
      {"pattern": "gdrive|google|drive|docs|sheets", "server": "gdrive"},
      {"pattern": "sentry|error|exception|crash", "server": "sentry"},
      {"pattern": "linear|issue|task|ticket", "server": "linear"},
      {"pattern": "notion|page|database|block", "server": "notion"},
      {"pattern": "exa|research|paper|study|academic|semantic", "server": "exa"},
      {"pattern": "kie|video|image|music|generate|suno|runway|midjourney", "server": "kie-ai"}
    ]
  }
}
