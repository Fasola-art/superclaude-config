{
  "$schema": "https://json.schemastore.org/mcp-servers.json",
  "mcpServers": {
    "mysql": {
      "command": "npx",
      "args": ["-y", "@benborber/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASSWORD": "",
        "MYSQL_DATABASE": "claude_mcp"
      },
      "description": "MySQL 데이터베이스 연결",
      "enabled": true
    },
    "postgresql": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_CONNECTION_STRING": "postgresql://reim@localhost:5432/claude_mcp"
      },
      "description": "PostgreSQL 데이터베이스 연결",
      "enabled": true
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      },
      "description": "GitHub API 연동",
      "enabled": true
    },
    "local-llm": {
      "command": "python3",
      "args": ["-m", "local_llm.mcp_wrapper"],
      "env": {
        "PYTHONPATH": "~/.claude/modules/local-llm",
        "MLX_MODEL_PATH": "~/.claude/modules/local-llm/models/",
        "DEFAULT_MODEL": "qwen2.5-7b"
      },
      "description": "로컬 LLM 서브에이전트 (MLX/Ollama)",
      "enabled": true
    },
    "ollama": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-ollama"],
      "env": {
        "OLLAMA_HOST": "http://localhost:11434"
      },
      "description": "Ollama 로컬 LLM 서버",
      "enabled": true
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "description": "Playwright 브라우저 자동화 (웹 탐색/테스트)",
      "enabled": true
    }
  }
}
