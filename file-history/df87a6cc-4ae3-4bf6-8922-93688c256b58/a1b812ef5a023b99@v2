{
  "name": "04-Weekly-Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 21 * * 0" }]
        }
      },
      "id": "weekly-trigger",
      "name": "Sunday 21:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.INSTAGRAM_BUSINESS_ID }}/insights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "metric", "value": "impressions,reach,profile_views,follower_count" },
            { "name": "period", "value": "week" },
            { "name": "access_token", "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}" }
          ]
        }
      },
      "id": "fetch-ig-insights",
      "name": "Instagram Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.INSTAGRAM_BUSINESS_ID }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "id,caption,like_count,comments_count,timestamp" },
            { "name": "limit", "value": "10" },
            { "name": "access_token", "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}" }
          ]
        }
      },
      "id": "fetch-ig-posts",
      "name": "Instagram Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 400]
    },
    {
      "parameters": {
        "jsCode": "// 데이터 통합\nconst insights = $('Instagram Insights').first()?.json || {};\nconst posts = $('Instagram Posts').first()?.json || {};\n\n// 인사이트 파싱\nconst metrics = {};\nif (insights.data) {\n  insights.data.forEach(m => {\n    metrics[m.name] = m.values?.[0]?.value || 0;\n  });\n}\n\n// 게시물 정렬 (인게이지먼트 순)\nconst sortedPosts = (posts.data || []).sort((a, b) => {\n  const engA = (a.like_count || 0) + (a.comments_count || 0);\n  const engB = (b.like_count || 0) + (b.comments_count || 0);\n  return engB - engA;\n});\n\nconst topPosts = sortedPosts.slice(0, 5).map((p, i) => ({\n  rank: i + 1,\n  caption: (p.caption || '').substring(0, 50) + '...',\n  likes: p.like_count || 0,\n  comments: p.comments_count || 0,\n  engagement: (p.like_count || 0) + (p.comments_count || 0)\n}));\n\nreturn {\n  json: {\n    period: {\n      start: new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],\n      end: new Date().toISOString().split('T')[0]\n    },\n    metrics: {\n      impressions: metrics.impressions || 0,\n      reach: metrics.reach || 0,\n      profileViews: metrics.profile_views || 0,\n      followers: metrics.follower_count || 0\n    },\n    topPosts,\n    generatedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "aggregate-data",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "content": "=다음 주간 SNS 성과 데이터를 분석하고 인사이트를 제공해주세요.\n\n## 기간\n{{ $json.period.start }} ~ {{ $json.period.end }}\n\n## 주요 지표\n- 노출: {{ $json.metrics.impressions }}\n- 도달: {{ $json.metrics.reach }}\n- 프로필 조회: {{ $json.metrics.profileViews }}\n- 팔로워: {{ $json.metrics.followers }}\n\n## Top 5 게시물\n{{ $json.topPosts.map(p => `${p.rank}. ${p.caption} (좋아요: ${p.likes}, 댓글: ${p.comments})`).join('\\n') }}\n\n다음 형식으로 응답해주세요:\n\n## 📊 주간 성과 요약\n[핵심 성과 3줄 요약]\n\n## 💡 인사이트\n[데이터 기반 인사이트 3개]\n\n## 🎯 다음 주 추천 액션\n[구체적인 액션 아이템 3개]"
            }
          ]
        }
      },
      "id": "ai-analyze",
      "name": "AI Analysis",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [850, 300],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 최종 리포트 포맷팅\nconst aiResponse = $input.first().json;\nconst data = $('Aggregate Data').first().json;\n\nconst report = aiResponse.message?.content || '분석 실패';\n\nreturn {\n  json: {\n    ...data,\n    report,\n    type: 'weekly_report'\n  }\n};"
      },
      "id": "format-report",
      "name": "Format Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📈 주간 SNS 리포트\n\n📅 {{ $json.period.start }} ~ {{ $json.period.end }}\n\n📊 주요 지표\n• 노출: {{ $json.metrics.impressions.toLocaleString() }}\n• 도달: {{ $json.metrics.reach.toLocaleString() }}\n• 프로필 조회: {{ $json.metrics.profileViews.toLocaleString() }}\n• 팔로워: {{ $json.metrics.followers.toLocaleString() }}\n\n{{ $json.report }}\n\n---\n생성: {{ $json.generatedAt }}"
      },
      "id": "send-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1250, 200],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEET_ID }}", "mode": "id" },
        "sheetName": "Weekly Reports",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Period Start": "={{ $json.period.start }}",
            "Period End": "={{ $json.period.end }}",
            "Impressions": "={{ $json.metrics.impressions }}",
            "Reach": "={{ $json.metrics.reach }}",
            "Profile Views": "={{ $json.metrics.profileViews }}",
            "Followers": "={{ $json.metrics.followers }}",
            "Report": "={{ $json.report }}",
            "Generated At": "={{ $json.generatedAt }}"
          }
        }
      },
      "id": "log-report",
      "name": "Log to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1250, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    }
  ],
  "connections": {
    "Sunday 21:00": {
      "main": [
        [
          { "node": "Instagram Insights", "type": "main", "index": 0 },
          { "node": "Instagram Posts", "type": "main", "index": 0 }
        ]
      ]
    },
    "Instagram Insights": {
      "main": [[{ "node": "Aggregate Data", "type": "main", "index": 0 }]]
    },
    "Instagram Posts": {
      "main": [[{ "node": "Aggregate Data", "type": "main", "index": 0 }]]
    },
    "Aggregate Data": {
      "main": [[{ "node": "AI Analysis", "type": "main", "index": 0 }]]
    },
    "AI Analysis": {
      "main": [[{ "node": "Format Report", "type": "main", "index": 0 }]]
    },
    "Format Report": {
      "main": [
        [
          { "node": "Send Telegram", "type": "main", "index": 0 },
          { "node": "Log to Sheet", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["sns-automation", "reporting"],
  "versionId": "1.0.0"
}
