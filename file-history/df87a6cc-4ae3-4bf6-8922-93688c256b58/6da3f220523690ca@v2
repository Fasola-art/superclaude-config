{
  "name": "02-Engagement-Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.INSTAGRAM_BUSINESS_ID }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "id,comments{text,from,timestamp}" },
            { "name": "access_token", "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}" }
          ]
        }
      },
      "id": "fetch-comments",
      "name": "Fetch Comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// 댓글 파싱 및 필터링\nconst response = $input.first().json;\nconst comments = [];\n\nif (response.data) {\n  response.data.forEach(media => {\n    if (media.comments && media.comments.data) {\n      media.comments.data.forEach(comment => {\n        // 최근 15분 내 댓글만\n        const commentTime = new Date(comment.timestamp);\n        const now = new Date();\n        const diffMinutes = (now - commentTime) / (1000 * 60);\n        \n        if (diffMinutes <= 15) {\n          comments.push({\n            id: comment.id,\n            text: comment.text,\n            from: comment.from?.username || 'unknown',\n            mediaId: media.id,\n            timestamp: comment.timestamp\n          });\n        }\n      });\n    }\n  });\n}\n\nreturn comments.map(c => ({ json: c }));"
      },
      "id": "parse-comments",
      "name": "Parse Comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "content": "=다음 댓글을 분류해주세요:\n\n댓글: \"{{ $json.text }}\"\n\n분류 옵션:\n1. fan_comment - 팬 댓글 (칭찬, 응원)\n2. question - 질문\n3. collab_inquiry - 협찬/협업 문의\n4. negative - 부정적 댓글\n5. spam - 스팸\n\nJSON 형식으로 반환: {\"category\": \"분류\", \"suggested_reply\": \"추천 답변\", \"priority\": \"high/medium/low\"}"
            }
          ]
        }
      },
      "id": "classify-comment",
      "name": "AI Classify",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [850, 300],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// AI 분류 결과 파싱\nconst aiResponse = $input.first().json;\nconst originalComment = $('Parse Comments').first().json;\n\nlet classification = {};\ntry {\n  classification = JSON.parse(aiResponse.message.content);\n} catch (e) {\n  classification = {\n    category: 'fan_comment',\n    suggested_reply: '감사합니다 💕',\n    priority: 'low'\n  };\n}\n\nreturn {\n  json: {\n    ...originalComment,\n    ...classification\n  }\n};"
      },
      "id": "merge-classification",
      "name": "Merge Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.category }}",
              "operation": "equals",
              "value2": "fan_comment"
            }
          ]
        }
      },
      "id": "route-fan",
      "name": "Fan Comment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.category }}",
              "operation": "equals",
              "value2": "collab_inquiry"
            }
          ]
        }
      },
      "id": "route-collab",
      "name": "Collab Inquiry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $json.id }}/replies",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "message", "value": "={{ $json.suggested_reply }}" },
            { "name": "access_token", "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}" }
          ]
        }
      },
      "id": "auto-reply",
      "name": "Auto Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🤝 협찬 문의 접수\n\n보낸이: @{{ $json.from }}\n내용: {{ $json.text }}\n\n추천 답변:\n{{ $json.suggested_reply }}"
      },
      "id": "notify-collab",
      "name": "Notify Collab",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1450, 400],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEET_ID }}", "mode": "id" },
        "sheetName": "Engagement",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.timestamp }}",
            "From": "={{ $json.from }}",
            "Comment": "={{ $json.text }}",
            "Category": "={{ $json.category }}",
            "Reply": "={{ $json.suggested_reply }}",
            "Priority": "={{ $json.priority }}"
          }
        }
      },
      "id": "log-to-sheet",
      "name": "Log to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1650, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "Fetch Comments", "type": "main", "index": 0 }]]
    },
    "Fetch Comments": {
      "main": [[{ "node": "Parse Comments", "type": "main", "index": 0 }]]
    },
    "Parse Comments": {
      "main": [[{ "node": "AI Classify", "type": "main", "index": 0 }]]
    },
    "AI Classify": {
      "main": [[{ "node": "Merge Data", "type": "main", "index": 0 }]]
    },
    "Merge Data": {
      "main": [
        [
          { "node": "Fan Comment?", "type": "main", "index": 0 },
          { "node": "Collab Inquiry?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fan Comment?": {
      "main": [
        [{ "node": "Auto Reply", "type": "main", "index": 0 }],
        []
      ]
    },
    "Collab Inquiry?": {
      "main": [
        [{ "node": "Notify Collab", "type": "main", "index": 0 }],
        []
      ]
    },
    "Auto Reply": {
      "main": [[{ "node": "Log to Sheet", "type": "main", "index": 0 }]]
    },
    "Notify Collab": {
      "main": [[{ "node": "Log to Sheet", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["sns-automation", "engagement"],
  "versionId": "1.0.0"
}
