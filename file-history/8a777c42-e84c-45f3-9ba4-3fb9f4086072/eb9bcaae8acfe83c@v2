{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "SuperClaude 백업 설정",

  "auto_backup": {
    "enabled": true,
    "schedule": "0 0 * * *",
    "retention_days": 30
  },

  "targets": {
    "critical": {
      "files": [
        "settings.json",
        "mcp.json",
        "CLAUDE.md",
        "superclaude-config.json"
      ],
      "frequency": "daily",
      "retention": 30
    },
    "high": {
      "files": [
        "AGENTS.md",
        "KEYWORD-TRIGGERS.md",
        "CONTEXT-MANAGER.md",
        "SESSION-MANAGER.md",
        "WRITER-REVIEWER.md"
      ],
      "frequency": "weekly",
      "retention": 14
    },
    "medium": {
      "directories": [
        "error-kb",
        "credentials",
        "profiles"
      ],
      "frequency": "weekly",
      "retention": 7
    }
  },

  "storage": {
    "max_size_mb": 500,
    "compression": true,
    "encryption": false
  },

  "notifications": {
    "on_success": false,
    "on_failure": true,
    "on_low_space": true
  }
}
