import json
import asyncio
import aiohttp
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Optional, Any
from dataclasses import dataclass, asdict
from enum import Enum
import logging

# 설정
CLAUDE_DIR = Path.home() / '.claude'
CONFIG_FILE = CLAUDE_DIR / 'mcp.json'
ROUTER_LOG_DIR = CLAUDE_DIR / 'logs' / 'mcp-router'

# 로깅 설정
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(message)s'
)
logger = logging.getLogger('mcp-router')


class ServerStatus(Enum):
    UNKNOWN = 'unknown'
    HEALTHY = 'healthy'
    DEGRADED = 'degraded'
    UNHEALTHY = 'unhealthy'
    OFFLINE = 'offline'


@dataclass
class ServerConfig:
    name: str
    command: str
    args: List[str]
    env: Dict[str, str]
    priority: int = 0
    timeout: int = 30000
    maxRetries: int = 3
    healthCheck: Optional[str] = None


@dataclass
class ServerState:
    name: str
    status: ServerStatus
    lastCheck: str
    responseTime: float
    errorCount: int
    successCount: int
    process: Optional[Any] = None


class MCPRouter:
    """MCP 서버 라우터"""

    def __init__(self):
        self.servers: Dict[str, ServerConfig] = {}
        self.states: Dict[str, ServerState] = {}
        self.load_balancer = LoadBalancer()
        self.config = self._load_config()
        self._init_servers()

    def _load_config(self) -> Dict:
        """설정 파일 로드"""
        if CONFIG_FILE.exists():
            try:
                return json.loads(CONFIG_FILE.read_text())
            except Exception as e:
                logger.error(f"설정 로드 실패: {e}")
        return {'mcpServers': {}}

    def _init_servers(self):
        """서버 초기화"""
        mcp_servers = self.config.get('mcpServers', {})

        for name, config in mcp_servers.items():
            self.servers[name] = ServerConfig(
                name=name,
                command=config.get('command', ''),
                args=config.get('args', []),
                env=config.get('env', {}),
                priority=config.get('priority', 0),
                timeout=config.get('timeout', 30000),
                maxRetries=config.get('maxRetries', 3),
                healthCheck=config.get('healthCheck')
            )

            self.states[name] = ServerState(
                name=name,
                status=ServerStatus.UNKNOWN,
                lastCheck=datetime.now().isoformat(),
                responseTime=0.0,
                errorCount=0,
                successCount=0
            )

        logger.info(f"{len(self.servers)}개 MCP 서버 초기화됨")

    async def health_check(self, server_name: str) -> ServerStatus:
        """서버 상태 체크"""
        if server_name not in self.servers:
            return ServerStatus.UNKNOWN

        server = self.servers[server_name]
        state = self.states[server_name]

        start_time = datetime.now()

        try:
            # 실제 헬스체크 로직 (서버에 따라 다름)
            # 여기서는 프로세스 존재 여부로 간단히 체크
            if state.process and state.process.returncode is None:
                state.status = ServerStatus.HEALTHY
                state.successCount += 1
            else:
                state.status = ServerStatus.OFFLINE

        except Exception as e:
            logger.error(f"헬스체크 실패 [{server_name}]: {e}")
            state.status = ServerStatus.UNHEALTHY
            state.errorCount += 1

        state.lastCheck = datetime.now().isoformat()
        state.responseTime = (datetime.now() - start_time).total_seconds() * 1000

        return state.status

    async def check_all_servers(self):
        """모든 서버 상태 체크"""
        tasks = [self.health_check(name) for name in self.servers]
        await asyncio.gather(*tasks)

    def get_best_server(self, capability: str) -> Optional[str]:
        """요청에 적합한 서버 선택"""
        return self.load_balancer.select(self.servers, self.states, capability)

    async def route_request(self, request: Dict) -> Dict:
        """요청 라우팅"""
        capability = request.get('capability', 'default')
        server_name = self.get_best_server(capability)

        if not server_name:
            return {
                'success': False,
                'error': f'사용 가능한 서버 없음: {capability}'
            }

        server = self.servers[server_name]
        state = self.states[server_name]

        try:
            # 요청 처리 (실제 구현 필요)
            result = await self._process_request(server, request)
            state.successCount += 1
            return {
                'success': True,
                'server': server_name,
                'result': result
            }

        except Exception as e:
            state.errorCount += 1
            logger.error(f"요청 처리 실패 [{server_name}]: {e}")

            # 재시도
            if state.errorCount <= server.maxRetries:
                return await self.route_request(request)

            return {
                'success': False,
                'server': server_name,
                'error': str(e)
            }

    async def _process_request(self, server: ServerConfig, request: Dict) -> Any:
        """실제 요청 처리 (서버별 구현)"""
        # 각 MCP 서버 타입에 따른 처리
        # 이 부분은 실제 MCP 프로토콜에 맞게 구현 필요
        return {'status': 'processed', 'request': request}

    def get_status_report(self) -> Dict:
        """전체 상태 리포트"""
        return {
            'timestamp': datetime.now().isoformat(),
            'totalServers': len(self.servers),
            'healthyServers': sum(1 for s in self.states.values()
                                   if s.status == ServerStatus.HEALTHY),
            'servers': {
                name: {
                    'status': state.status.value,
                    'lastCheck': state.lastCheck,
                    'responseTime': state.responseTime,
                    'errorCount': state.errorCount,
                    'successCount': state.successCount
                }
                for name, state in self.states.items()
            }
        }


class LoadBalancer:
    """로드 밸런서"""

    def __init__(self):
        self.strategy = 'weighted_round_robin'
        self.current_index = 0

    def select(
        self,
        servers: Dict[str, ServerConfig],
        states: Dict[str, ServerState],
        capability: str
    ) -> Optional[str]:
        """서버 선택"""
        # 건강한 서버만 필터링
        healthy_servers = [
            name for name, state in states.items()
            if state.status in [ServerStatus.HEALTHY, ServerStatus.UNKNOWN]
        ]

        if not healthy_servers:
            return None

        # 가중치 기반 라운드 로빈
        if self.strategy == 'weighted_round_robin':
            return self._weighted_round_robin(healthy_servers, servers)

        # 가장 낮은 지연시간
        if self.strategy == 'least_latency':
            return self._least_latency(healthy_servers, states)

        # 기본: 첫 번째 서버
        return healthy_servers[0]

    def _weighted_round_robin(
        self,
        healthy_servers: List[str],
        servers: Dict[str, ServerConfig]
    ) -> str:
        """가중치 기반 라운드 로빈"""
        # 우선순위 기준 정렬
        sorted_servers = sorted(
            healthy_servers,
            key=lambda n: servers[n].priority,
            reverse=True
        )

        self.current_index = (self.current_index + 1) % len(sorted_servers)
        return sorted_servers[self.current_index]

    def _least_latency(
        self,
        healthy_servers: List[str],
        states: Dict[str, ServerState]
    ) -> str:
        """가장 낮은 지연시간 서버"""
        return min(
            healthy_servers,
            key=lambda n: states[n].responseTime if states[n].responseTime > 0 else float('inf')
        )


# 서버 관리 유틸리티
class ServerManager:
    """MCP 서버 매니저"""

    def __init__(self, router: MCPRouter):
        self.router = router
        self.processes: Dict[str, asyncio.subprocess.Process] = {}

    async def start_server(self, name: str) -> bool:
        """서버 시작"""
        if name not in self.router.servers:
            logger.error(f"알 수 없는 서버: {name}")
            return False

        server = self.router.servers[name]

        try:
            # 환경 변수 설정
            env = {**server.env}

            # 프로세스 시작
            process = await asyncio.create_subprocess_exec(
                server.command,
                *server.args,
                env=env,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )

            self.processes[name] = process
            self.router.states[name].process = process
            self.router.states[name].status = ServerStatus.HEALTHY

            logger.info(f"서버 시작됨: {name} (PID: {process.pid})")
            return True

        except Exception as e:
            logger.error(f"서버 시작 실패 [{name}]: {e}")
            self.router.states[name].status = ServerStatus.UNHEALTHY
            return False

    async def stop_server(self, name: str) -> bool:
        """서버 중지"""
        if name not in self.processes:
            return False

        try:
            process = self.processes[name]
            process.terminate()
            await asyncio.wait_for(process.wait(), timeout=5.0)

            del self.processes[name]
            self.router.states[name].status = ServerStatus.OFFLINE
            self.router.states[name].process = None

            logger.info(f"서버 중지됨: {name}")
            return True

        except asyncio.TimeoutError:
            process.kill()
            logger.warning(f"서버 강제 종료: {name}")
            return True

        except Exception as e:
            logger.error(f"서버 중지 실패 [{name}]: {e}")
            return False

    async def restart_server(self, name: str) -> bool:
        """서버 재시작"""
        await self.stop_server(name)
        return await self.start_server(name)

    async def start_all(self):
        """모든 서버 시작"""
        tasks = [self.start_server(name) for name in self.router.servers]
        await asyncio.gather(*tasks)

    async def stop_all(self):
        """모든 서버 중지"""
        tasks = [self.stop_server(name) for name in list(self.processes.keys())]
        await asyncio.gather(*tasks)


async def main():
    """메인 실행"""
    router = MCPRouter()
    manager = ServerManager(router)

    # 모든 서버 시작
    await manager.start_all()

    # 주기적 헬스체크 (10초 간격)
    while True:
        await router.check_all_servers()
        report = router.get_status_report()
        logger.info(f"상태: {report['healthyServers']}/{report['totalServers']} 서버 정상")
        await asyncio.sleep(10)


if __name__ == '__main__':
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("MCP Router 종료")
