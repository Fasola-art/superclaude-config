#!/usr/bin/env python3
"""
경제 시황 및 전망 자동 생성
- Claude Haiku API + Prompt Caching 사용
- 매일 저녁 10시 자동 생성
- 캐시 적용으로 90% 비용 절감

API 키 설정:
    export ANTHROPIC_API_KEY="your-api-key"
"""

import os
import json
from datetime import datetime
from pathlib import Path
from typing import Dict, Optional

REPORTS_DIR = Path.home() / ".claude" / "modules" / "trading" / "reports" / "daily"

# 캐시할 시스템 프롬프트 (경제 분석 컨텍스트 - 최소 1024 토큰 이상)
SYSTEM_PROMPT = """당신은 전문 경제 애널리스트입니다. 매일 저녁 시장 데이터를 분석하여 투자자를 위한 시황 보고서를 작성합니다.

## 분석 대상 지표

### 1. VIX (CBOE Volatility Index)
- 정의: S&P 500 옵션의 내재변동성을 측정하는 "공포지수"
- 해석 기준:
  - 12 미만: 극단적 낙관 (과열 주의)
  - 12-15: 낮은 변동성 (안정적)
  - 15-20: 보통 수준
  - 20-25: 높은 변동성 (경계)
  - 25 이상: 극단적 공포 (위기 신호)

### 2. MOVE Index (ICE BofAML MOVE)
- 정의: 미국 국채 옵션의 내재변동성 지수 (채권시장 VIX)
- 해석 기준:
  - 60 미만: 매우 낮은 변동성 (채권시장 안정)
  - 60-80: 정상 범위
  - 80-100: 높은 변동성
  - 100-120: 매우 높은 변동성
  - 120 이상: 극단적 스트레스 (2008년, 2020년 수준)

### 3. SOFR (Secured Overnight Financing Rate)
- 정의: 미국 담보부 익일물 금리 (LIBOR 대체)
- 의미: 단기 자금시장 상황 반영
- 연준 기준금리와의 관계: 보통 연방기금금리 범위 내에서 움직임
- 급등 시: 단기 유동성 경색 신호
- 급락 시: 과잉 유동성 또는 안전자산 선호

### 4. 수익률 곡선 (10Y-2Y Spread)
- 정상: 양수 (장기 > 단기)
- 역전: 음수 (경기 침체 선행지표)
- 스티프닝: 스프레드 확대 (경기 회복 기대)
- 플래트닝: 스프레드 축소 (성장 둔화 우려)

### 5. 비트코인 (BTC/USD)
- 위험자산 선호도 지표
- 전통 시장과의 상관관계 증가 추세
- 기관 투자자 참여로 매크로 영향 확대

## 주요 경제 지표 해석

### 연방기금금리 (Federal Funds Rate)
- 연준의 통화정책 핵심 도구
- 인상: 인플레이션 억제, 달러 강세, 주식 하락 압력
- 인하: 경기 부양, 달러 약세, 주식 상승 지지

### CPI/PCE (물가지수)
- 연준 목표: 2%
- 예상 상회: 금리 인상 압력, 주식/채권 하락
- 예상 하회: 금리 인하 기대, 주식/채권 상승

### GDP (국내총생산)
- 분기별 발표 (속보치 → 수정치 → 확정치)
- 예상 상회: 경기 낙관, 주식 상승
- 예상 하회: 경기 우려, 안전자산 선호

### NFP (비농업 고용)
- 매월 첫째 금요일 발표
- 예상 상회: 경기 강세, 금리 인상 압력
- 예상 하회: 경기 우려, 금리 인하 기대

### 실업률
- 연준 목표: 완전고용 (약 4% 수준)
- 상승: 경기 침체 우려
- 하락: 임금 인플레이션 압력

## 보고서 작성 가이드라인

1. **객관성**: 데이터에 기반한 분석만 제공
2. **간결성**: 핵심 정보만 전달 (불필요한 설명 제외)
3. **실용성**: 투자자가 바로 활용 가능한 정보
4. **중립성**: 특정 방향의 투자 추천 금지
5. **정확성**: 수치와 날짜 정확히 기재

## 출력 형식

반드시 다음 형식으로 작성하세요:

1. **시장 현황** (3-4문장)
   - 주요 지수/자산 동향
   - 변동성 수준 평가
   - 특이사항

2. **주요 포인트** (3개)
   - 가장 중요한 데이터/이벤트
   - 수치와 함께 의미 설명

3. **내일 전망** (2-3문장)
   - 예정된 이벤트 영향
   - 주의해야 할 시나리오

## 주의사항

- "~할 것으로 보입니다" 같은 추측 표현 최소화
- 구체적인 매수/매도 추천 절대 금지
- 확인되지 않은 정보 포함 금지
- 과거 데이터와 현재 데이터 명확히 구분
"""


def generate_market_outlook(report_data: Dict) -> Dict:
    """
    Claude Haiku API + Prompt Caching을 사용하여 경제 시황 생성

    Args:
        report_data: 시세, 지표 등 보고서 데이터

    Returns:
        시황 및 전망 딕셔너리
    """
    api_key = os.environ.get('ANTHROPIC_API_KEY')

    if not api_key:
        print("[경고] ANTHROPIC_API_KEY 미설정 - 기본 시황 사용")
        return generate_default_outlook(report_data)

    try:
        from anthropic import Anthropic

        client = Anthropic(api_key=api_key)

        # 데이터 요약 (매일 변하는 부분)
        quotes_summary = "\n".join([
            f"- {q['name']}: {q['price']:.2f} ({q.get('change_pct', 0):+.2f}%)"
            for q in report_data.get('quotes', [])
        ])

        indicators_summary = "\n".join([
            f"- {i['name']}: {i['value']:.2f}% ({i['date']})"
            for i in report_data.get('economic_indicators', [])
        ])

        tomorrow_events = "\n".join([
            f"- {e['time']}: {e['name']} ({e['importance']})"
            for e in report_data.get('tomorrow_events', [])
        ])

        user_prompt = f"""오늘 날짜: {report_data.get('date', datetime.now().strftime('%Y-%m-%d'))}

## 현재 시세
{quotes_summary}

## SOFR/MOVE
- SOFR: {report_data.get('sofr_current', 0):.2f}% - {report_data.get('sofr_analysis', '')}
- MOVE Index: {report_data.get('move_current', 0):.1f} - {report_data.get('move_analysis', '')}

## 주요 경제 지표
{indicators_summary}

## 내일 예정 이벤트
{tomorrow_events}

위 데이터를 바탕으로 시장 시황 보고서를 작성해주세요."""

        # Prompt Caching 적용: 시스템 프롬프트를 두 블록으로 분리
        # 첫 번째: 기본 지시문, 두 번째: 큰 컨텍스트 + cache_control
        message = client.messages.create(
            model="claude-haiku-4-5-20251001",
            max_tokens=1000,
            system=[
                {
                    "type": "text",
                    "text": "당신은 전문 경제 애널리스트입니다. 매일 저녁 시장 데이터를 분석하여 투자자를 위한 시황 보고서를 작성합니다."
                },
                {
                    "type": "text",
                    "text": SYSTEM_PROMPT,
                    "cache_control": {"type": "ephemeral"}  # 5분 캐시 - 여기까지 캐시됨
                }
            ],
            messages=[
                {"role": "user", "content": user_prompt}
            ]
        )

        outlook_text = message.content[0].text

        # 토큰 사용량 로깅 (캐시 포함)
        input_tokens = message.usage.input_tokens
        output_tokens = message.usage.output_tokens
        cache_creation = getattr(message.usage, 'cache_creation_input_tokens', 0)
        cache_read = getattr(message.usage, 'cache_read_input_tokens', 0)

        # 비용 계산 (Haiku 3.5 가격)
        # 일반 입력: $0.80/1M, 캐시 쓰기: $1.00/1M, 캐시 읽기: $0.08/1M, 출력: $4.00/1M
        regular_input = input_tokens - cache_creation - cache_read
        cost = (
            (regular_input * 0.80 / 1_000_000) +
            (cache_creation * 1.00 / 1_000_000) +
            (cache_read * 0.08 / 1_000_000) +
            (output_tokens * 4.00 / 1_000_000)
        )

        cache_status = "MISS" if cache_creation > 0 else ("HIT" if cache_read > 0 else "N/A")
        print(f"[API] Haiku + Cache ({cache_status})")
        print(f"      입력: {input_tokens} (캐시생성: {cache_creation}, 캐시읽기: {cache_read})")
        print(f"      출력: {output_tokens}, 비용: ${cost:.4f}")

        if cache_read > 0:
            # 캐시 히트 시 절감액 계산
            saved = cache_read * (0.80 - 0.08) / 1_000_000
            print(f"      [절감] ${saved:.4f} (캐시 히트)")

        return {
            'generated': True,
            'model': 'claude-3-5-haiku',
            'text': outlook_text,
            'tokens': {
                'input': input_tokens,
                'output': output_tokens,
                'cache_creation': cache_creation,
                'cache_read': cache_read
            },
            'cost': cost,
            'cache_status': cache_status,
            'timestamp': datetime.now().isoformat()
        }

    except Exception as e:
        print(f"[에러] API 호출 실패: {e}")
        import traceback
        traceback.print_exc()
        return generate_default_outlook(report_data)


def generate_default_outlook(report_data: Dict) -> Dict:
    """API 없이 기본 시황 생성 (데이터 기반)"""

    quotes = {q['symbol']: q for q in report_data.get('quotes', [])}

    # VIX 분석
    vix = quotes.get('VIX', {}).get('price', 0)
    if vix < 15:
        vix_comment = "VIX가 15 미만으로 시장 안정세"
    elif vix < 20:
        vix_comment = "VIX가 보통 수준으로 경계 필요"
    else:
        vix_comment = "VIX 상승으로 변동성 확대 주의"

    # MOVE 분석
    move = report_data.get('move_current', 0)
    if move < 80:
        move_comment = "채권시장 안정"
    elif move < 120:
        move_comment = "채권시장 보통 변동성"
    else:
        move_comment = "채권시장 변동성 확대"

    # 비트코인
    btc = quotes.get('BTC', {})
    btc_change = btc.get('change_pct', 0)
    if btc_change > 3:
        btc_comment = "비트코인 강세"
    elif btc_change < -3:
        btc_comment = "비트코인 약세"
    else:
        btc_comment = "비트코인 횡보"

    # 내일 이벤트
    tomorrow = report_data.get('tomorrow_events', [])
    critical_events = [e for e in tomorrow if e.get('importance') == 'critical']

    if critical_events:
        event_warning = f"내일 중요 지표 {len(critical_events)}개 발표 예정으로 변동성 확대 가능"
    else:
        event_warning = "내일 특별한 주요 이벤트 없음"

    text = f"""## 시장 현황
{vix_comment}. {move_comment}. {btc_comment}.

## 주요 포인트
1. VIX {vix:.1f} - {'안정적' if vix < 20 else '주의 필요'}
2. MOVE Index {move:.1f} - {report_data.get('move_analysis', '')}
3. SOFR {report_data.get('sofr_current', 0):.2f}% - {report_data.get('sofr_analysis', '')}

## 내일 전망
{event_warning}. 주요 경제 지표 발표에 따른 시장 반응에 주목."""

    return {
        'generated': False,
        'model': 'rule-based',
        'text': text,
        'tokens': {'input': 0, 'output': 0, 'cache_creation': 0, 'cache_read': 0},
        'cost': 0,
        'cache_status': 'N/A',
        'timestamp': datetime.now().isoformat()
    }


def save_outlook(outlook: Dict, date: str = None):
    """시황 저장"""
    if date is None:
        date = datetime.now().strftime('%Y-%m-%d')

    outlook_file = REPORTS_DIR / f"outlook_{date}.json"
    with open(outlook_file, 'w', encoding='utf-8') as f:
        json.dump(outlook, f, ensure_ascii=False, indent=2)

    print(f"[저장] 시황: {outlook_file}")
    return str(outlook_file)


def load_outlook(date: str = None) -> Optional[Dict]:
    """시황 로드"""
    if date is None:
        date = datetime.now().strftime('%Y-%m-%d')

    outlook_file = REPORTS_DIR / f"outlook_{date}.json"
    if outlook_file.exists():
        with open(outlook_file, 'r', encoding='utf-8') as f:
            return json.load(f)
    return None


# CLI
if __name__ == "__main__":
    import sys
    sys.path.insert(0, str(Path.home() / ".claude" / "modules" / "trading"))

    from reports.export_report import load_report_json

    date = sys.argv[1] if len(sys.argv) > 1 else None
    report = load_report_json(date)

    if report:
        outlook = generate_market_outlook(report)
        print("\n" + "="*50)
        print(outlook['text'])
        print("="*50)
        print(f"\n모델: {outlook['model']}")
        print(f"캐시: {outlook.get('cache_status', 'N/A')}")
        print(f"비용: ${outlook['cost']:.4f}")
        save_outlook(outlook, report.get('date'))
    else:
        print("보고서 데이터 없음")
