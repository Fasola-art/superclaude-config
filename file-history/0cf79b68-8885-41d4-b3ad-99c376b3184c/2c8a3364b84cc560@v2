#!/usr/bin/env node
/**
 * auto-update-checker.js
 * 업데이트 확인 훅 (1일 1회)
 *
 * 트리거: UserPromptSubmit
 * 타임아웃: 5000ms
 */

const fs = require('fs');
const path = require('path');

const CLAUDE_DIR = path.join(process.env.HOME, '.claude');
const VERSION_FILE = path.join(CLAUDE_DIR, 'VERSION');
const UPDATE_CHECK_FILE = path.join(CLAUDE_DIR, 'cache', 'last-update-check.json');

const CURRENT_VERSION = '2.0.9';
const CHECK_INTERVAL_MS = 24 * 60 * 60 * 1000; // 24시간

function getLastCheckTime() {
  try {
    if (fs.existsSync(UPDATE_CHECK_FILE)) {
      const data = JSON.parse(fs.readFileSync(UPDATE_CHECK_FILE, 'utf8'));
      return new Date(data.lastCheck).getTime();
    }
  } catch (e) {
    // 파일 없음
  }
  return 0;
}

function saveCheckTime() {
  const dir = path.dirname(UPDATE_CHECK_FILE);
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }
  fs.writeFileSync(UPDATE_CHECK_FILE, JSON.stringify({
    lastCheck: new Date().toISOString(),
    version: CURRENT_VERSION
  }));
}

function shouldCheck() {
  const lastCheck = getLastCheckTime();
  const now = Date.now();
  return (now - lastCheck) > CHECK_INTERVAL_MS;
}

function getInstalledVersion() {
  try {
    if (fs.existsSync(VERSION_FILE)) {
      return fs.readFileSync(VERSION_FILE, 'utf8').trim();
    }
  } catch (e) {
    // 파일 없음
  }
  return CURRENT_VERSION;
}

// 버전 비교 (semver 간단 구현)
function compareVersions(v1, v2) {
  const parts1 = v1.split('.').map(Number);
  const parts2 = v2.split('.').map(Number);

  for (let i = 0; i < Math.max(parts1.length, parts2.length); i++) {
    const p1 = parts1[i] || 0;
    const p2 = parts2[i] || 0;
    if (p1 > p2) return 1;
    if (p1 < p2) return -1;
  }
  return 0;
}

async function checkForUpdates() {
  // 실제 구현에서는 GitHub releases API 또는 자체 서버 확인
  // 여기서는 시뮬레이션

  const latestVersion = CURRENT_VERSION; // 실제로는 API에서 가져옴
  const installedVersion = getInstalledVersion();

  return {
    installed: installedVersion,
    latest: latestVersion,
    updateAvailable: compareVersions(latestVersion, installedVersion) > 0
  };
}

async function main() {
  try {
    // 24시간 이내 확인했으면 스킵
    if (!shouldCheck()) {
      console.log(JSON.stringify({
        status: 'skipped',
        message: '최근 업데이트 확인 완료'
      }));
      process.exit(0);
    }

    const result = await checkForUpdates();
    saveCheckTime();

    if (result.updateAvailable) {
      console.log(JSON.stringify({
        status: 'update_available',
        installed: result.installed,
        latest: result.latest,
        message: `🔔 새 버전 사용 가능: ${result.latest} (현재: ${result.installed})`
      }));
    } else {
      console.log(JSON.stringify({
        status: 'up_to_date',
        version: result.installed,
        message: '최신 버전 사용 중'
      }));
    }

    process.exit(0);

  } catch (error) {
    console.error(JSON.stringify({ status: 'error', message: error.message }));
    process.exit(1);
  }
}

main();
