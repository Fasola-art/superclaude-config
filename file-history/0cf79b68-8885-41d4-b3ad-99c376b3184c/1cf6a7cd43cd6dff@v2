{
  "$schema": "https://claude.ai/schemas/mcp.json",
  "version": "1.0.0",
  "mcpServers": {
    "mcp-router": {
      "command": "python3",
      "args": ["~/.claude/mcp-router/server.py"],
      "description": "MCP Router - 단일 진입점으로 컨텍스트 최적화",
      "enabled": true
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@anthropic/context7-mcp"],
      "description": "라이브러리 문서 검색",
      "enabled": true
    },
    "sequential": {
      "command": "npx",
      "args": ["-y", "@anthropic/sequential-mcp"],
      "description": "순차 실행 및 코드 분석",
      "enabled": true
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@anthropic/playwright-mcp"],
      "description": "브라우저 자동화",
      "enabled": false
    },
    "playwright-test": {
      "command": "npx",
      "args": ["-y", "@anthropic/playwright-test-mcp"],
      "description": "E2E 테스트 생성/실행/디버깅",
      "enabled": false
    }
  },
  "routing": {
    "default": "mcp-router",
    "rules": [
      {
        "pattern": "library|docs|documentation",
        "server": "context7"
      },
      {
        "pattern": "analyze|symbol|definition",
        "server": "sequential"
      },
      {
        "pattern": "browser|screenshot|navigate",
        "server": "playwright"
      },
      {
        "pattern": "e2e|test|playwright",
        "server": "playwright-test"
      }
    ]
  }
}
