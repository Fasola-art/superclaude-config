#!/usr/bin/env node
/**
 * background-notification.js
 * 백그라운드 작업 알림 훅
 *
 * 트리거: PostToolUse
 * 매처: Task|Bash
 * 타임아웃: 2000ms
 */

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const CLAUDE_DIR = path.join(process.env.HOME, '.claude');
const NOTIFICATIONS_DIR = path.join(CLAUDE_DIR, 'logs', 'notifications');
const CONFIG_FILE = path.join(CLAUDE_DIR, 'settings.json');

// 기본 설정
const DEFAULT_CONFIG = {
  enabled: true,
  soundEnabled: true,
  minDurationForNotification: 5000, // 5초 이상 걸린 작업만
  notifyOnError: true,
  notifyOnSuccess: true
};

function ensureDir() {
  if (!fs.existsSync(NOTIFICATIONS_DIR)) {
    fs.mkdirSync(NOTIFICATIONS_DIR, { recursive: true });
  }
}

function loadConfig() {
  try {
    if (fs.existsSync(CONFIG_FILE)) {
      const settings = JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf8'));
      return { ...DEFAULT_CONFIG, ...(settings.notifications || {}) };
    }
  } catch (e) {
    // 설정 로드 실패
  }
  return DEFAULT_CONFIG;
}

// macOS 네이티브 알림 발송
function sendMacNotification(title, message, sound = true) {
  try {
    const soundArg = sound ? 'sound name "Glass"' : '';
    const script = `display notification "${message}" with title "${title}" ${soundArg}`;
    execSync(`osascript -e '${script}'`, { stdio: 'ignore' });
    return true;
  } catch (e) {
    return false;
  }
}

// 터미널 벨 울리기
function terminalBell() {
  process.stdout.write('\x07');
}

// 알림 로그 저장
function logNotification(notification) {
  ensureDir();

  const logFile = path.join(NOTIFICATIONS_DIR, 'notifications.log');
  const entry = {
    timestamp: new Date().toISOString(),
    ...notification
  };

  const line = JSON.stringify(entry) + '\n';
  fs.appendFileSync(logFile, line);
}

// 작업 시간 추정
function estimateDuration(data) {
  // 실제 duration이 있으면 사용
  if (data.duration) return data.duration;

  // 작업 유형별 예상 시간
  const tool = data.tool || '';
  const command = data.command || '';

  if (tool === 'Task') return 10000; // Task는 기본 10초 이상으로 가정

  // 긴 명령어 패턴
  if (command.includes('npm install') || command.includes('npm run build')) {
    return 30000;
  }
  if (command.includes('test') || command.includes('jest') || command.includes('pytest')) {
    return 15000;
  }

  return 0;
}

// 알림 메시지 생성
function createNotificationMessage(data) {
  const tool = data.tool || 'Unknown';
  const command = data.command || '';
  const exitCode = data.exitCode;
  const isError = exitCode !== 0 || data.stderr;

  let title = '';
  let message = '';

  if (tool === 'Task') {
    title = isError ? '❌ 작업 실패' : '✅ 작업 완료';
    message = data.taskDescription || '백그라운드 작업';
  } else if (tool === 'Bash') {
    const shortCmd = command.split(' ').slice(0, 3).join(' ');
    title = isError ? `❌ 명령 실패: ${shortCmd}` : `✅ 명령 완료: ${shortCmd}`;

    if (isError && data.stderr) {
      message = data.stderr.substring(0, 100);
    } else {
      message = '명령이 완료되었습니다';
    }
  } else {
    title = isError ? '❌ 작업 실패' : '✅ 작업 완료';
    message = `${tool} 작업`;
  }

  return { title, message, isError };
}

// 알림 발송 여부 결정
function shouldNotify(data, config) {
  if (!config.enabled) return false;

  const duration = estimateDuration(data);
  const isError = data.exitCode !== 0 || !!data.stderr;

  // 에러인 경우
  if (isError && config.notifyOnError) return true;

  // 긴 작업인 경우
  if (duration >= config.minDurationForNotification && config.notifyOnSuccess) {
    return true;
  }

  // 특정 명령어 패턴
  const command = data.command || '';
  const longCommands = ['npm install', 'npm run build', 'test', 'deploy'];
  if (longCommands.some(cmd => command.includes(cmd))) {
    return true;
  }

  return false;
}

async function main() {
  try {
    let input = '';
    process.stdin.setEncoding('utf8');

    for await (const chunk of process.stdin) {
      input += chunk;
    }

    const data = JSON.parse(input);
    const config = loadConfig();

    // 알림 필요 여부 확인
    if (!shouldNotify(data, config)) {
      console.log(JSON.stringify({
        status: 'skipped',
        message: '알림 조건 미충족'
      }));
      process.exit(0);
    }

    const { title, message, isError } = createNotificationMessage(data);

    // macOS 알림 발송
    const notificationSent = sendMacNotification(title, message, config.soundEnabled);

    // 터미널 벨
    if (config.soundEnabled) {
      terminalBell();
    }

    // 로그 저장
    logNotification({
      title,
      message,
      isError,
      tool: data.tool,
      command: data.command?.substring(0, 100),
      sent: notificationSent
    });

    const output = {
      status: 'notified',
      title: title,
      message: message,
      notificationSent: notificationSent,
      soundEnabled: config.soundEnabled,
      message: `🔔 알림 발송: ${title}`
    };

    console.log(JSON.stringify(output));
    process.exit(0);

  } catch (error) {
    console.error(JSON.stringify({ status: 'error', message: error.message }));
    process.exit(1);
  }
}

main();
