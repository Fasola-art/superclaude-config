#!/usr/bin/env python3
"""
일일 경제 보고서 v2 - 카페 구성 기반
매일 저녁 10시 실행

⚠️ 정확성 원칙:
- 실제 API 데이터만 사용
- 추정/가공 데이터 사용 금지
- 데이터 출처 명시

보고서 구성:
1. 시세표 (7개 항목)
2. SOFR 일주일간 동향
3. 경제 시황 및 전망 (FRED 실제 데이터 기반)
4. 자산별 디테일 코멘트
"""

import json
import sys
from datetime import datetime, timedelta
from typing import List, Dict, Optional, Any
from dataclasses import dataclass, field, asdict
from pathlib import Path

# 모듈 경로
sys.path.insert(0, str(Path.home() / ".claude" / "modules" / "trading"))
sys.path.insert(0, str(Path.home() / ".claude" / "modules" / "news-collector"))

REPORTS_DIR = Path.home() / ".claude" / "modules" / "trading" / "reports" / "daily"
REPORTS_DIR.mkdir(parents=True, exist_ok=True)


@dataclass
class DailyReportV2:
    """일일 경제 보고서 v2"""
    date: str
    generated_at: str

    # 1. 시세표
    quotes: List[Dict] = field(default_factory=list)

    # 2. SOFR 동향
    sofr_current: Optional[float] = None
    sofr_trend: List[Dict] = field(default_factory=list)
    sofr_analysis: str = ""

    # 3. 경제 지표 (FRED 실제 데이터)
    economic_indicators: List[Dict] = field(default_factory=list)

    # 4. 시장 전망 (데이터 기반)
    market_analysis: Dict = field(default_factory=dict)

    # 5. 내일 일정
    tomorrow_events: List[Dict] = field(default_factory=list)

    # 데이터 출처 및 주의사항
    sources: List[str] = field(default_factory=list)
    warnings: List[str] = field(default_factory=list)


class DailyReportGeneratorV2:
    """일일 보고서 생성기 v2"""

    def __init__(self):
        self.today = datetime.now()

    def collect_market_quotes(self) -> List[Dict]:
        """시세표 데이터 수집"""
        quotes = []

        try:
            from data_sources.market_data_collector import MarketDataCollector

            collector = MarketDataCollector()
            raw_quotes = collector.get_all_quotes()

            for q in raw_quotes:
                quotes.append({
                    'symbol': q.symbol,
                    'name': q.name,
                    'price': q.price,
                    'change_pct': q.change_pct,
                    'source': q.source
                })
        except Exception as e:
            print(f"[경고] 시세 수집 실패: {e}")

        return quotes

    def collect_sofr_data(self) -> tuple:
        """SOFR 데이터 수집"""
        current = None
        trend = []
        analysis = ""

        try:
            from data_sources.market_data_collector import MarketDataCollector

            collector = MarketDataCollector()
            sofr = collector.get_sofr_data()
            trend_data = collector.get_sofr_weekly_trend()

            if sofr:
                current = sofr.rate
                trend = trend_data

                # 추세 분석 (실제 데이터 기반)
                if len(trend) >= 2:
                    first = trend[0]['rate']
                    last = trend[-1]['rate']
                    diff = last - first

                    if abs(diff) < 0.02:
                        direction = "횡보"
                    elif diff > 0:
                        direction = "소폭 상승"
                    else:
                        direction = "소폭 하락"

                    analysis = f"일주일간 {direction} ({first:.2f}% → {last:.2f}%, {diff:+.2f}%p)"

        except Exception as e:
            print(f"[경고] SOFR 수집 실패: {e}")

        return current, trend, analysis

    def collect_economic_indicators(self) -> List[Dict]:
        """FRED 경제 지표 수집 (실제 데이터만)"""
        indicators = []

        try:
            from data_sources.fred_monitor import FREDMonitor

            monitor = FREDMonitor()

            # 주요 지표 목록
            key_indicators = [
                ('FEDFUNDS', '연방기금금리'),
                ('DGS10', '10년 국채 수익률'),
                ('DGS2', '2년 국채 수익률'),
                ('T10Y2Y', '10Y-2Y 스프레드'),
                ('CPIAUCSL', 'CPI'),
                ('UNRATE', '실업률'),
            ]

            for series_id, name in key_indicators:
                data = monitor.get_latest_value(series_id)
                if data:
                    indicators.append({
                        'name': name,
                        'series_id': series_id,
                        'value': data.value,
                        'date': data.date,
                        'change': data.change,
                        'change_pct': data.change_percent,
                        'source': 'FRED (Federal Reserve)'
                    })

        except Exception as e:
            print(f"[경고] FRED 지표 수집 실패: {e}")

        return indicators

    def generate_market_analysis(self, quotes: List[Dict], indicators: List[Dict]) -> Dict:
        """시장 분석 생성 (데이터 기반, 추정 없음)"""
        analysis = {
            'vix_level': None,
            'vix_interpretation': '',
            'yield_curve': None,
            'yield_interpretation': '',
            'fed_funds': None,
            'summary': []
        }

        # VIX 분석
        vix_quote = next((q for q in quotes if q['symbol'] == 'VIX'), None)
        if vix_quote and vix_quote['price'] > 0:
            vix = vix_quote['price']
            analysis['vix_level'] = vix

            # VIX 해석 (객관적 기준)
            if vix < 15:
                analysis['vix_interpretation'] = "낮은 변동성 (장기 평균 이하)"
            elif vix < 20:
                analysis['vix_interpretation'] = "보통 수준의 변동성"
            elif vix < 25:
                analysis['vix_interpretation'] = "다소 높은 변동성"
            else:
                analysis['vix_interpretation'] = "높은 변동성 (경계 구간)"

        # 수익률 곡선
        spread = next((i for i in indicators if i['series_id'] == 'T10Y2Y'), None)
        if spread:
            analysis['yield_curve'] = spread['value']
            if spread['value'] < 0:
                analysis['yield_interpretation'] = "수익률 곡선 역전 (경기 침체 신호)"
            elif spread['value'] < 0.5:
                analysis['yield_interpretation'] = "수익률 곡선 평탄화"
            else:
                analysis['yield_interpretation'] = "정상적인 수익률 곡선"

        # 연방기금금리
        fed = next((i for i in indicators if i['series_id'] == 'FEDFUNDS'), None)
        if fed:
            analysis['fed_funds'] = fed['value']

        return analysis

    def get_tomorrow_events(self) -> List[Dict]:
        """내일 경제 지표 일정"""
        events = []

        try:
            from data_sources.economic_calendar import EconomicCalendar

            calendar = EconomicCalendar()
            tomorrow = datetime.now() + timedelta(days=1)
            month_events = calendar.generate_monthly_events(tomorrow.year, tomorrow.month)

            for event in month_events:
                if event.date.date() == tomorrow.date():
                    events.append({
                        'time': event.time_est,
                        'name': event.name,
                        'importance': event.importance.value,
                        'impact': event.impact
                    })
        except Exception as e:
            print(f"[경고] 일정 로드 실패: {e}")

        return events

    def generate_report(self) -> DailyReportV2:
        """보고서 생성"""
        print("[보고서] 일일 경제 보고서 v2 생성 시작...")

        # 1. 시세표
        quotes = self.collect_market_quotes()
        print(f"  - 시세표: {len([q for q in quotes if q['price'] > 0])}/{len(quotes)} 수집")

        # 2. SOFR
        sofr_current, sofr_trend, sofr_analysis = self.collect_sofr_data()
        print(f"  - SOFR: {'성공' if sofr_current else '실패'}")

        # 3. 경제 지표
        indicators = self.collect_economic_indicators()
        print(f"  - 경제 지표: {len(indicators)}개")

        # 4. 시장 분석
        market_analysis = self.generate_market_analysis(quotes, indicators)

        # 5. 내일 일정
        tomorrow = self.get_tomorrow_events()
        print(f"  - 내일 일정: {len(tomorrow)}개")

        # 데이터 출처
        sources = [
            "Yahoo Finance (시세)",
            "CoinGecko (비트코인)",
            "NY Fed (SOFR)",
            "FRED - Federal Reserve Economic Data (경제 지표)"
        ]

        # 주의사항
        warnings = [
            "⚠️ 선물 가격(ES, NQ, GC)은 Yahoo Finance 기준으로 실시간 CME 데이터와 차이가 있을 수 있습니다.",
            "⚠️ MOVE Index는 Bloomberg/ICE 유료 데이터로 자동 수집이 불가능합니다.",
            "⚠️ 본 보고서는 정보 제공 목적이며 투자 조언이 아닙니다."
        ]

        report = DailyReportV2(
            date=self.today.strftime('%Y-%m-%d'),
            generated_at=datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            quotes=quotes,
            sofr_current=sofr_current,
            sofr_trend=sofr_trend,
            sofr_analysis=sofr_analysis,
            economic_indicators=indicators,
            market_analysis=market_analysis,
            tomorrow_events=tomorrow,
            sources=sources,
            warnings=warnings
        )

        return report

    def format_markdown(self, report: DailyReportV2) -> str:
        """마크다운 포맷"""
        lines = [
            f"# 📊 일일 경제 보고서",
            f"> **{report.date}** | 생성: {report.generated_at}",
            "",
            "---",
            ""
        ]

        # 1. 시세표
        lines.extend([
            "## 1️⃣ 시세표",
            "",
            "| # | 항목 | 가격 | 변동 |",
            "|---|------|------|------|"
        ])

        for i, q in enumerate(report.quotes, 1):
            if q['price'] > 0:
                change = f"{q['change_pct']:+.2f}%" if q['change_pct'] else "-"
                lines.append(f"| {i} | {q['name']} | **{q['price']:,.2f}** | {change} |")
            else:
                lines.append(f"| {i} | {q['name']} | ⚠️ 수집 실패 | - |")

        lines.extend(["", f"*출처: {report.quotes[0]['source'] if report.quotes else 'N/A'}*", ""])

        # 2. SOFR 동향
        lines.extend([
            "---",
            "",
            "## 2️⃣ SOFR 일주일간 동향",
            ""
        ])

        if report.sofr_current:
            lines.append(f"**현재 SOFR**: {report.sofr_current:.2f}%")
            lines.append("")

            if report.sofr_trend:
                trend_str = " → ".join([f"{t['date'][-5:]}: {t['rate']:.2f}%" for t in report.sofr_trend[-5:]])
                lines.append(f"**추이**: {trend_str}")
                lines.append("")

            if report.sofr_analysis:
                lines.append(f"**분석**: {report.sofr_analysis}")

            lines.append("")
            lines.append("*출처: NY Fed (공식)*")
        else:
            lines.append("⚠️ SOFR 데이터 수집 실패")

        lines.append("")

        # 3. 경제 지표
        lines.extend([
            "---",
            "",
            "## 3️⃣ 주요 경제 지표 (FRED)",
            "",
            "| 지표 | 값 | 기준일 |",
            "|------|-----|--------|"
        ])

        for ind in report.economic_indicators:
            unit = "%" if "금리" in ind['name'] or "률" in ind['name'] or "스프레드" in ind['name'] else ""
            lines.append(f"| {ind['name']} | **{ind['value']:.2f}{unit}** | {ind['date']} |")

        lines.extend(["", "*출처: FRED (Federal Reserve Economic Data)*", ""])

        # 4. 시장 분석
        lines.extend([
            "---",
            "",
            "## 4️⃣ 시장 현황 분석",
            ""
        ])

        ma = report.market_analysis

        if ma.get('vix_level'):
            lines.append(f"### VIX (변동성 지수)")
            lines.append(f"- **현재**: {ma['vix_level']:.2f}")
            lines.append(f"- **해석**: {ma['vix_interpretation']}")
            lines.append("")

        if ma.get('yield_curve') is not None:
            lines.append(f"### 수익률 곡선 (10Y-2Y)")
            lines.append(f"- **스프레드**: {ma['yield_curve']:.2f}%p")
            lines.append(f"- **해석**: {ma['yield_interpretation']}")
            lines.append("")

        if ma.get('fed_funds'):
            lines.append(f"### 연방기금금리")
            lines.append(f"- **현재**: {ma['fed_funds']:.2f}%")
            lines.append("")

        # 5. 내일 일정
        if report.tomorrow_events:
            lines.extend([
                "---",
                "",
                "## 5️⃣ 내일 예정 이벤트",
                "",
                "| 시간 | 지표 | 중요도 |",
                "|------|------|--------|"
            ])

            importance_emoji = {"critical": "🔴", "high": "🟠", "medium": "🟡", "low": "⚪"}

            for event in report.tomorrow_events:
                emoji = importance_emoji.get(event['importance'], "⚪")
                lines.append(f"| {event['time']} | {emoji} {event['name']} | {event['importance']} |")

            lines.append("")

        # 데이터 출처
        lines.extend([
            "---",
            "",
            "## 📌 데이터 출처",
            ""
        ])
        for source in report.sources:
            lines.append(f"- {source}")

        # 주의사항
        lines.extend([
            "",
            "---",
            "",
            "## ⚠️ 주의사항",
            ""
        ])
        for warning in report.warnings:
            lines.append(f"- {warning}")

        lines.append("")

        return "\n".join(lines)

    def save_report(self, report: DailyReportV2) -> str:
        """보고서 저장"""
        content = self.format_markdown(report)
        filename = REPORTS_DIR / f"daily_report_{report.date}.md"

        with open(filename, 'w', encoding='utf-8') as f:
            f.write(content)

        # JSON도 저장 (데이터 백업용)
        json_filename = REPORTS_DIR / f"daily_report_{report.date}.json"
        with open(json_filename, 'w', encoding='utf-8') as f:
            json.dump(asdict(report), f, indent=2, ensure_ascii=False, default=str)

        print(f"[저장] {filename}")
        return str(filename)


def generate_daily_report_v2():
    """일일 보고서 생성 (외부 호출용)"""
    generator = DailyReportGeneratorV2()
    report = generator.generate_report()
    filepath = generator.save_report(report)
    return filepath, report


# CLI 실행
if __name__ == "__main__":
    filepath, report = generate_daily_report_v2()

    generator = DailyReportGeneratorV2()
    print("\n" + "="*60)
    print(generator.format_markdown(report))
