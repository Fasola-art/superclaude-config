#!/usr/bin/env node
/**
 * error-warning-hook.js
 * Error KB 기반 사전 경고 훅
 *
 * 트리거: PreToolUse
 * 매처: Edit|Write|MultiEdit
 * 타임아웃: 2000ms
 */

const fs = require('fs');
const path = require('path');

const CLAUDE_DIR = path.join(process.env.HOME, '.claude');
const ERROR_KB_DIR = path.join(CLAUDE_DIR, 'error-kb');
const RESOLVED_DIR = path.join(ERROR_KB_DIR, 'resolved');
const PATTERNS_FILE = path.join(CLAUDE_DIR, 'patterns', 'error-success-map.json');

// Jaccard 유사도 계산
function tokenize(text) {
  return text.toLowerCase()
    .replace(/[^a-z0-9가-힣\s]/g, ' ')
    .split(/\s+/)
    .filter(word => word.length > 2);
}

function jaccardSimilarity(text1, text2) {
  const set1 = new Set(tokenize(text1));
  const set2 = new Set(tokenize(text2));

  const intersection = new Set([...set1].filter(x => set2.has(x)));
  const union = new Set([...set1, ...set2]);

  return union.size > 0 ? intersection.size / union.size : 0;
}

// 해결된 에러에서 유사한 패턴 검색
function searchResolvedErrors(content, filePath) {
  const warnings = [];

  try {
    if (!fs.existsSync(RESOLVED_DIR)) return warnings;

    const files = fs.readdirSync(RESOLVED_DIR).filter(f => f.endsWith('.json'));

    for (const file of files) {
      try {
        const errorData = JSON.parse(fs.readFileSync(path.join(RESOLVED_DIR, file), 'utf8'));
        const errorText = errorData.error || '';

        // 파일 경로가 관련있는지 확인
        const relatedFiles = errorData.relatedFiles || [];
        const isRelatedFile = relatedFiles.some(rf =>
          filePath.includes(rf) || rf.includes(path.basename(filePath))
        );

        if (isRelatedFile) {
          warnings.push({
            type: 'related_file',
            error: errorData.error,
            solution: errorData.solution,
            confidence: 0.8
          });
        }

        // 코드 내용과 에러 메시지 유사도 검사
        const similarity = jaccardSimilarity(content, errorText);
        if (similarity > 0.5) {
          warnings.push({
            type: 'similar_pattern',
            error: errorData.error,
            solution: errorData.solution,
            confidence: similarity
          });
        }
      } catch (e) {
        // 개별 파일 오류 무시
      }
    }
  } catch (e) {
    // 디렉토리 오류 무시
  }

  return warnings;
}

// 일반적인 코드 패턴 경고
function checkCommonPatterns(content, filePath) {
  const warnings = [];

  const patterns = [
    {
      pattern: /console\.log\(/g,
      message: '프로덕션 코드에 console.log가 포함되어 있습니다',
      severity: 'warning'
    },
    {
      pattern: /TODO|FIXME|HACK/g,
      message: '미완료 작업 표시가 있습니다',
      severity: 'info'
    },
    {
      pattern: /password|secret|api_key|apikey/gi,
      message: '민감한 정보가 하드코딩되어 있을 수 있습니다',
      severity: 'error'
    },
    {
      pattern: /eval\(|Function\(/g,
      message: 'eval() 또는 Function() 사용은 보안 위험입니다',
      severity: 'error'
    },
    {
      pattern: /innerHTML\s*=/g,
      message: 'innerHTML 직접 할당은 XSS 위험이 있습니다',
      severity: 'warning'
    }
  ];

  for (const p of patterns) {
    if (p.pattern.test(content)) {
      warnings.push({
        type: 'code_pattern',
        message: p.message,
        severity: p.severity
      });
    }
  }

  return warnings;
}

async function main() {
  try {
    let input = '';
    process.stdin.setEncoding('utf8');

    for await (const chunk of process.stdin) {
      input += chunk;
    }

    const data = JSON.parse(input);
    const filePath = data.file_path || data.path || '';
    const content = data.content || data.new_string || '';

    const allWarnings = [];

    // Error KB 검색
    const kbWarnings = searchResolvedErrors(content, filePath);
    allWarnings.push(...kbWarnings);

    // 코드 패턴 검사
    const patternWarnings = checkCommonPatterns(content, filePath);
    allWarnings.push(...patternWarnings);

    if (allWarnings.length > 0) {
      // 심각도별 정렬
      const severityOrder = { error: 0, warning: 1, info: 2 };
      allWarnings.sort((a, b) =>
        (severityOrder[a.severity] || 2) - (severityOrder[b.severity] || 2)
      );

      const output = {
        status: 'warning',
        warningCount: allWarnings.length,
        warnings: allWarnings.slice(0, 5), // 최대 5개
        message: `⚠️ ${allWarnings.length}개 잠재적 문제 감지`
      };

      console.log(JSON.stringify(output));
    } else {
      console.log(JSON.stringify({
        status: 'ok',
        message: '사전 경고 없음'
      }));
    }

    process.exit(0);

  } catch (error) {
    console.error(JSON.stringify({ status: 'error', message: error.message }));
    process.exit(1);
  }
}

main();
