{
  "module": "realtime-analysis",
  "version": "1.0.0",
  "enabled": true,
  "server": {
    "port": 8080,
    "host": "localhost",
    "maxConnections": 100
  },
  "processing": {
    "workers": 24,
    "bufferSize": 10000,
    "batchInterval": 100
  },
  "streams": {
    "market": {
      "enabled": false,
      "sources": []
    },
    "social": {
      "enabled": false,
      "sources": []
    }
  },
  "storage": {
    "enabled": false,
    "type": "file",
    "path": "~/.claude/modules/realtime-analysis/data",
    "retentionDays": 30
  },
  "dashboards": {
    "default": "market_overview",
    "refreshInterval": 1000
  },
  "alerts": {
    "enabled": true,
    "channels": ["desktop", "sound"],
    "cooldownSeconds": 60
  },
  "optimization": {
    "cpuAffinity": true,
    "zeroCopy": true,
    "batchInsert": true
  }
}
