<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.superclaude.news-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/reim/.claude/scripts/scheduled_collectors.py</string>
        <string>all</string>
    </array>

    <!-- 매일 저녁 10시 실행 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/reim/.claude/logs/news-collector.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/reim/.claude/logs/news-collector.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/reim/.claude/modules/trading:/Users/reim/.claude/modules/news-collector</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
