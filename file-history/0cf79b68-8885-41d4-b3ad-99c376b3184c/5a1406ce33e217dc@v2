#!/usr/bin/env node
/**
 * session-snapshot.js
 * 세션 자동 스냅샷 훅
 *
 * 트리거: PostToolUse
 * 매처: TodoWrite|Bash|Write|Edit
 * 타임아웃: 3000ms
 */

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const CLAUDE_DIR = path.join(process.env.HOME, '.claude');
const SNAPSHOTS_DIR = path.join(CLAUDE_DIR, 'shell-snapshots');
const MAX_SNAPSHOTS = 10;

function ensureDir() {
  if (!fs.existsSync(SNAPSHOTS_DIR)) {
    fs.mkdirSync(SNAPSHOTS_DIR, { recursive: true });
  }
}

function generateSnapshotId() {
  return `snap_${Date.now()}_${crypto.randomBytes(4).toString('hex')}`;
}

function getTimestamp() {
  const now = new Date();
  return now.toISOString().replace(/[:.]/g, '-').substring(0, 19);
}

function cleanOldSnapshots() {
  try {
    const files = fs.readdirSync(SNAPSHOTS_DIR)
      .filter(f => f.endsWith('.json'))
      .map(f => ({
        name: f,
        path: path.join(SNAPSHOTS_DIR, f),
        mtime: fs.statSync(path.join(SNAPSHOTS_DIR, f)).mtime.getTime()
      }))
      .sort((a, b) => b.mtime - a.mtime);

    // 최대 개수 초과 시 오래된 것 삭제
    if (files.length > MAX_SNAPSHOTS) {
      const toDelete = files.slice(MAX_SNAPSHOTS);
      toDelete.forEach(f => {
        try {
          fs.unlinkSync(f.path);
        } catch (e) {
          // 삭제 실패 무시
        }
      });
      return toDelete.length;
    }
  } catch (e) {
    // 정리 실패 무시
  }
  return 0;
}

function loadCurrentState() {
  // 현재 Todo 상태 로드
  const todosDir = path.join(CLAUDE_DIR, 'todos');
  const todos = [];

  try {
    if (fs.existsSync(todosDir)) {
      const files = fs.readdirSync(todosDir).filter(f => f.endsWith('.json'));
      for (const file of files) {
        try {
          const data = JSON.parse(fs.readFileSync(path.join(todosDir, file), 'utf8'));
          if (Array.isArray(data)) {
            todos.push(...data);
          } else {
            todos.push(data);
          }
        } catch (e) {
          // 개별 파일 오류 무시
        }
      }
    }
  } catch (e) {
    // 폴더 오류 무시
  }

  return { todos };
}

function createSnapshot(data, currentState) {
  const snapshot = {
    id: generateSnapshotId(),
    timestamp: new Date().toISOString(),
    trigger: {
      tool: data.tool || 'unknown',
      file: data.file_path || data.path || null
    },
    state: {
      todos: currentState.todos.map(t => ({
        id: t.id,
        subject: t.subject,
        status: t.status
      })),
      todosCount: currentState.todos.length,
      incompleteTodos: currentState.todos.filter(t =>
        t.status !== 'completed' && t.status !== 'cancelled'
      ).length
    },
    context: {
      cwd: process.cwd(),
      sessionId: process.env.CLAUDE_SESSION_ID || null
    }
  };

  return snapshot;
}

function saveSnapshot(snapshot) {
  ensureDir();
  const filename = `snapshot_${getTimestamp()}.json`;
  const filePath = path.join(SNAPSHOTS_DIR, filename);
  fs.writeFileSync(filePath, JSON.stringify(snapshot, null, 2));
  return filename;
}

async function main() {
  try {
    let input = '';
    process.stdin.setEncoding('utf8');

    for await (const chunk of process.stdin) {
      input += chunk;
    }

    const data = JSON.parse(input);
    const currentState = loadCurrentState();

    // 스냅샷 생성
    const snapshot = createSnapshot(data, currentState);
    const filename = saveSnapshot(snapshot);

    // 오래된 스냅샷 정리
    const deleted = cleanOldSnapshots();

    console.log(JSON.stringify({
      status: 'snapshot_created',
      snapshotId: snapshot.id,
      filename: filename,
      todosCount: snapshot.state.todosCount,
      incompleteTodos: snapshot.state.incompleteTodos,
      deletedOld: deleted,
      message: `📸 스냅샷 저장됨: ${filename}`
    }));

    process.exit(0);

  } catch (error) {
    console.error(JSON.stringify({ status: 'error', message: error.message }));
    process.exit(1);
  }
}

main();
