#!/usr/bin/env node
/**
 * keyword-detector.js
 * Vibe/Mode 키워드 감지 훅
 *
 * 트리거: UserPromptSubmit
 * 타임아웃: 1000ms
 */

const VIBE_KEYWORDS = {
  '빠르게': { aliases: ['qk', 'quick', '급하게', '바로'], action: 'quick_mode' },
  '실험': { aliases: ['exp', '시험', '테스트해볼게'], action: 'experiment_mode' },
  '동시에': { aliases: ['para', '병렬로', '한꺼번에'], action: 'parallel_mode' },
  '고쳐': { aliases: ['fix', '수정해', '버그'], action: 'fix_mode' },
  '되돌려': { aliases: ['undo', '롤백', '취소해'], action: 'undo_mode' },
  '계속': { aliases: ['cont', '이어서', '계속해'], action: 'continue_mode' },
  '확인해': { aliases: ['chk', '검증해', '체크해'], action: 'verify_mode' },
  '테스트해': { aliases: ['tst', '테스트 실행', 'test'], action: 'test_mode' },
  '배포해': { aliases: ['dep', 'deploy', '릴리즈'], action: 'deploy_mode' },
  '정리해': { aliases: ['clean', '클린업', '청소해'], action: 'cleanup_mode' },
  '성능': { aliases: ['perf', 'performance', '최적화'], action: 'performance_mode' },
  '계획': { aliases: ['plan', '플랜', '설계'], action: 'plan_mode' },
  '분석': { aliases: ['map', '매핑', '구조 파악'], action: 'analyze_mode' }
};

const MODE_KEYWORDS = {
  'ultrawork': { aliases: ['ulw', '울트라워크', '최대성능'], personas: ['explorer', 'librarian', 'analyzer'] },
  'deepsearch': { aliases: ['ds', '딥서치', '깊은검색'], personas: ['explorer'] },
  'strategic': { aliases: ['str', '전략', '전략적'], personas: ['architect'] },
  'visual': { aliases: ['vis', '시각', '이미지'], personas: ['multimodal', 'frontend'] }
};

function detectKeywords(prompt) {
  const result = {
    vibeKeywords: [],
    modeKeywords: [],
    detectedActions: [],
    activatedPersonas: []
  };

  const lowerPrompt = prompt.toLowerCase();

  // Vibe Keywords 감지
  for (const [keyword, config] of Object.entries(VIBE_KEYWORDS)) {
    const allTerms = [keyword, ...config.aliases];
    for (const term of allTerms) {
      if (lowerPrompt.includes(term.toLowerCase())) {
        result.vibeKeywords.push(keyword);
        result.detectedActions.push(config.action);
        break;
      }
    }
  }

  // Mode Keywords 감지
  for (const [keyword, config] of Object.entries(MODE_KEYWORDS)) {
    const allTerms = [keyword, ...config.aliases];
    for (const term of allTerms) {
      if (lowerPrompt.includes(term.toLowerCase())) {
        result.modeKeywords.push(keyword);
        result.activatedPersonas.push(...config.personas);
        break;
      }
    }
  }

  // 중복 제거
  result.activatedPersonas = [...new Set(result.activatedPersonas)];

  return result;
}

// 메인 실행
async function main() {
  try {
    // stdin에서 프롬프트 읽기
    let input = '';
    process.stdin.setEncoding('utf8');

    for await (const chunk of process.stdin) {
      input += chunk;
    }

    const data = JSON.parse(input);
    const prompt = data.prompt || data.message || '';

    const detection = detectKeywords(prompt);

    // 결과 출력
    if (detection.vibeKeywords.length > 0 || detection.modeKeywords.length > 0) {
      const output = {
        status: 'detected',
        ...detection,
        message: `감지됨: Vibe[${detection.vibeKeywords.join(', ')}] Mode[${detection.modeKeywords.join(', ')}]`
      };
      console.log(JSON.stringify(output));
    } else {
      console.log(JSON.stringify({ status: 'none', message: '키워드 없음' }));
    }

    process.exit(0);
  } catch (error) {
    console.error(JSON.stringify({ status: 'error', message: error.message }));
    process.exit(1);
  }
}

main();
