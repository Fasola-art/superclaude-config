#!/usr/bin/env node
/**
 * error-auto-resolver.js
 * Ralph Loop - 에러 자동 해결 훅
 *
 * 트리거: PostToolUse
 * 매처: Bash|Task
 * 타임아웃: 30000ms
 */

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const CLAUDE_DIR = path.join(process.env.HOME, '.claude');
const ERROR_KB_DIR = path.join(CLAUDE_DIR, 'error-kb');
const PENDING_DIR = path.join(ERROR_KB_DIR, 'pending');
const RESOLVED_DIR = path.join(ERROR_KB_DIR, 'resolved');
const PATTERNS_FILE = path.join(CLAUDE_DIR, 'patterns', 'error-success-map.json');

const CONFIG = {
  similarityThreshold: 0.70,
  maxRalphRetries: 10
};

// 디렉토리 생성
function ensureDirs() {
  [ERROR_KB_DIR, PENDING_DIR, RESOLVED_DIR].forEach(dir => {
    if (!fs.existsSync(dir)) {
      fs.mkdirSync(dir, { recursive: true });
    }
  });
}

// 에러 ID 생성
function generateErrorId(error) {
  const prefix = error.substring(0, 20).replace(/[^a-zA-Z]/g, '');
  const hash = crypto.randomBytes(4).toString('hex');
  return `error_${prefix}_${hash}`;
}

// 에러 타입 분류
function classifyError(errorMessage) {
  const classifications = [
    { type: 'module_not_found', patterns: ['Cannot find module', 'Module not found', 'ENOENT'] },
    { type: 'typescript_error', patterns: ['TS2304', 'TS2339', 'TS2345', 'TS2322', 'TS2307'] },
    { type: 'build_error', patterns: ['Build failed', 'Compilation failed', 'webpack', 'esbuild'] },
    { type: 'test_error', patterns: ['Test failed', 'FAIL', 'AssertionError'] },
    { type: 'lint_error', patterns: ['ESLint', 'Parsing error', 'prettier'] },
    { type: 'react_error', patterns: ['React', 'hook', 'component', 'Invalid hook call'] },
    { type: 'next_error', patterns: ['Next.js', 'getServerSideProps', 'Hydration'] },
    { type: 'permission_error', patterns: ['EACCES', 'Permission denied', 'EPERM'] },
    { type: 'network_error', patterns: ['ECONNRESET', 'timeout', 'fetch failed'] }
  ];

  for (const cls of classifications) {
    if (cls.patterns.some(p => errorMessage.includes(p))) {
      return cls.type;
    }
  }
  return 'runtime_error';
}

// Jaccard 유사도
function tokenize(text) {
  return text.toLowerCase()
    .replace(/[^a-z0-9가-힣\s]/g, ' ')
    .split(/\s+/)
    .filter(word => word.length > 2);
}

function jaccardSimilarity(text1, text2) {
  const set1 = new Set(tokenize(text1));
  const set2 = new Set(tokenize(text2));

  const intersection = new Set([...set1].filter(x => set2.has(x)));
  const union = new Set([...set1, ...set2]);

  return union.size > 0 ? intersection.size / union.size : 0;
}

// 해결된 에러에서 유사 에러 검색
function searchResolvedErrors(errorMessage) {
  try {
    if (!fs.existsSync(RESOLVED_DIR)) return null;

    const files = fs.readdirSync(RESOLVED_DIR).filter(f => f.endsWith('.json'));
    let bestMatch = null;
    let bestScore = 0;

    for (const file of files) {
      try {
        const data = JSON.parse(fs.readFileSync(path.join(RESOLVED_DIR, file), 'utf8'));
        const score = jaccardSimilarity(errorMessage, data.error || '');

        if (score > bestScore && score >= CONFIG.similarityThreshold) {
          bestScore = score;
          bestMatch = { ...data, similarity: score };
        }
      } catch (e) {
        // 개별 파일 오류 무시
      }
    }

    return bestMatch;
  } catch (e) {
    return null;
  }
}

// 퀵 픽스 패턴 검색
function searchQuickFix(errorMessage) {
  try {
    if (!fs.existsSync(PATTERNS_FILE)) return null;

    const patterns = JSON.parse(fs.readFileSync(PATTERNS_FILE, 'utf8'));
    const patternList = patterns.patterns || [];

    for (const p of patternList) {
      const regex = new RegExp(p.regex);
      const match = errorMessage.match(regex);
      if (match) {
        let fix = p.fix;
        // $1, $2 등 치환
        match.forEach((m, i) => {
          fix = fix.replace(`$${i}`, m);
        });
        return {
          id: p.id,
          fix: fix,
          description: p.description
        };
      }
    }
  } catch (e) {
    // 패턴 파일 오류
  }
  return null;
}

// 에러를 pending에 저장
function saveToKB(errorEntry) {
  ensureDirs();
  const filePath = path.join(PENDING_DIR, `${errorEntry.id}.json`);
  fs.writeFileSync(filePath, JSON.stringify(errorEntry, null, 2));
}

// 에러 실패 여부 감지
function isError(result) {
  const errorIndicators = [
    'error', 'Error', 'ERROR',
    'failed', 'Failed', 'FAILED',
    'exception', 'Exception',
    'ENOENT', 'EACCES', 'EPERM'
  ];

  if (result.exitCode && result.exitCode !== 0) return true;
  if (result.stderr && result.stderr.trim()) return true;

  const output = result.stdout || result.output || '';
  return errorIndicators.some(ind => output.includes(ind));
}

async function main() {
  try {
    let input = '';
    process.stdin.setEncoding('utf8');

    for await (const chunk of process.stdin) {
      input += chunk;
    }

    const data = JSON.parse(input);
    const command = data.command || '';
    const output = data.stdout || data.output || '';
    const stderr = data.stderr || '';
    const exitCode = data.exitCode || 0;

    // 성공한 경우
    if (!isError({ exitCode, stderr, stdout: output })) {
      console.log(JSON.stringify({
        status: 'success',
        message: '명령 성공'
      }));
      process.exit(0);
    }

    // 에러 발생
    const errorMessage = stderr || output;
    const errorType = classifyError(errorMessage);

    // 1. 해결된 에러에서 유사 에러 검색
    const similarError = searchResolvedErrors(errorMessage);
    if (similarError) {
      console.log(JSON.stringify({
        status: 'solution_found',
        similarity: Math.round(similarError.similarity * 100),
        error: similarError.error,
        solution: similarError.solution,
        successCommand: similarError.successCommand,
        message: `🔧 유사 에러 발견 (${Math.round(similarError.similarity * 100)}%): ${similarError.solution}`
      }));
      process.exit(0);
    }

    // 2. 퀵 픽스 패턴 검색
    const quickFix = searchQuickFix(errorMessage);
    if (quickFix) {
      console.log(JSON.stringify({
        status: 'quick_fix',
        fix: quickFix.fix,
        description: quickFix.description,
        message: `💡 퀵 픽스: ${quickFix.description} - ${quickFix.fix}`
      }));
      process.exit(0);
    }

    // 3. 새 에러로 KB에 저장
    const errorEntry = {
      id: generateErrorId(errorMessage),
      command: command,
      error: errorMessage.substring(0, 1000), // 최대 1000자
      errorType: errorType,
      timestamp: new Date().toISOString(),
      projectPath: process.cwd()
    };

    saveToKB(errorEntry);

    console.log(JSON.stringify({
      status: 'new_error',
      errorId: errorEntry.id,
      errorType: errorType,
      message: `❌ 새 에러 기록됨: ${errorType}`
    }));

    process.exit(0);

  } catch (error) {
    console.error(JSON.stringify({ status: 'error', message: error.message }));
    process.exit(1);
  }
}

main();
