"""
Claude Haiku 요약 모듈
STT 결과를 음악 레슨 요약으로 변환

사용법:
    from summarizer import summarize_lesson

    summary = summarize_lesson("레슨 텍스트 내용...")
    print(summary["main_points"])
"""

from __future__ import annotations

import json
from dataclasses import dataclass
from pathlib import Path
from typing import List, Optional

import anthropic


@dataclass
class LessonSummary:
    """레슨 요약 결과"""
    title: str              # 레슨 제목 (자동 생성)
    date: str               # 레슨 날짜
    student_name: str       # 학생 이름 (추론)
    main_points: List[str]  # 주요 포인트
    key_concepts: List[str] # 핵심 개념/기법
    homework: List[str]     # 숙제/연습 과제
    next_lesson: List[str]  # 다음 수업 준비사항
    raw_summary: str        # 전체 요약 텍스트


def load_api_key() -> str:
    """Anthropic API 키 로드"""
    key_path = Path.home() / ".claude" / "credentials" / "api-keys.json"
    if not key_path.exists():
        raise FileNotFoundError(f"API 키 파일 없음: {key_path}")

    with open(key_path) as f:
        keys = json.load(f)

    if "anthropic" not in keys:
        raise KeyError("anthropic 키가 api-keys.json에 없음")

    return keys["anthropic"]["api_key"]


LESSON_SUMMARY_PROMPT = """당신은 음악 레슨 녹음을 분석하고 요약하는 전문가입니다.

다음 음악 레슨 녹음 텍스트를 분석하여 구조화된 요약을 작성해주세요.

## 지침
1. 레슨의 핵심 내용을 파악하세요
2. 선생님이 강조한 포인트를 놓치지 마세요
3. 학생이 연습해야 할 과제를 명확히 정리하세요
4. 음악 용어는 정확하게 사용하세요

## 출력 형식 (JSON)
반드시 아래 형식의 JSON만 출력하세요 (다른 텍스트 없이):

EXAMPLE_START
{{
    "title": "레슨 제목",
    "student_name": "학생 이름 또는 빈 문자열",
    "main_points": ["포인트1", "포인트2"],
    "key_concepts": ["개념1", "개념2"],
    "homework": ["과제1", "과제2"],
    "next_lesson": ["준비사항1", "준비사항2"],
    "summary": "전체 요약 (2-3문장)"
}}
EXAMPLE_END

## 레슨 녹음 텍스트
{transcript}
"""


def summarize_lesson(
    transcript: str,
    lesson_date: Optional[str] = None
) -> LessonSummary:
    """
    레슨 녹음 텍스트를 요약

    Args:
        transcript: STT 변환된 레슨 텍스트
        lesson_date: 레슨 날짜 (YYYY-MM-DD 형식, 없으면 오늘)

    Returns:
        LessonSummary: 구조화된 레슨 요약
    """
    from datetime import date

    # 날짜 설정
    if lesson_date is None:
        lesson_date = date.today().isoformat()

    # API 키 로드
    api_key = load_api_key()
    client = anthropic.Anthropic(api_key=api_key)

    # Claude 호출
    message = client.messages.create(
        model="claude-3-5-haiku-20241022",  # Haiku 사용 (빠르고 저렴)
        max_tokens=2048,
        messages=[
            {
                "role": "user",
                "content": LESSON_SUMMARY_PROMPT.format(transcript=transcript)
            }
        ]
    )

    # 응답 파싱
    response_text = message.content[0].text

    # JSON 추출 (코드 블록 처리)
    json_str = response_text
    if "```json" in response_text:
        json_start = response_text.find("```json") + 7
        json_end = response_text.find("```", json_start)
        json_str = response_text[json_start:json_end].strip()
    elif "```" in response_text:
        json_start = response_text.find("```") + 3
        json_end = response_text.find("```", json_start)
        json_str = response_text[json_start:json_end].strip()

    # JSON 객체 직접 추출 시도 (중괄호 기준)
    if not json_str.startswith("{"):
        start_idx = json_str.find("{")
        end_idx = json_str.rfind("}") + 1
        if start_idx != -1 and end_idx > start_idx:
            json_str = json_str[start_idx:end_idx]

    try:
        data = json.loads(json_str)
    except json.JSONDecodeError as e:
        # 파싱 실패 시 기본값 반환
        return LessonSummary(
            title="음악 레슨",
            date=lesson_date,
            student_name="",
            main_points=["요약 생성 실패"],
            key_concepts=[],
            homework=[],
            next_lesson=[],
            raw_summary=response_text
        )

    return LessonSummary(
        title=data.get("title", "음악 레슨"),
        date=lesson_date,
        student_name=data.get("student_name", ""),
        main_points=data.get("main_points", []),
        key_concepts=data.get("key_concepts", []),
        homework=data.get("homework", []),
        next_lesson=data.get("next_lesson", []),
        raw_summary=data.get("summary", "")
    )


def format_summary_markdown(summary: LessonSummary) -> str:
    """요약을 마크다운 형식으로 변환"""
    lines = [
        f"# {summary.title}",
        f"",
        f"**날짜**: {summary.date}",
    ]

    if summary.student_name:
        lines.append(f"**학생**: {summary.student_name}")

    lines.append("")
    lines.append("## 📌 주요 포인트")
    for point in summary.main_points:
        lines.append(f"- {point}")

    if summary.key_concepts:
        lines.append("")
        lines.append("## 🎵 핵심 개념")
        for concept in summary.key_concepts:
            lines.append(f"- {concept}")

    if summary.homework:
        lines.append("")
        lines.append("## 📝 숙제/연습 과제")
        for hw in summary.homework:
            lines.append(f"- [ ] {hw}")

    if summary.next_lesson:
        lines.append("")
        lines.append("## 📅 다음 수업 준비")
        for prep in summary.next_lesson:
            lines.append(f"- {prep}")

    if summary.raw_summary:
        lines.append("")
        lines.append("---")
        lines.append(f"*{summary.raw_summary}*")

    return "\n".join(lines)


if __name__ == "__main__":
    # 테스트용 샘플 텍스트
    sample_transcript = """
    오늘 레슨에서는 바흐의 인벤션 1번을 집중적으로 연습했습니다.
    특히 오른손과 왼손의 독립적인 움직임이 중요합니다.
    메트로놈 60으로 시작해서 천천히 템포를 올려보세요.
    다음 주까지 1페이지를 완성해 오시고, 손가락 번호를 꼭 확인하세요.
    """

    try:
        summary = summarize_lesson(sample_transcript)
        print(format_summary_markdown(summary))
    except Exception as e:
        print(f"❌ 오류: {e}")
