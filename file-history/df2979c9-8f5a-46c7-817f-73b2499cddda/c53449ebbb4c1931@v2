<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude.sql-trading-alert</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/reim/.claude/modules/sql-trading/collectors/signal_alert.py</string>
    </array>

    <!-- 5분마다 실행 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- 로그 파일 -->
    <key>StandardOutPath</key>
    <string>/Users/reim/.claude/logs/sql-trading-alert.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/reim/.claude/logs/sql-trading-alert.error.log</string>

    <!-- 시스템 시작시 자동 실행 -->
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
