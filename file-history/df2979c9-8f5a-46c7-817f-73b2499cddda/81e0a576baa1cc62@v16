            'pacific_mid': [25.0, 180.0],  // 태평양 중간
            'pacific_n': [40.0, -170.0],   // 북태평양
            'atlantic_n': [45.0, -40.0],   // 북대서양
            'cape_good': [-34.0, 18.5],    // 희망봉
            'indian_mid': [0.0, 75.0],     // 인도양 중간
            'south_china': [15.0, 115.0],  // 남중국해
            'east_china': [30.0, 125.0],   // 동중국해
            'japan_south': [30.0, 135.0],  // 일본 남쪽
            'med_east': [35.0, 25.0],      // 지중해 동쪽
            'med_west': [36.0, 5.0],       // 지중해 서쪽
            'biscay': [45.0, -5.0],        // 비스케이만
        };

        // 항로별 경유지 정의 (출발지_도착지: [경유지들])
        const routeWaypoints = {
            // ===== 아시아 → 미국 서해안 (북태평양) =====
            'Shanghai_Los Angeles': ['east_china', 'japan_south', [35, 160], [38, -160], [35, -140]],
            'Shanghai_Long Beach': ['east_china', 'japan_south', [35, 160], [38, -160], [35, -140]],
            'Busan_Seattle': ['japan_south', [40, 170], [45, -170], [48, -140]],
            'Busan_Long Beach': ['japan_south', [35, 160], [38, -160], [35, -140]],
            'Tokyo_Los Angeles': [[35, 150], [38, 170], [40, -170], [38, -140]],
            'Hong Kong_Los Angeles': ['south_china', 'east_china', 'japan_south', [35, 160], [38, -160], [35, -140]],

            // ===== 아시아 → 유럽 (수에즈 경유) =====
            'Singapore_Rotterdam': ['indian_mid', 'aden', 'suez_s', 'suez_n', 'med_east', 'med_west', 'biscay'],
            'Chennai_Antwerp': ['indian_mid', 'aden', 'suez_s', 'suez_n', 'med_east', 'med_west', 'biscay'],
            'Hong Kong_Rotterdam': ['south_china', 'malacca', 'indian_mid', 'aden', 'suez_s', 'suez_n', 'med_east', 'med_west', 'biscay'],
            'Shanghai_Rotterdam': ['east_china', 'south_china', 'malacca', 'indian_mid', 'aden', 'suez_s', 'suez_n', 'med_east', 'med_west', 'biscay'],
            'Busan_Rotterdam': ['east_china', 'south_china', 'malacca', 'indian_mid', 'aden', 'suez_s', 'suez_n', 'med_east', 'med_west', 'biscay'],
            'Singapore_Hamburg': ['indian_mid', 'aden', 'suez_s', 'suez_n', 'med_east', 'med_west', 'biscay'],

            // ===== 중동 → 아시아 (탱커) =====
            'Ras Tanura_Yokohama': ['hormuz', [20, 65], 'indian_mid', 'malacca', 'south_china', 'east_china'],
            'Ras Tanura_Singapore': ['hormuz', [20, 65], 'indian_mid'],
            'Ras Tanura_Shanghai': ['hormuz', [20, 65], 'indian_mid', 'malacca', 'south_china', 'east_china'],
            'Kuwait_Singapore': ['hormuz', [20, 60], 'indian_mid'],
            'Kuwait_Yokohama': ['hormuz', [20, 65], 'indian_mid', 'malacca', 'south_china', 'east_china'],

            // ===== 호주 → 아시아 (벌크/철광석) =====
            'Port Hedland_Qingdao': [[-15, 115], [0, 115], 'south_china', 'east_china'],
            'Port Hedland_Shanghai': [[-15, 115], [0, 115], 'south_china', 'east_china'],
            'Newcastle_Shanghai': [[-30, 155], [-20, 140], [0, 130], 'south_china', 'east_china'],
            'Newcastle_Busan': [[-30, 155], [-20, 140], [0, 130], 'south_china', 'east_china'],

            // ===== 유럽 → 미국 동해안 (대서양) =====
            'Rotterdam_New York': ['biscay', [48, -20], [45, -40], [42, -60]],
            'Rotterdam_Savannah': ['biscay', [48, -20], [42, -40], [35, -60]],
            'Hamburg_New York': ['biscay', [50, -10], [48, -30], [45, -50], [42, -65]],
            'Hamburg_Savannah': ['biscay', [48, -20], [42, -40], [35, -60]],
            'Antwerp_New York': ['biscay', [48, -20], [45, -40], [42, -60]],

            // ===== 미국 → 유럽 (역방향) =====
            'New York_Rotterdam': [[42, -60], [45, -40], [48, -20], 'biscay'],
            'Savannah_Rotterdam': [[35, -65], [40, -50], [45, -30], 'biscay'],
            'Los Angeles_Rotterdam': [[30, -120], [20, -110], [10, -85], [10, -60], [10, -30], 'cape_good', 'aden', 'suez_s', 'suez_n', 'med_west', 'biscay'],

            // ===== 미국 → 아시아 =====
            'Los Angeles_Shanghai': [[35, -135], [38, -160], [40, 175], [35, 150], 'japan_south', 'east_china'],
            'Los Angeles_Tokyo': [[35, -135], [38, -160], [40, 175], [35, 150]],
            'Seattle_Busan': [[48, -135], [50, -170], [45, 175], [40, 150], 'japan_south'],
            'Long Beach_Hong Kong': [[35, -135], [35, -160], [35, 180], [30, 150], 'east_china', 'south_china'],

            // ===== 남미 =====
            'Santos_Rotterdam': [[-25, -45], [-10, -30], [10, -25], [30, -15], 'biscay'],
            'Santos_Shanghai': [[-25, -45], [-35, -20], 'cape_good', 'indian_mid', 'malacca', 'south_china', 'east_china'],

            // ===== 지중해 =====
            'Port Said_Genoa': ['med_east', [36, 15]],
            'Port Said_Rotterdam': ['med_east', 'med_west', 'biscay'],
            'Genoa_New York': ['med_west', [38, -5], [38, -30], [40, -55]],

            // ===== 아프리카 =====
            'Durban_Rotterdam': [[-30, 35], 'cape_good', [-20, 0], [0, -10], [20, -15], 'biscay'],
            'Lagos_Rotterdam': [[5, 5], [20, -15], 'biscay'],
        };

        // 실제 해상 항로 생성
        function createSeaRoute(origin, dest) {
            const start = portCoords[origin];
            const end = portCoords[dest];
            if (!start || !end) return null;

            const routeKey = `${origin}_${dest}`;
            const waypoints = routeWaypoints[routeKey];

            let points = [start];

            if (waypoints) {
                waypoints.forEach(wp => {
                    if (Array.isArray(wp)) {
                        points.push(wp);
                    } else if (seaWaypoints[wp]) {
                        points.push(seaWaypoints[wp]);
                    }
                });
            }

            points.push(end);

            // 각 구간을 부드럽게 연결
            const smoothedPoints = [];
            for (let i = 0; i < points.length - 1; i++) {
                const segmentPoints = smoothSegment(points[i], points[i + 1], 10);
                smoothedPoints.push(...segmentPoints);
            }
            smoothedPoints.push(end);

            return smoothedPoints;
        }

        // 구간 부드럽게 연결
        function smoothSegment(start, end, numPoints) {
            const points = [];
            for (let i = 0; i < numPoints; i++) {
                const t = i / numPoints;
                const lat = start[0] + (end[0] - start[0]) * t;
                const lng = start[1] + (end[1] - start[1]) * t;
                points.push([lat, lng]);
            }
            return points;
        }

        // 화물 유형 한글
        const cargoKr = {
            'container': '📦 컨테이너',
            'tanker': '🛢️ 유조선',
            'bulk': '🏭 벌크'
        };

        // 물류 추적 로드
        async function loadLogistics() {
            try {
                const res = await fetch(`${API_BASE}/api/logistics`);
                const data = await res.json();

                // 기존 마커/라인 제거
                markers.forEach(m => map.removeLayer(m));
                routeLines.forEach(l => map.removeLayer(l));
                markers = [];
                routeLines = [];

                // 상태/화물 유형별 색상
                const statusColors = {
                    'delivered': '#66bb6a',
                    'delayed': '#ef5350',
                    'in_transit': '#4fc3f7'
                };
                const cargoIcons = {
                    'container': '📦',
                    'tanker': '🛢️',
                    'bulk': '🏭'
                };
                const statusKr = {
                    'delivered': '도착 완료',
                    'delayed': '지연',
                    'in_transit': '운항 중'
                };

                data.forEach(ship => {
                    if (ship.lat && ship.lng) {
                        const color = statusColors[ship.status] || '#ffb74d';
                        const icon = cargoIcons[ship.cargo] || '🚢';

                        const originCoord = portCoords[ship.origin];
                        const destCoord = portCoords[ship.dest];
                        const shipCoord = [ship.lat, ship.lng];

                        // 툴팁 내용
                        const tooltipContent = `
                            <div style="font-size:12px;line-height:1.5;min-width:160px;">
                                <b>${cargoKr[ship.cargo] || '🚢 화물'}</b><br>
                                <hr style="margin:4px 0;border:none;border-top:1px solid #ddd;">
                                🚀 <b>출발:</b> ${ship.origin}<br>
                                　 ${ship.departure || '-'} (KST)<br>
                                🎯 <b>도착:</b> ${ship.dest}<br>
                                　 ${ship.arrival || '-'} (KST)
                            </div>
                        `;

                        // 실제 해상 항로로 경로 생성
                        if (originCoord && destCoord) {
                            const seaRoute = createSeaRoute(ship.origin, ship.dest);
                            const routePoints = seaRoute || [originCoord, destCoord];

                            // 점선 라인 (애니메이션 적용)
                            const dashLine = L.polyline(routePoints, {
                                color: color,
                                weight: 2,
                                opacity: 0.5,
                                dashArray: '12, 8',
                                className: 'animated-route'
                            }).addTo(map);
                            routeLines.push(dashLine);

                            // 화살표 데코레이터 (--->--->)
                            const arrowDecorator = L.polylineDecorator(routePoints, {
                                patterns: [
                                    {
                                        offset: 50,
                                        repeat: 100,
                                        symbol: L.Symbol.arrowHead({
                                            pixelSize: 10,
                                            polygon: false,
                                            pathOptions: {
                                                color: color,
                                                weight: 2.5,
                                                opacity: 0.9
                                            }
                                        })
                                    }
                                ]
                            }).addTo(map);
                            routeLines.push(arrowDecorator);

                            // 마우스 호버시 툴팁 표시
                            dashLine.bindTooltip(tooltipContent, {
                                sticky: true,
                                opacity: 0.95,
                                className: 'route-tooltip'
                            });
                        }

                        // 선박 마커
                        const marker = L.circleMarker(shipCoord, {
                            radius: 7,
                            fillColor: color,
                            color: '#fff',
                            weight: 2,
                            fillOpacity: 0.9
                        }).addTo(map);

                        marker.bindPopup(`
                            <div style="font-size:13px;">
                                <b>${icon} ${ship.vessel || ship.id}</b><br>
                                <span style="color:#666;">📍 ${ship.origin} → ${ship.dest}</span><br>
                                <span style="color:${color};font-weight:600;">● ${statusKr[ship.status] || ship.status}</span>
                            </div>
                        `);
                        markers.push(marker);
                    }
                });

                // 선박 수 표시
                if (data.length > 0) {
                    document.querySelector('.card:has(#map) h2').innerHTML =
                        `🗺️ 물류 추적 <span style="color:#4fc3f7;font-size:11px;">(${data.length}척 운항중)</span>`;
                }
            } catch (e) {
                console.error('Logistics load error:', e);
            }
        }

        // 요약 로드
        async function loadSummary() {
            try {
                const res = await fetch(`${API_BASE}/api/summary`);
                const data = await res.json();

                document.getElementById('totalRecords').textContent = data.total_records.toLocaleString();
                document.getElementById('buySignals').textContent = data.buy_signals;
                document.getElementById('sellSignals').textContent = data.sell_signals;
                document.getElementById('lastUpdate').textContent =
                    new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            } catch (e) {
                document.getElementById('lastUpdate').textContent = '연결 실패';
            }
        }

        // 전체 로드
        async function loadAll() {
            await Promise.all([
                loadSummary(),
                loadSectors(),
                loadSignals(),
                loadStocks(),
                loadIndicators(),
                loadFreight(),
                loadLogistics()
            ]);
        }

        // 초기화
        document.addEventListener('DOMContentLoaded', () => {
            initMap();
            loadAll();
            // 10초마다 자동 갱신
            setInterval(loadAll, 10000);
        });
    </script>
