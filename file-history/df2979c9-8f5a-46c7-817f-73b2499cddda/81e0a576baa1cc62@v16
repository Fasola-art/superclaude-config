        // 주요 해상 경유지 (실제 항로)
        const seaWaypoints = {
            'malacca': [1.3, 103.8],      // 말라카 해협
            'suez_n': [31.2, 32.3],        // 수에즈 운하 북쪽
            'suez_s': [29.9, 32.5],        // 수에즈 운하 남쪽
