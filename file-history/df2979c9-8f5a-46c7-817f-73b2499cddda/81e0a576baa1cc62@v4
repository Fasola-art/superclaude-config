<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🚢 SQL Trading - Live Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0a0a0f;
            color: #e0e0e0;
            min-height: 100vh;
        }
        .header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            padding: 15px 25px;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .header h1 { font-size: 20px; color: #fff; }
        .header-right { display: flex; align-items: center; gap: 15px; }
        .status { display: flex; align-items: center; gap: 8px; font-size: 13px; }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #00c853; animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .stats { display: flex; gap: 20px; font-size: 13px; color: #888; }
        .stats span { color: #4a90d9; font-weight: 600; }
        .container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: auto auto auto;
            gap: 15px;
            padding: 15px;
            max-width: 1800px;
            margin: 0 auto;
        }
        .card {
            background: #1a1a2e;
            border-radius: 10px;
            padding: 15px;
            border: 1px solid #2a2a4a;
        }
        .card h2 {
            font-size: 13px;
            color: #888;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .card.wide { grid-column: span 2; }
        .sector-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .sector-card {
            background: #252540;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            transition: transform 0.2s;
        }
        .sector-card:hover { transform: translateY(-2px); }
        .sector-card .emoji { font-size: 20px; }
        .sector-card .name { font-size: 11px; color: #888; margin-top: 4px; }
        .sector-card .value { font-size: 18px; font-weight: 700; margin-top: 4px; }
        .sector-card .count { font-size: 10px; color: #666; }
        .positive { color: #00c853 !important; }
        .negative { color: #ff5252 !important; }
        .signal-list { list-style: none; max-height: 280px; overflow-y: auto; }
        .signal-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 12px;
            margin: 6px 0;
            background: #252540;
            border-radius: 6px;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }
        .signal-item:hover { background: #2a2a5a; }
        .signal-item.buy { border-left-color: #00c853; }
        .signal-item.sell { border-left-color: #ff5252; }
        .signal-item .symbol { font-weight: 600; font-size: 14px; }
        .signal-item .price { color: #888; font-size: 12px; }
        .signal-item .meta { text-align: right; }
        .signal-badge {
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }
        .signal-badge.buy { background: rgba(0, 200, 83, 0.2); color: #00c853; }
        .signal-badge.sell { background: rgba(255, 82, 82, 0.2); color: #ff5252; }
        .confidence { font-size: 10px; color: #666; margin-top: 2px; }
        .stock-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; max-height: 280px; overflow-y: auto; }
        .stock-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 10px;
            background: #252540;
            border-radius: 6px;
        }
        .stock-item .symbol { font-weight: 600; font-size: 12px; }
        .stock-item .name { font-size: 10px; color: #888; }
        .stock-item .commodity { font-size: 9px; color: #4a90d9; margin-top: 2px; }
        .stock-item .change {
            font-weight: 600;
            font-size: 12px;
            padding: 2px 8px;
            border-radius: 10px;
        }
        .stock-item .change.positive { background: rgba(0, 200, 83, 0.15); }
        .stock-item .change.negative { background: rgba(255, 82, 82, 0.15); }
        .indicator-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
        .indicator-item {
            background: #252540;
            padding: 12px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .indicator-item .name { font-size: 11px; color: #888; }
        .indicator-item .value { font-size: 16px; font-weight: 600; }
        .indicator-item .change { font-size: 11px; margin-top: 2px; }
        .indicator-item .category { font-size: 9px; color: #666; }
        #map { height: 250px; border-radius: 8px; }
        .chart-container { height: 200px; }
        .loading { text-align: center; padding: 40px; color: #666; }
        .error { color: #ff5252; text-align: center; padding: 20px; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1a1a2e; }
        ::-webkit-scrollbar-thumb { background: #4a4a6a; border-radius: 3px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>🚢 원자재 물류 트레이딩</h1>
        <div class="header-right">
            <div class="stats">
                데이터: <span id="totalRecords">-</span>건 |
                📈 매수: <span id="buySignals">-</span> |
                📉 매도: <span id="sellSignals">-</span>
            </div>
            <div class="status">
                <div class="status-dot"></div>
                <span id="lastUpdate">연결 중...</span>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- 섹터 현황 -->
        <div class="card">
            <h2>📊 섹터별 현황 (물류 유형)</h2>
            <div class="sector-grid" id="sectorGrid">
                <div class="loading">로딩 중...</div>
            </div>
        </div>

        <!-- 트레이딩 신호 -->
        <div class="card">
            <h2>🎯 트레이딩 신호</h2>
            <ul class="signal-list" id="signalList">
                <div class="loading">로딩 중...</div>
            </ul>
        </div>

        <!-- 물류 지도 -->
        <div class="card wide">
            <h2>🗺️ 물류 추적</h2>
            <div id="map"></div>
        </div>

        <!-- 종목 현황 -->
        <div class="card wide">
            <h2>📈 종목별 원자재 현황</h2>
            <div class="stock-grid" id="stockGrid">
                <div class="loading">로딩 중...</div>
            </div>
        </div>

        <!-- 경제지표 -->
        <div class="card">
            <h2>🏛️ 경제지표 (FRED)</h2>
            <div class="indicator-grid" id="indicatorGrid">
                <div class="loading">로딩 중...</div>
            </div>
        </div>

        <!-- 운임 차트 -->
        <div class="card">
            <h2>📉 운임 지수</h2>
            <div class="chart-container">
                <canvas id="freightChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        const API_BASE = '';  // 같은 서버
        let freightChart = null;
        let map = null;
        let markers = [];

        // 섹터 이름 매핑 (한글)
        const sectorNames = {
            'dry_bulk': { emoji: '🏭', name: '벌크선 (철광석/석탄/곡물)', desc: '원자재 운송' },
            'container': { emoji: '📦', name: '컨테이너선 (소비재/전자)', desc: '완제품 운송' },
            'tanker': { emoji: '🛢️', name: '유조선 (원유/LNG)', desc: '에너지 운송' },
            'commodity': { emoji: '💎', name: '원자재 ETF', desc: '원자재 가격' },
            'index': { emoji: '📊', name: '주요 지수', desc: '시장 전체' }
        };

        // 종목별 상세 설명 (한글)
        const stockInfo = {
            // Dry Bulk - 벌크선 (철광석, 석탄, 곡물 운송)
            'SBLK': { name: 'Star Bulk', desc: '🏭 철광석/석탄 벌크선', commodity: '철광석, 석탄, 곡물' },
            'DSX': { name: 'Diana Shipping', desc: '🏭 건화물 벌크선', commodity: '철광석, 석탄' },
            'EGLE': { name: 'Eagle Bulk', desc: '🏭 중형 벌크선', commodity: '곡물, 시멘트, 비료' },
            'NMM': { name: 'Navios Partners', desc: '🏭 대형 벌크선', commodity: '철광석, 석탄' },
            'GNK': { name: 'Genco Shipping', desc: '🏭 건화물 전문', commodity: '철광석, 곡물, 보크사이트' },
            'GOGL': { name: 'Golden Ocean', desc: '🏭 초대형 벌크선', commodity: '철광석' },

            // Tanker - 유조선 (원유, 정제유, LNG)
            'FRO': { name: 'Frontline', desc: '🛢️ 초대형 유조선', commodity: '원유 (VLCC)' },
            'STNG': { name: 'Scorpio Tankers', desc: '🛢️ 정제유 운반선', commodity: '휘발유, 경유, 제트유' },
            'TNK': { name: 'Teekay Tankers', desc: '🛢️ 중형 유조선', commodity: '원유, 정제유' },

            // Container - 컨테이너선 (완제품, 소비재)
            'ZIM': { name: 'ZIM Shipping', desc: '📦 컨테이너선', commodity: '전자제품, 의류, 소비재' },
            'MATX': { name: 'Matson', desc: '📦 태평양 컨테이너', commodity: '소비재 (미국-아시아)' },
            'DAC': { name: 'Danaos Corp', desc: '📦 컨테이너 용선', commodity: '소비재, 전자제품' },

            // Commodity ETF - 원자재 가격 추적
            'DBC': { name: 'DB Commodity', desc: '💎 원자재 종합', commodity: '원유, 금, 농산물 종합' },
            'GSG': { name: 'S&P GSCI', desc: '💎 원자재 지수', commodity: '에너지 비중 높음' },
            'DBA': { name: 'DB Agriculture', desc: '🌾 농산물 ETF', commodity: '옥수수, 대두, 밀, 설탕' },
            'DBB': { name: 'DB Base Metals', desc: '⚙️ 비철금속 ETF', commodity: '구리, 알루미늄, 아연' },

            // Index
            '^GSPC': { name: 'S&P 500', desc: '📊 미국 대형주', commodity: '시장 전체' },
            '^DJI': { name: '다우존스', desc: '📊 미국 우량주', commodity: '산업주 30개' },
            '^IXIC': { name: '나스닥', desc: '📊 기술주 중심', commodity: '기술/성장주' },
        };

        // 지도 초기화
        function initMap() {
            map = L.map('map').setView([20, 100], 2);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            // 주요 항구
            const ports = [
                { name: "Shanghai", lat: 31.2, lng: 121.5 },
                { name: "Los Angeles", lat: 33.7, lng: -118.2 },
                { name: "Rotterdam", lat: 51.9, lng: 4.5 },
                { name: "Singapore", lat: 1.3, lng: 103.8 },
                { name: "Busan", lat: 35.1, lng: 129.0 },
            ];

            ports.forEach(port => {
                L.circleMarker([port.lat, port.lng], {
                    radius: 6,
                    fillColor: "#4a90d9",
                    color: "#fff",
                    weight: 1,
                    fillOpacity: 0.8
                }).addTo(map).bindPopup(`<b>${port.name}</b>`);
            });
        }

        // 섹터 데이터 로드
        async function loadSectors() {
            try {
                const res = await fetch(`${API_BASE}/api/sectors`);
                const data = await res.json();

                const grid = document.getElementById('sectorGrid');
                grid.innerHTML = data.map(s => {
                    const info = sectorNames[s.sector] || { emoji: '📊', name: s.sector, desc: '' };
                    const changeClass = s.change >= 0 ? 'positive' : 'negative';
                    const sign = s.change >= 0 ? '+' : '';
                    return `
                        <div class="sector-card" title="${info.desc}">
                            <div class="emoji">${info.emoji}</div>
                            <div class="name">${info.name}</div>
                            <div class="value ${changeClass}">${sign}${s.change}%</div>
                            <div class="count">${s.count}종목</div>
                        </div>
                    `;
                }).join('');
            } catch (e) {
                document.getElementById('sectorGrid').innerHTML = '<div class="error">데이터 로드 실패</div>';
            }
        }

        // 신호 데이터 로드
        async function loadSignals() {
            try {
                const res = await fetch(`${API_BASE}/api/signals`);
                const data = await res.json();

                const list = document.getElementById('signalList');
                if (data.length === 0) {
                    list.innerHTML = '<div class="loading">신호 없음</div>';
                    return;
                }

                list.innerHTML = data.map(s => {
                    const isBuy = s.signal.includes('BUY');
                    const signalClass = isBuy ? 'buy' : 'sell';
                    const info = stockInfo[s.symbol] || { desc: s.symbol, commodity: '' };
                    const signalText = {
                        'STRONG_BUY': '🔥 강력 매수',
                        'BUY': '📈 매수',
                        'STRONG_SELL': '💥 강력 매도',
                        'SELL': '📉 매도',
                        'OVERSOLD': '🔄 과매도'
                    }[s.signal] || s.signal;
                    return `
                        <li class="signal-item ${signalClass}" title="${info.commodity}">
                            <div>
                                <div class="symbol">${s.symbol}</div>
                                <div class="price">${info.desc} · $${s.price}</div>
                            </div>
                            <div class="meta">
                                <div class="signal-badge ${signalClass}">${signalText}</div>
                                <div class="confidence">${s.confidence}% 신뢰도</div>
                            </div>
                        </li>
                    `;
                }).join('');
            } catch (e) {
                document.getElementById('signalList').innerHTML = '<div class="error">데이터 로드 실패</div>';
            }
        }

        // 종목 데이터 로드
        async function loadStocks() {
            try {
                const res = await fetch(`${API_BASE}/api/stocks`);
                const data = await res.json();

                const grid = document.getElementById('stockGrid');
                const sorted = data.sort((a, b) => Math.abs(b.change) - Math.abs(a.change));

                grid.innerHTML = sorted.slice(0, 12).map(s => {
                    const changeClass = s.change >= 0 ? 'positive' : 'negative';
                    const sign = s.change >= 0 ? '+' : '';
                    const info = stockInfo[s.symbol] || { name: s.name, desc: s.name, commodity: '' };
                    return `
                        <div class="stock-item">
                            <div>
                                <div class="symbol">${s.symbol} <span style="color:#666;font-weight:normal;font-size:11px">$${s.price}</span></div>
                                <div class="name">${info.desc}</div>
                                ${info.commodity ? `<div class="commodity">→ ${info.commodity}</div>` : ''}
                            </div>
                            <div class="change ${changeClass}">${sign}${s.change}%</div>
                        </div>
                    `;
                }).join('');
            } catch (e) {
                document.getElementById('stockGrid').innerHTML = '<div class="error">데이터 로드 실패</div>';
            }
        }

        // 경제지표 로드
        async function loadIndicators() {
            try {
                const res = await fetch(`${API_BASE}/api/indicators`);
                const data = await res.json();

                const grid = document.getElementById('indicatorGrid');
                if (data.length === 0) {
                    grid.innerHTML = '<div class="loading">데이터 없음</div>';
                    return;
                }

                const icons = {
                    '금리': '📊',
                    '신용': '💳',
                    '에너지': '🛢️'
                };

                grid.innerHTML = data.map(ind => {
                    const changeClass = ind.change >= 0 ? 'positive' : 'negative';
                    const sign = ind.change >= 0 ? '+' : '';
                    const icon = icons[ind.category] || '📈';
                    const unit = ind.category === '에너지' ? '$' : '';
                    return `
                        <div class="indicator-item">
                            <div>
                                <div class="name">${icon} ${ind.name}</div>
                                <div class="category">${ind.date} 기준</div>
                            </div>
                            <div style="text-align:right">
                                <div class="value">${unit}${ind.value.toFixed(2)}</div>
                                <div class="change ${changeClass}">${sign}${ind.change.toFixed(2)}%</div>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (e) {
                document.getElementById('indicatorGrid').innerHTML = '<div class="error">로드 실패</div>';
            }
        }

        // 운임 차트 로드
        async function loadFreight() {
            try {
                const res = await fetch(`${API_BASE}/api/freight`);
                const data = await res.json();

                const labels = data.map(d => d.index === 'BDI' ? 'BDI' : d.route.split(' - ')[0].substring(0, 15));
                const values = data.map(d => d.value);
                const colors = data.map(d => d.change >= 0 ? 'rgba(0, 200, 83, 0.7)' : 'rgba(255, 82, 82, 0.7)');

                const ctx = document.getElementById('freightChart').getContext('2d');

                if (freightChart) freightChart.destroy();

                freightChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: colors,
                            borderRadius: 4,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(255,255,255,0.05)' },
                                ticks: { color: '#666', font: { size: 10 } }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { color: '#666', font: { size: 9 }, maxRotation: 45 }
                            }
                        }
                    }
                });
            } catch (e) {
                console.error('Freight load error:', e);
            }
        }

        // 물류 추적 로드
        async function loadLogistics() {
            try {
                const res = await fetch(`${API_BASE}/api/logistics`);
                const data = await res.json();

                // 기존 마커 제거
                markers.forEach(m => map.removeLayer(m));
                markers = [];

                data.forEach(ship => {
                    if (ship.lat && ship.lng) {
                        const color = ship.status === 'delivered' ? '#00c853' :
                                     ship.status === 'delayed' ? '#ff5252' : '#ffc107';
                        const marker = L.circleMarker([ship.lat, ship.lng], {
                            radius: 5,
                            fillColor: color,
                            color: '#fff',
                            weight: 1,
                            fillOpacity: 0.9
                        }).addTo(map);
                        marker.bindPopup(`
                            <b>${ship.vessel || ship.id}</b><br>
                            ${ship.origin} → ${ship.dest}<br>
                            상태: ${ship.status}
                        `);
                        markers.push(marker);
                    }
                });
            } catch (e) {
                console.error('Logistics load error:', e);
            }
        }

        // 요약 로드
        async function loadSummary() {
            try {
                const res = await fetch(`${API_BASE}/api/summary`);
                const data = await res.json();

                document.getElementById('totalRecords').textContent = data.total_records.toLocaleString();
                document.getElementById('buySignals').textContent = data.buy_signals;
                document.getElementById('sellSignals').textContent = data.sell_signals;
                document.getElementById('lastUpdate').textContent =
                    new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            } catch (e) {
                document.getElementById('lastUpdate').textContent = '연결 실패';
            }
        }

        // 전체 로드
        async function loadAll() {
            await Promise.all([
                loadSummary(),
                loadSectors(),
                loadSignals(),
                loadStocks(),
                loadIndicators(),
                loadFreight(),
                loadLogistics()
            ]);
        }

        // 초기화
        document.addEventListener('DOMContentLoaded', () => {
            initMap();
            loadAll();
            // 10초마다 자동 갱신
            setInterval(loadAll, 10000);
        });
    </script>
</body>
</html>
