/**
 * Speech-to-Text 통합 모듈
 * CLOVA Speech API + Whisper 지원
 */

import * as fs from 'node:fs/promises';
import * as path from 'node:path';
import { exec } from 'node:child_process';
import { promisify } from 'node:util';

const execAsync = promisify(exec);

// STT 프로바이더 타입
export type STTProvider = 'clova' | 'whisper';

// STT 결과
export interface STTResult {
  success: boolean;
  text?: string;
  provider: STTProvider;
  duration?: number;
  error?: string;
}

/**
 * CLOVA Speech API로 음성 변환
 */
async function transcribeWithClova(audioPath: string): Promise<STTResult> {
  const clientId = process.env['CLOVA_CLIENT_ID'];
  const clientSecret = process.env['CLOVA_CLIENT_SECRET'];

  if (!clientId || !clientSecret) {
    return {
      success: false,
      provider: 'clova',
      error: 'CLOVA API 키가 설정되지 않았습니다. docs/CLOVA-SETUP.md 참조',
    };
  }

  try {
    // 파일 읽기
    const audioData = await fs.readFile(audioPath);
    const ext = path.extname(audioPath).slice(1);

    // CLOVA Speech API 호출
    const response = await fetch(
      'https://clovaspeech-gw.ncloud.com/recog/v1/stt?lang=Kor',
      {
        method: 'POST',
        headers: {
          'Content-Type': `audio/${ext}`,
          'X-NCP-APIGW-API-KEY-ID': clientId,
          'X-NCP-APIGW-API-KEY': clientSecret,
        },
        body: audioData,
      }
    );

    if (!response.ok) {
      const errorText = await response.text();
      return {
        success: false,
        provider: 'clova',
        error: `CLOVA API 오류: ${response.status} - ${errorText}`,
      };
    }

    const result = await response.json() as { text?: string };

    return {
      success: true,
      text: result.text ?? '',
      provider: 'clova',
    };
  } catch (error) {
    const message = error instanceof Error ? error.message : '알 수 없는 오류';
    return {
      success: false,
      provider: 'clova',
      error: `CLOVA 변환 실패: ${message}`,
    };
  }
}

// Whisper 경로 (macOS Python 사용자 설치 경로)
const WHISPER_PATH = '/Users/reim/Library/Python/3.9/bin/whisper';

/**
 * Whisper로 음성 변환 (로컬 실행)
 */
async function transcribeWithWhisper(audioPath: string): Promise<STTResult> {
  try {
    // whisper 설치 확인
    try {
      await execAsync(`${WHISPER_PATH} --help`);
    } catch {
      return {
        success: false,
        provider: 'whisper',
        error: 'Whisper가 설치되지 않았습니다. `pip install openai-whisper` 실행',
      };
    }

    // Whisper 실행 (한국어, base 모델 - 속도 우선)
    const outputDir = path.dirname(audioPath);
    const { stdout, stderr } = await execAsync(
      `${WHISPER_PATH} "${audioPath}" --language Korean --model base --output_format txt --output_dir "${outputDir}"`,
      { timeout: 600000 } // 10분 타임아웃
    );

    if (stderr && !stderr.includes('100%')) {
      console.warn('Whisper 경고:', stderr);
    }

    // 결과 파일 읽기
    const baseName = path.basename(audioPath, path.extname(audioPath));
    const txtPath = path.join(outputDir, `${baseName}.txt`);

    const text = await fs.readFile(txtPath, 'utf-8');

    return {
      success: true,
      text: text.trim(),
      provider: 'whisper',
    };
  } catch (error) {
    const message = error instanceof Error ? error.message : '알 수 없는 오류';
    return {
      success: false,
      provider: 'whisper',
      error: `Whisper 변환 실패: ${message}`,
    };
  }
}

/**
 * 음성 파일을 텍스트로 변환
 */
export async function transcribe(
  audioPath: string,
  provider: STTProvider = 'whisper'
): Promise<STTResult> {
  // 파일 존재 확인
  try {
    await fs.access(audioPath);
  } catch {
    return {
      success: false,
      provider,
      error: `파일을 찾을 수 없습니다: ${audioPath}`,
    };
  }

  // 지원 포맷 확인
  const supportedFormats = ['.mp3', '.m4a', '.wav', '.aac', '.ogg', '.flac'];
  const ext = path.extname(audioPath).toLowerCase();
  if (!supportedFormats.includes(ext)) {
    return {
      success: false,
      provider,
      error: `지원하지 않는 포맷입니다: ${ext}. 지원 포맷: ${supportedFormats.join(', ')}`,
    };
  }

  // 프로바이더별 변환
  if (provider === 'clova') {
    return transcribeWithClova(audioPath);
  } else {
    return transcribeWithWhisper(audioPath);
  }
}

/**
 * Whisper 설치 여부 확인
 */
export async function checkWhisperInstalled(): Promise<boolean> {
  try {
    await execAsync(`${WHISPER_PATH} --help`);
    return true;
  } catch {
    return false;
  }
}

/**
 * CLOVA API 키 설정 여부 확인
 */
export function checkClovaConfigured(): boolean {
  return !!(process.env['CLOVA_CLIENT_ID'] && process.env['CLOVA_CLIENT_SECRET']);
}
