/**
 * 음악 수업 요약 시스템 타입 정의
 */

// 요약 템플릿 종류
export type SummaryTemplate =
  | 'lesson-note'    // 강의 노트 (계층화된 개요)
  | 'practice-list'  // 연습 과제 목록
  | 'key-points'     // 핵심 포인트
  | 'qa-format'      // Q&A 형식
  | 'timeline'       // 타임라인
  | 'full';          // 전체 (모든 템플릿 포함)

// 출력 형식
export type OutputFormat = 'markdown' | 'notion' | 'json';

// 우선순위
export type Priority = 'high' | 'medium' | 'low';

// 연습 과제
export interface PracticeTask {
  /** 과제 제목/곡명 */
  title: string;
  /** 연습 구간 (마디 번호 등) */
  sections?: string[];
  /** 연습 기법 */
  technique?: string;
  /** 목표 템포 */
  tempo?: string;
  /** 반복 횟수/시간 */
  repetition?: string;
  /** 우선순위 */
  priority: Priority;
  /** 마감일 */
  deadline?: string;
}

// 핵심 포인트
export interface KeyPoint {
  /** 주제 */
  topic: string;
  /** 설명 */
  explanation: string;
  /** 타임스탬프 (있는 경우) */
  timestamp?: string;
  /** 관련 코드/스케일 */
  relatedChords?: string[];
}

// 음악 코드/화성 정보
export interface MusicTheoryInfo {
  /** 언급된 코드 */
  chords: string[];
  /** 언급된 스케일 */
  scales: string[];
  /** 코드 진행 */
  progressions: string[];
  /** 조성 */
  key?: string;
}

// 다음 레슨 준비 사항
export interface NextLessonPrep {
  /** 목표 */
  goals: string[];
  /** 준비 사항 */
  preparation: string[];
}

// 전체 수업 요약 결과
export interface LessonSummary {
  /** 제목 */
  title: string;
  /** 날짜 */
  date: string;
  /** 수업 개요 */
  overview: string;
  /** 배운 내용 (계층화) */
  topics: {
    category: string;
    items: string[];
  }[];
  /** 연습 과제 */
  practiceTasks: PracticeTask[];
  /** 핵심 포인트 */
  keyPoints: KeyPoint[];
  /** 음악 이론 정보 */
  musicTheory: MusicTheoryInfo;
  /** 다음 레슨 */
  nextLesson: NextLessonPrep;
  /** 마인드맵 (Mermaid 형식) */
  mindmap?: string;
  /** 원본 텍스트 */
  rawText: string;
}

// CLI 옵션
export interface SummarizeOptions {
  /** 템플릿 */
  template: SummaryTemplate;
  /** 출력 형식 */
  output: OutputFormat;
  /** 출력 파일 경로 */
  outFile?: string;
  /** 언어 */
  language: 'ko' | 'en';
  /** 상세 모드 */
  verbose: boolean;
}

// 요약 요청
export interface SummarizeRequest {
  /** 입력 텍스트 또는 파일 경로 */
  input: string;
  /** 옵션 */
  options: SummarizeOptions;
}

// 요약 결과
export interface SummarizeResult {
  /** 성공 여부 */
  success: boolean;
  /** 요약 데이터 */
  data?: LessonSummary;
  /** 렌더링된 출력 */
  rendered?: string;
  /** 에러 메시지 */
  error?: string;
}
