/**
 * Notion API 연동 모듈
 * 요약 결과를 Notion 페이지로 업로드
 */

import { Client } from '@notionhq/client';
import type { LessonSummary, PracticeTask, KeyPoint } from '../types/index.js';

// Notion 클라이언트 싱글톤
let client: Client | null = null;

function getClient(): Client {
  if (!client) {
    const apiKey = process.env['NOTION_API_KEY'];
    if (!apiKey) {
      throw new Error(
        'NOTION_API_KEY 환경 변수가 설정되지 않았습니다.\n' +
        '.env 파일에 NOTION_API_KEY를 추가하세요.'
      );
    }
    client = new Client({ auth: apiKey });
  }
  return client;
}

/**
 * Notion API 설정 여부 확인
 */
export function checkNotionConfigured(): boolean {
  return !!process.env['NOTION_API_KEY'];
}

/**
 * 데이터베이스 ID 가져오기 (선택)
 */
function getDatabaseId(): string | null {
  return process.env['NOTION_DATABASE_ID'] ?? null;
}

/**
 * 기본 상위 페이지 ID 가져오기
 */
function getDefaultPageId(): string | null {
  return process.env['NOTION_PAGE_ID'] ?? null;
}

/**
 * 우선순위를 Notion select 색상으로 변환
 */
function priorityToColor(priority: string): 'red' | 'yellow' | 'green' {
  switch (priority) {
    case 'high': return 'red';
    case 'medium': return 'yellow';
    case 'low': return 'green';
    default: return 'yellow';
  }
}

/**
 * 마크다운 텍스트를 Notion 블록으로 변환
 */
function textToBlocks(text: string): any[] {
  const blocks: any[] = [];
  const lines = text.split('\n');

  for (const line of lines) {
    if (!line.trim()) continue;

    // 제목 (h1, h2, h3)
    if (line.startsWith('### ')) {
      blocks.push({
        object: 'block',
        type: 'heading_3',
        heading_3: {
          rich_text: [{ type: 'text', text: { content: line.slice(4) } }],
        },
      });
    } else if (line.startsWith('## ')) {
      blocks.push({
        object: 'block',
        type: 'heading_2',
        heading_2: {
          rich_text: [{ type: 'text', text: { content: line.slice(3) } }],
        },
      });
    } else if (line.startsWith('# ')) {
      blocks.push({
        object: 'block',
        type: 'heading_1',
        heading_1: {
          rich_text: [{ type: 'text', text: { content: line.slice(2) } }],
        },
      });
    }
    // 불릿 리스트
    else if (line.startsWith('- ') || line.startsWith('* ')) {
      blocks.push({
        object: 'block',
        type: 'bulleted_list_item',
        bulleted_list_item: {
          rich_text: [{ type: 'text', text: { content: line.slice(2) } }],
        },
      });
    }
    // 번호 리스트
    else if (/^\d+\.\s/.test(line)) {
      blocks.push({
        object: 'block',
        type: 'numbered_list_item',
        numbered_list_item: {
          rich_text: [{ type: 'text', text: { content: line.replace(/^\d+\.\s/, '') } }],
        },
      });
    }
    // 인용
    else if (line.startsWith('> ')) {
      blocks.push({
        object: 'block',
        type: 'quote',
        quote: {
          rich_text: [{ type: 'text', text: { content: line.slice(2) } }],
        },
      });
    }
    // 구분선
    else if (line.startsWith('---')) {
      blocks.push({
        object: 'block',
        type: 'divider',
        divider: {},
      });
    }
    // 일반 텍스트
    else {
      blocks.push({
        object: 'block',
        type: 'paragraph',
        paragraph: {
          rich_text: [{ type: 'text', text: { content: line } }],
        },
      });
    }
  }

  return blocks;
}

/**
 * 연습 과제를 To-do 블록으로 변환
 */
function practiceTasksToBlocks(tasks: PracticeTask[]): any[] {
  return tasks.map((task) => ({
    object: 'block',
    type: 'to_do',
    to_do: {
      rich_text: [
        {
          type: 'text',
          text: {
            content: `[${task.priority === 'high' ? '🔴' : task.priority === 'medium' ? '🟡' : '🟢'}] ${task.title}`,
          },
        },
        ...(task.sections ? [{
          type: 'text',
          text: { content: ` (${task.sections.join(', ')})` },
          annotations: { color: 'gray' },
        }] : []),
        ...(task.tempo ? [{
          type: 'text',
          text: { content: ` - ${task.tempo}` },
          annotations: { color: 'gray' },
        }] : []),
      ],
      checked: false,
    },
  }));
}

/**
 * 핵심 포인트를 콜아웃 블록으로 변환
 */
function keyPointsToBlocks(points: KeyPoint[]): any[] {
  return points.map((point, index) => ({
    object: 'block',
    type: 'callout',
    callout: {
      icon: { emoji: '💡' },
      rich_text: [
        {
          type: 'text',
          text: { content: `${index + 1}. ${point.topic}` },
          annotations: { bold: true },
        },
        {
          type: 'text',
          text: { content: `\n${point.explanation}` },
        },
      ],
    },
  }));
}

/**
 * LessonSummary를 Notion 페이지로 업로드
 */
export async function uploadToNotion(
  summary: LessonSummary,
  parentPageId?: string
): Promise<{ success: boolean; pageUrl?: string; error?: string }> {
  try {
    const notion = getClient();

    // 블록 구성
    const children: any[] = [];

    // 개요
    if (summary.overview) {
      children.push({
        object: 'block',
        type: 'quote',
        quote: {
          rich_text: [{ type: 'text', text: { content: summary.overview } }],
        },
      });
    }

    // 배운 내용
    if (summary.topics.length > 0) {
      children.push({
        object: 'block',
        type: 'heading_2',
        heading_2: {
          rich_text: [{ type: 'text', text: { content: '📋 오늘 배운 내용' } }],
        },
      });

      for (const topic of summary.topics) {
        children.push({
          object: 'block',
          type: 'heading_3',
          heading_3: {
            rich_text: [{ type: 'text', text: { content: topic.category } }],
          },
        });

        for (const item of topic.items) {
          children.push({
            object: 'block',
            type: 'bulleted_list_item',
            bulleted_list_item: {
              rich_text: [{ type: 'text', text: { content: item } }],
            },
          });
        }
      }
    }

    // 음악 이론
    if (summary.musicTheory.chords.length > 0 || summary.musicTheory.scales.length > 0) {
      children.push({
        object: 'block',
        type: 'heading_2',
        heading_2: {
          rich_text: [{ type: 'text', text: { content: '🎼 음악 이론' } }],
        },
      });

      if (summary.musicTheory.chords.length > 0) {
        children.push({
          object: 'block',
          type: 'bulleted_list_item',
          bulleted_list_item: {
            rich_text: [
              { type: 'text', text: { content: '코드: ' }, annotations: { bold: true } },
              { type: 'text', text: { content: summary.musicTheory.chords.join(', ') } },
            ],
          },
        });
      }

      if (summary.musicTheory.progressions.length > 0) {
        children.push({
          object: 'block',
          type: 'bulleted_list_item',
          bulleted_list_item: {
            rich_text: [
              { type: 'text', text: { content: '코드 진행: ' }, annotations: { bold: true } },
              { type: 'text', text: { content: summary.musicTheory.progressions.join(' | ') } },
            ],
          },
        });
      }
    }

    // 연습 과제
    if (summary.practiceTasks.length > 0) {
      children.push({
        object: 'block',
        type: 'heading_2',
        heading_2: {
          rich_text: [{ type: 'text', text: { content: '✅ 연습 과제' } }],
        },
      });

      children.push(...practiceTasksToBlocks(summary.practiceTasks));
    }

    // 핵심 포인트
    if (summary.keyPoints.length > 0) {
      children.push({
        object: 'block',
        type: 'heading_2',
        heading_2: {
          rich_text: [{ type: 'text', text: { content: '🎯 핵심 포인트' } }],
        },
      });

      children.push(...keyPointsToBlocks(summary.keyPoints));
    }

    // 다음 레슨
    if (summary.nextLesson.goals.length > 0) {
      children.push({
        object: 'block',
        type: 'heading_2',
        heading_2: {
          rich_text: [{ type: 'text', text: { content: '📅 다음 레슨' } }],
        },
      });

      for (const goal of summary.nextLesson.goals) {
        children.push({
          object: 'block',
          type: 'bulleted_list_item',
          bulleted_list_item: {
            rich_text: [{ type: 'text', text: { content: goal } }],
          },
        });
      }
    }

    // 부모 결정 (페이지 ID > 데이터베이스 ID > 기본 페이지 ID)
    const dbId = getDatabaseId();
    const defaultPageId = getDefaultPageId();

    let parent: { page_id: string } | { database_id: string };
    if (parentPageId) {
      parent = { page_id: parentPageId };
    } else if (dbId) {
      parent = { database_id: dbId };
    } else if (defaultPageId) {
      parent = { page_id: defaultPageId };
    } else {
      throw new Error(
        'Notion 상위 페이지/데이터베이스가 설정되지 않았습니다.\n' +
        '.env에 NOTION_PAGE_ID 또는 NOTION_DATABASE_ID를 추가하거나,\n' +
        '--page 옵션으로 상위 페이지 ID를 지정하세요.'
      );
    }

    // 페이지 생성
    const response = await notion.pages.create({
      parent,
      icon: { emoji: '🎵' },
      properties: {
        title: {
          title: [
            {
              text: { content: `${summary.title} - ${summary.date}` },
            },
          ],
        },
      },
      children: children.slice(0, 100), // Notion API 제한: 최대 100개 블록
    });

    return {
      success: true,
      pageUrl: (response as any).url,
    };
  } catch (error) {
    const message = error instanceof Error ? error.message : '알 수 없는 오류';
    return {
      success: false,
      error: `Notion 업로드 실패: ${message}`,
    };
  }
}

/**
 * 마크다운 텍스트를 Notion 페이지로 업로드
 */
export async function uploadMarkdownToNotion(
  title: string,
  markdown: string,
  parentPageId?: string
): Promise<{ success: boolean; pageUrl?: string; error?: string }> {
  try {
    const notion = getClient();
    const children = textToBlocks(markdown);

    // 부모 결정
    const dbId = getDatabaseId();
    const defaultPageId = getDefaultPageId();

    let parent: { page_id: string } | { database_id: string };
    if (parentPageId) {
      parent = { page_id: parentPageId };
    } else if (dbId) {
      parent = { database_id: dbId };
    } else if (defaultPageId) {
      parent = { page_id: defaultPageId };
    } else {
      throw new Error('Notion 상위 페이지/데이터베이스가 설정되지 않았습니다.');
    }

    const response = await notion.pages.create({
      parent,
      icon: { emoji: '🎵' },
      properties: {
        title: {
          title: [{ text: { content: title } }],
        },
      },
      children: children.slice(0, 100),
    });

    return {
      success: true,
      pageUrl: (response as any).url,
    };
  } catch (error) {
    const message = error instanceof Error ? error.message : '알 수 없는 오류';
    return {
      success: false,
      error: `Notion 업로드 실패: ${message}`,
    };
  }
}
