/**
 * Google Apps Script - 클로바 노트 자동 요약
 *
 * 설정 방법:
 * 1. https://script.google.com 접속
 * 2. 새 프로젝트 생성
 * 3. 이 코드 붙여넣기
 * 4. API_KEYS 설정
 * 5. 트리거 설정 (5분마다 실행)
 */

// ==================== 설정 ====================
const CONFIG = {
  // 감시할 Google Drive 폴더명
  WATCH_FOLDER: '클로바노트',

  // 처리 완료 파일 이동할 폴더명
  PROCESSED_FOLDER: '클로바노트_완료',

  // API 키 (스크립트 속성에서 설정 권장)
  ANTHROPIC_API_KEY: PropertiesService.getScriptProperties().getProperty('ANTHROPIC_API_KEY'),
  NOTION_API_KEY: PropertiesService.getScriptProperties().getProperty('NOTION_API_KEY'),
  NOTION_PAGE_ID: PropertiesService.getScriptProperties().getProperty('NOTION_PAGE_ID'),
};

// ==================== 메인 함수 ====================

/**
 * 메인 함수 - 트리거로 주기적 실행
 */
function processNewFiles() {
  const folder = getOrCreateFolder(CONFIG.WATCH_FOLDER);
  const processedFolder = getOrCreateFolder(CONFIG.PROCESSED_FOLDER);

  const files = folder.getFilesByType(MimeType.PLAIN_TEXT);

  while (files.hasNext()) {
    const file = files.next();
    const fileName = file.getName();

    Logger.log(`📥 파일 발견: ${fileName}`);

    try {
      // 1. 텍스트 읽기
      const content = file.getBlob().getDataAsString();

      // 2. Claude로 요약
      Logger.log('🤖 AI 요약 생성 중...');
      const summary = summarizeWithClaude(content);

      // 3. Notion에 업로드
      Logger.log('📤 Notion 업로드 중...');
      const notionUrl = uploadToNotion(summary);

      // 4. 처리 완료 - 파일 이동
      file.moveTo(processedFolder);

      Logger.log(`✅ 완료: ${fileName}`);
      Logger.log(`📄 Notion: ${notionUrl}`);

    } catch (error) {
      Logger.log(`❌ 오류 (${fileName}): ${error.message}`);
    }
  }
}

// ==================== Claude API ====================

function summarizeWithClaude(transcript) {
  const url = 'https://api.anthropic.com/v1/messages';

  const prompt = `## 작업
다음 음악 수업 녹음 전사본을 분석하여 구조화된 요약을 생성하세요.

## 출력 형식 (JSON)
{
  "title": "수업 제목",
  "date": "${new Date().toISOString().split('T')[0]}",
  "overview": "수업 개요 (2-3문장)",
  "topics": [{"category": "카테고리", "items": ["항목1", "항목2"]}],
  "practiceTasks": [{"title": "과제명", "priority": "high/medium/low", "tempo": "BPM"}],
  "keyPoints": [{"topic": "주제", "explanation": "설명"}]
}

## 수업 전사본
${transcript}`;

  const payload = {
    model: 'claude-sonnet-4-20250514',
    max_tokens: 4096,
    messages: [{
      role: 'user',
      content: prompt
    }]
  };

  const options = {
    method: 'post',
    headers: {
      'Content-Type': 'application/json',
      'x-api-key': CONFIG.ANTHROPIC_API_KEY,
      'anthropic-version': '2023-06-01'
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch(url, options);
  const result = JSON.parse(response.getContentText());

  if (result.error) {
    throw new Error(result.error.message);
  }

  // JSON 파싱
  const text = result.content[0].text;
  const jsonMatch = text.match(/\{[\s\S]*\}/);

  if (!jsonMatch) {
    throw new Error('JSON 응답 파싱 실패');
  }

  return JSON.parse(jsonMatch[0]);
}

// ==================== Notion API ====================

function uploadToNotion(summary) {
  const url = 'https://api.notion.com/v1/pages';

  const children = [];

  // 개요
  if (summary.overview) {
    children.push({
      object: 'block',
      type: 'quote',
      quote: { rich_text: [{ type: 'text', text: { content: summary.overview } }] }
    });
  }

  // 배운 내용
  if (summary.topics && summary.topics.length > 0) {
    children.push({
      object: 'block',
      type: 'heading_2',
      heading_2: { rich_text: [{ type: 'text', text: { content: '📋 오늘 배운 내용' } }] }
    });

    summary.topics.forEach(topic => {
      children.push({
        object: 'block',
        type: 'heading_3',
        heading_3: { rich_text: [{ type: 'text', text: { content: topic.category } }] }
      });

      topic.items.forEach(item => {
        children.push({
          object: 'block',
          type: 'bulleted_list_item',
          bulleted_list_item: { rich_text: [{ type: 'text', text: { content: item } }] }
        });
      });
    });
  }

  // 연습 과제
  if (summary.practiceTasks && summary.practiceTasks.length > 0) {
    children.push({
      object: 'block',
      type: 'heading_2',
      heading_2: { rich_text: [{ type: 'text', text: { content: '✅ 연습 과제' } }] }
    });

    summary.practiceTasks.forEach(task => {
      const emoji = task.priority === 'high' ? '🔴' : task.priority === 'medium' ? '🟡' : '🟢';
      children.push({
        object: 'block',
        type: 'to_do',
        to_do: {
          rich_text: [{ type: 'text', text: { content: `${emoji} ${task.title}` } }],
          checked: false
        }
      });
    });
  }

  const payload = {
    parent: { page_id: CONFIG.NOTION_PAGE_ID },
    icon: { emoji: '🎵' },
    properties: {
      title: {
        title: [{ text: { content: `${summary.title || '음악 레슨'} - ${summary.date}` } }]
      }
    },
    children: children.slice(0, 100)
  };

  const options = {
    method: 'post',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${CONFIG.NOTION_API_KEY}`,
      'Notion-Version': '2022-06-28'
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch(url, options);
  const result = JSON.parse(response.getContentText());

  if (result.object === 'error') {
    throw new Error(result.message);
  }

  return result.url;
}

// ==================== 유틸리티 ====================

function getOrCreateFolder(folderName) {
  const folders = DriveApp.getFoldersByName(folderName);

  if (folders.hasNext()) {
    return folders.next();
  }

  return DriveApp.createFolder(folderName);
}

// ==================== 설정 함수 ====================

/**
 * API 키 설정 (최초 1회 실행)
 */
function setApiKeys() {
  const props = PropertiesService.getScriptProperties();

  // 여기에 실제 API 키 입력
  props.setProperty('ANTHROPIC_API_KEY', 'sk-ant-api03-xxx');
  props.setProperty('NOTION_API_KEY', 'ntn_xxx');
  props.setProperty('NOTION_PAGE_ID', '2f8ecc9a6ef580018794f0ba232ece99');

  Logger.log('✅ API 키 설정 완료');
}

/**
 * 5분마다 실행 트리거 설정
 */
function createTimeTrigger() {
  // 기존 트리거 삭제
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(trigger => ScriptApp.deleteTrigger(trigger));

  // 5분마다 실행
  ScriptApp.newTrigger('processNewFiles')
    .timeBased()
    .everyMinutes(5)
    .create();

  Logger.log('✅ 트리거 설정 완료: 5분마다 실행');
}
