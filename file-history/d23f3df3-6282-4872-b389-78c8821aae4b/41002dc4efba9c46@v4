#!/usr/bin/env node

/**
 * Music Lesson Summarizer CLI
 * 음악 수업 녹음을 AI로 요약하는 CLI 도구
 */

import { Command } from 'commander';
import chalk from 'chalk';
import ora from 'ora';
import * as fs from 'node:fs/promises';
import * as path from 'node:path';
import { fileURLToPath } from 'node:url';
import { config } from 'dotenv';

// .env 로드
const __dirname = path.dirname(fileURLToPath(import.meta.url));
config({ path: path.resolve(__dirname, '../../.env') });

import { summarize } from '../core/summarizer.js';
import { askAboutLesson, generateMindmap } from '../integrations/claude.js';
import { transcribe, checkWhisperInstalled, checkClovaConfigured, type STTProvider } from '../integrations/stt.js';
import { uploadToNotion, uploadMarkdownToNotion, checkNotionConfigured } from '../integrations/notion.js';
import { getFullSummary } from '../integrations/claude.js';
import type { SummaryTemplate, OutputFormat } from '../types/index.js';

const program = new Command();

// 버전 및 설명
program
  .name('mls')
  .description('🎵 음악 수업 요약 자동화 도구')
  .version('0.1.0');

// summarize 명령어
program
  .command('summarize <input>')
  .alias('s')
  .description('수업 녹음/텍스트를 요약합니다')
  .option(
    '-t, --template <template>',
    '템플릿 선택 (lesson-note, practice-list, key-points, full)',
    'lesson-note'
  )
  .option(
    '-o, --output <format>',
    '출력 형식 (markdown, json)',
    'markdown'
  )
  .option('-f, --file <path>', '출력 파일 경로')
  .option('-v, --verbose', '상세 출력 (마인드맵 포함)', false)
  .action(async (input: string, options) => {
    const spinner = ora('수업 내용 분석 중...').start();

    try {
      const result = await summarize(input, {
        template: options.template as SummaryTemplate,
        output: options.output as OutputFormat,
        outFile: options.file,
        language: 'ko',
        verbose: options.verbose,
      });

      if (!result.success) {
        spinner.fail(chalk.red(`오류: ${result.error}`));
        process.exit(1);
      }

      spinner.succeed(chalk.green('요약 완료!'));
      console.log('');
      console.log(chalk.dim('─'.repeat(60)));
      console.log('');
      console.log(result.rendered);
      console.log('');
      console.log(chalk.dim('─'.repeat(60)));

      if (options.file) {
        console.log(chalk.cyan(`\n📁 저장됨: ${options.file}`));
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : '알 수 없는 오류';
      spinner.fail(chalk.red(`오류: ${message}`));
      process.exit(1);
    }
  });

// ask 명령어
program
  .command('ask <question>')
  .alias('a')
  .description('수업 내용에 대해 질문합니다')
  .option('-i, --input <path>', '수업 텍스트 파일 경로')
  .action(async (question: string, options) => {
    if (!options.input) {
      console.error(chalk.red('오류: --input 옵션으로 수업 텍스트 파일을 지정하세요.'));
      process.exit(1);
    }

    const spinner = ora('질문 분석 중...').start();

    try {
      const transcript = await fs.readFile(options.input, 'utf-8');
      const answer = await askAboutLesson(transcript, question);

      spinner.succeed(chalk.green('답변 완료!'));
      console.log('');
      console.log(chalk.cyan('Q: ') + question);
      console.log('');
      console.log(chalk.yellow('A: ') + answer);
    } catch (error) {
      const message = error instanceof Error ? error.message : '알 수 없는 오류';
      spinner.fail(chalk.red(`오류: ${message}`));
      process.exit(1);
    }
  });

// mindmap 명령어
program
  .command('mindmap <input>')
  .alias('m')
  .description('마인드맵을 생성합니다')
  .option('-f, --file <path>', '출력 파일 경로')
  .action(async (input: string, options) => {
    const spinner = ora('마인드맵 생성 중...').start();

    try {
      // 파일인지 확인
      let transcript: string;
      try {
        const stats = await fs.stat(input);
        if (stats.isFile()) {
          transcript = await fs.readFile(input, 'utf-8');
        } else {
          transcript = input;
        }
      } catch {
        transcript = input;
      }

      const mindmap = await generateMindmap(transcript);

      spinner.succeed(chalk.green('마인드맵 생성 완료!'));
      console.log('');
      console.log(chalk.cyan('```mermaid'));
      console.log(mindmap);
      console.log(chalk.cyan('```'));

      if (options.file) {
        const content = '```mermaid\n' + mindmap + '\n```';
        await fs.writeFile(options.file, content, 'utf-8');
        console.log(chalk.cyan(`\n📁 저장됨: ${options.file}`));
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : '알 수 없는 오류';
      spinner.fail(chalk.red(`오류: ${message}`));
      process.exit(1);
    }
  });

// transcribe 명령어 (음성 → 텍스트)
program
  .command('transcribe <audio>')
  .alias('tr')
  .description('음성 파일을 텍스트로 변환합니다')
  .option('-p, --provider <provider>', 'STT 프로바이더 (whisper, clova)', 'whisper')
  .option('-o, --output <path>', '출력 텍스트 파일 경로')
  .option('-s, --summarize', '변환 후 바로 요약', false)
  .option('-t, --template <template>', '요약 템플릿 (summarize 옵션 사용 시)', 'lesson-note')
  .action(async (audio: string, options) => {
    const provider = options.provider as STTProvider;

    // 프로바이더 확인
    if (provider === 'whisper') {
      const installed = await checkWhisperInstalled();
      if (!installed) {
        console.error(chalk.red('오류: Whisper가 설치되지 않았습니다.'));
        console.log(chalk.yellow('\n설치 방법:'));
        console.log('  pip install openai-whisper');
        console.log('  brew install ffmpeg');
        process.exit(1);
      }
    } else if (provider === 'clova') {
      if (!checkClovaConfigured()) {
        console.error(chalk.red('오류: CLOVA API 키가 설정되지 않았습니다.'));
        console.log(chalk.yellow('\n설정 방법: docs/CLOVA-SETUP.md 참조'));
        process.exit(1);
      }
    }

    const spinner = ora(`음성 변환 중 (${provider})...`).start();

    try {
      const result = await transcribe(audio, provider);

      if (!result.success) {
        spinner.fail(chalk.red(`오류: ${result.error}`));
        process.exit(1);
      }

      spinner.succeed(chalk.green('음성 변환 완료!'));

      // 텍스트 저장
      if (options.output && result.text) {
        await fs.writeFile(options.output, result.text, 'utf-8');
        console.log(chalk.cyan(`\n📁 저장됨: ${options.output}`));
      }

      // 요약 진행
      if (options.summarize && result.text) {
        console.log('');
        const summarySpinner = ora('요약 생성 중...').start();

        const summaryResult = await summarize(result.text, {
          template: options.template as SummaryTemplate,
          output: 'markdown',
          language: 'ko',
          verbose: false,
        });

        if (summaryResult.success) {
          summarySpinner.succeed(chalk.green('요약 완료!'));
          console.log('');
          console.log(chalk.dim('─'.repeat(60)));
          console.log(summaryResult.rendered);
          console.log(chalk.dim('─'.repeat(60)));
        } else {
          summarySpinner.fail(chalk.red(`요약 실패: ${summaryResult.error}`));
        }
      } else if (result.text) {
        // 변환된 텍스트 출력
        console.log('');
        console.log(chalk.dim('─'.repeat(60)));
        console.log(result.text);
        console.log(chalk.dim('─'.repeat(60)));
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : '알 수 없는 오류';
      spinner.fail(chalk.red(`오류: ${message}`));
      process.exit(1);
    }
  });

// notion 명령어 (Notion으로 내보내기)
program
  .command('notion <input>')
  .alias('n')
  .description('요약 결과를 Notion 페이지로 업로드합니다')
  .option('-t, --template <template>', '요약 템플릿', 'full')
  .option('-p, --page <pageId>', '상위 페이지 ID (선택)')
  .action(async (input: string, options) => {
    // Notion 설정 확인
    if (!checkNotionConfigured()) {
      console.error(chalk.red('오류: NOTION_API_KEY가 설정되지 않았습니다.'));
      console.log(chalk.yellow('\n.env 파일에 다음을 추가하세요:'));
      console.log('  NOTION_API_KEY=secret_xxx');
      console.log('  NOTION_DATABASE_ID=xxx (선택)');
      process.exit(1);
    }

    const spinner = ora('Notion 업로드 준비 중...').start();

    try {
      // 입력 파일 읽기
      let transcript: string;
      try {
        transcript = await fs.readFile(input, 'utf-8');
      } catch {
        transcript = input;
      }

      // 요약 생성
      spinner.text = '수업 내용 분석 중...';
      const summary = await getFullSummary(transcript);

      // Notion 업로드
      spinner.text = 'Notion에 업로드 중...';
      const result = await uploadToNotion(summary, options.page);

      if (!result.success) {
        spinner.fail(chalk.red(`오류: ${result.error}`));
        process.exit(1);
      }

      spinner.succeed(chalk.green('Notion 업로드 완료!'));
      console.log('');
      console.log(chalk.cyan(`📄 페이지 URL: ${result.pageUrl}`));
    } catch (error) {
      const message = error instanceof Error ? error.message : '알 수 없는 오류';
      spinner.fail(chalk.red(`오류: ${message}`));
      process.exit(1);
    }
  });

// templates 명령어
program
  .command('templates')
  .alias('t')
  .description('사용 가능한 템플릿 목록')
  .action(() => {
    console.log(chalk.cyan('\n📋 사용 가능한 템플릿:\n'));

    const templates = [
      { name: 'lesson-note', desc: '강의 노트 - 계층화된 수업 내용 정리' },
      { name: 'practice-list', desc: '연습 과제 - 숙제와 연습 목록 추출' },
      { name: 'key-points', desc: '핵심 포인트 - 중요한 내용 요약' },
      { name: 'qa-format', desc: 'Q&A 형식 - 질문-답변 정리' },
      { name: 'timeline', desc: '타임라인 - 시간순 정리' },
      { name: 'full', desc: '전체 요약 - 모든 정보 포함 (JSON)' },
    ];

    for (const t of templates) {
      console.log(`  ${chalk.yellow(t.name.padEnd(15))} ${t.desc}`);
    }

    console.log(chalk.dim('\n사용 예: mls summarize lesson.txt -t practice-list'));
  });

// 도움말 커스터마이징
program.addHelpText(
  'after',
  `
${chalk.cyan('사용 예시:')}
  $ mls summarize lesson.txt                    # 기본 강의 노트 생성
  $ mls summarize lesson.txt -t practice-list   # 연습 과제 추출
  $ mls summarize lesson.txt -t full -v         # 전체 요약 + 마인드맵
  $ mls transcribe recording.m4a                # 음성 → 텍스트 변환
  $ mls transcribe recording.m4a -s             # 음성 → 텍스트 → 요약
  $ mls notion lesson.txt                       # Notion으로 업로드
  $ mls ask "다음 숙제는?" -i lesson.txt        # 수업 내용 질문
  $ mls mindmap lesson.txt                      # 마인드맵 생성
  $ mls templates                               # 템플릿 목록 확인
`
);

// 실행
program.parse();
