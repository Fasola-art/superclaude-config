export const ASK_LESSON_PROMPT = `## 컨텍스트
다음은 음악 수업 녹음 전사본입니다.

## 수업 전사본
{transcript}

## 질문
{question}

## 규칙
- 전사본에 있는 내용만 기반으로 답변
- 추측하지 말고 "전사본에서 확인되지 않습니다"라고 답변
- 관련 인용구가 있으면 포함
- 한국어로 간결하게 답변`;

// 프롬프트 선택 함수
export function getPromptForTemplate(template: string): string {
  switch (template) {
    case 'lesson-note':
      return LESSON_NOTE_PROMPT;
    case 'practice-list':
      return PRACTICE_LIST_PROMPT;
    case 'key-points':
      return KEY_POINTS_PROMPT;
    case 'full':
      return FULL_SUMMARY_PROMPT;
    default:
      return LESSON_NOTE_PROMPT;
  }
}
