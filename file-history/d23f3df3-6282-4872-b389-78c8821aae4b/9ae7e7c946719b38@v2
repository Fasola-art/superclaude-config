/**
 * 요약 엔진 - 핵심 비즈니스 로직
 */

import * as fs from 'node:fs/promises';
import * as path from 'node:path';
import { summarizeLesson, getFullSummary, generateMindmap } from '../integrations/claude.js';
import type {
  SummaryTemplate,
  OutputFormat,
  SummarizeOptions,
  SummarizeResult,
  LessonSummary,
} from '../types/index.js';

/**
 * 입력 텍스트 또는 파일 읽기
 */
async function readInput(input: string): Promise<string> {
  // 파일 경로인지 확인
  try {
    const stats = await fs.stat(input);
    if (stats.isFile()) {
      return await fs.readFile(input, 'utf-8');
    }
  } catch {
    // 파일이 아니면 텍스트로 간주
  }

  // 직접 텍스트 입력
  return input;
}

/**
 * 출력 파일 저장
 */
async function saveOutput(
  content: string,
  outputPath: string
): Promise<void> {
  const dir = path.dirname(outputPath);
  await fs.mkdir(dir, { recursive: true });
  await fs.writeFile(outputPath, content, 'utf-8');
}

/**
 * 기본 출력 파일명 생성
 */
function generateOutputFilename(template: SummaryTemplate): string {
  const date = new Date().toISOString().split('T')[0];
  const templateNames: Record<SummaryTemplate, string> = {
    'lesson-note': '강의노트',
    'practice-list': '연습과제',
    'key-points': '핵심포인트',
    'qa-format': 'QA',
    'timeline': '타임라인',
    'full': '전체요약',
  };
  return `output/${date}-${templateNames[template]}.md`;
}

/**
 * JSON을 마크다운으로 렌더링
 */
function renderLessonSummaryToMarkdown(summary: LessonSummary): string {
  const lines: string[] = [];

  // 헤더
  lines.push(`# 🎵 ${summary.title} - ${summary.date}`);
  lines.push('');
  lines.push(`> ${summary.overview}`);
  lines.push('');

  // 배운 내용
  lines.push('## 📋 오늘 배운 내용');
  lines.push('');
  for (const topic of summary.topics) {
    lines.push(`### ${topic.category}`);
    for (const item of topic.items) {
      lines.push(`- ${item}`);
    }
    lines.push('');
  }

  // 음악 이론
  if (
    summary.musicTheory.chords.length > 0 ||
    summary.musicTheory.scales.length > 0
  ) {
    lines.push('## 🎼 음악 이론');
    lines.push('');
    if (summary.musicTheory.chords.length > 0) {
      lines.push(`- **코드**: ${summary.musicTheory.chords.join(', ')}`);
    }
    if (summary.musicTheory.scales.length > 0) {
      lines.push(`- **스케일**: ${summary.musicTheory.scales.join(', ')}`);
    }
    if (summary.musicTheory.progressions.length > 0) {
      lines.push(`- **코드 진행**: ${summary.musicTheory.progressions.join(' | ')}`);
    }
    if (summary.musicTheory.key) {
      lines.push(`- **조성**: ${summary.musicTheory.key}`);
    }
    lines.push('');
  }

  // 연습 과제
  if (summary.practiceTasks.length > 0) {
    lines.push('## ✅ 연습 과제');
    lines.push('');
    lines.push('| 우선순위 | 과제 | 구간 | 템포 | 시간 |');
    lines.push('|---------|------|------|------|------|');

    const priorityEmoji = { high: '🔴', medium: '🟡', low: '🟢' };

    for (const task of summary.practiceTasks) {
      const emoji = priorityEmoji[task.priority];
      const sections = task.sections?.join(', ') ?? '-';
      const tempo = task.tempo ?? '-';
      const repetition = task.repetition ?? '-';
      lines.push(`| ${emoji} | ${task.title} | ${sections} | ${tempo} | ${repetition} |`);
    }
    lines.push('');
  }

  // 핵심 포인트
  if (summary.keyPoints.length > 0) {
    lines.push('## 🎯 핵심 포인트');
    lines.push('');
    for (let i = 0; i < summary.keyPoints.length; i++) {
      const point = summary.keyPoints[i];
      if (!point) continue;
      lines.push(`### ${i + 1}. ${point.topic}`);
      lines.push('');
      lines.push(point.explanation);
      if (point.relatedChords && point.relatedChords.length > 0) {
        lines.push('');
        lines.push(`*관련 코드: ${point.relatedChords.join(', ')}*`);
      }
      lines.push('');
    }
  }

  // 다음 레슨
  if (
    summary.nextLesson.goals.length > 0 ||
    summary.nextLesson.preparation.length > 0
  ) {
    lines.push('## 📅 다음 레슨');
    lines.push('');
    if (summary.nextLesson.goals.length > 0) {
      lines.push('**목표:**');
      for (const goal of summary.nextLesson.goals) {
        lines.push(`- ${goal}`);
      }
      lines.push('');
    }
    if (summary.nextLesson.preparation.length > 0) {
      lines.push('**준비사항:**');
      for (const prep of summary.nextLesson.preparation) {
        lines.push(`- ${prep}`);
      }
      lines.push('');
    }
  }

  // 푸터
  lines.push('---');
  lines.push('*Generated by Music Lesson Summarizer*');

  return lines.join('\n');
}

/**
 * 메인 요약 함수
 */
export async function summarize(
  input: string,
  options: SummarizeOptions
): Promise<SummarizeResult> {
  try {
    // 1. 입력 읽기
    const transcript = await readInput(input);

    if (!transcript.trim()) {
      return {
        success: false,
        error: '입력 텍스트가 비어있습니다.',
      };
    }

    // 2. 요약 생성
    let rendered: string;
    let data: LessonSummary | undefined;

    if (options.template === 'full') {
      // 전체 요약 (JSON → 마크다운)
      data = await getFullSummary(transcript);
      rendered = renderLessonSummaryToMarkdown(data);

      // 마인드맵 추가
      if (options.verbose) {
        const mindmap = await generateMindmap(transcript);
        rendered += '\n\n## 🗺️ 마인드맵\n\n```mermaid\n' + mindmap + '\n```\n';
        data.mindmap = mindmap;
      }
    } else {
      // 특정 템플릿
      rendered = await summarizeLesson(transcript, options.template);
    }

    // 3. 출력 저장
    if (options.outFile) {
      await saveOutput(rendered, options.outFile);
    } else if (options.output === 'markdown') {
      const defaultPath = generateOutputFilename(options.template);
      await saveOutput(rendered, defaultPath);
    }

    return {
      success: true,
      data,
      rendered,
    };
  } catch (error) {
    const message = error instanceof Error ? error.message : '알 수 없는 오류';
    return {
      success: false,
      error: message,
    };
  }
}
