#!/usr/bin/env python3
"""
예약 데이터 수집기
- FRED: 매일 오전 9시 (경제 지표)
- COT: 매주 금요일 4시 (선물 포지션)
- Calendar: 경제 지표 발표 일정
- 뉴스: 매일 저녁 10시 (Bloomberg, Finviz)

사용법:
    python scheduled_collectors.py fred      # FRED 지표 수집
    python scheduled_collectors.py cot       # COT 보고서 수집
    python scheduled_collectors.py finviz    # Finviz 뉴스 수집
    python scheduled_collectors.py bloomberg # Bloomberg 뉴스 수집
    python scheduled_collectors.py calendar  # 경제 지표 일정표 생성
    python scheduled_collectors.py news      # 뉴스 전체 (finviz + bloomberg)
    python scheduled_collectors.py all       # 전체 수집
"""

import sys
import json
import urllib.request
import urllib.parse
from datetime import datetime
from pathlib import Path

# 모듈 경로 추가
sys.path.insert(0, str(Path.home() / ".claude" / "modules" / "trading"))
sys.path.insert(0, str(Path.home() / ".claude" / "modules" / "news-collector"))

LOG_DIR = Path.home() / ".claude" / "logs"
LOG_DIR.mkdir(parents=True, exist_ok=True)


def log_message(collector: str, message: str, level: str = "INFO"):
    """로그 기록"""
    timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    log_line = f"[{timestamp}] [{level}] [{collector}] {message}"
    print(log_line)

    log_file = LOG_DIR / f"scheduled_collectors_{datetime.now().strftime('%Y%m%d')}.log"
    with open(log_file, 'a', encoding='utf-8') as f:
        f.write(log_line + "\n")


def send_telegram(message: str, parse_mode: str = "HTML") -> bool:
    """텔레그램 알림 전송"""
    try:
        # API 키 로드
        keys_file = Path.home() / ".claude" / "credentials" / "api-keys.json"
        with open(keys_file, 'r', encoding='utf-8') as f:
            keys = json.load(f)

        bot_token = keys['telegram']['bot_token']
        chat_id = keys['telegram']['user_id']

        url = f"https://api.telegram.org/bot{bot_token}/sendMessage"
        data = urllib.parse.urlencode({
            'chat_id': chat_id,
            'text': message,
            'parse_mode': parse_mode
        }).encode('utf-8')

        req = urllib.request.Request(url, data=data)
        with urllib.request.urlopen(req, timeout=10) as response:
            return response.status == 200

    except Exception as e:
        log_message("TELEGRAM", f"알림 전송 실패: {e}", "ERROR")
        return False


def collect_fred():
    """FRED 경제 지표 수집"""
    log_message("FRED", "경제 지표 수집 시작")

    try:
        from data_sources.fred_monitor import FREDMonitor

        monitor = FREDMonitor()

        # 주요 지표 수집
        critical = monitor.get_all_critical_indicators()
        log_message("FRED", f"주요 지표 {len(critical)}개 수집")

        # 알림 체크
        alerts = monitor.check_for_alerts(threshold_pct=3.0)
        if alerts:
            log_message("FRED", f"알림 {len(alerts)}개 발생", "ALERT")
            for alert in alerts:
                log_message("FRED", f"  - {alert.message}", "ALERT")

        # 스냅샷 저장
        monitor.save_snapshot()

        log_message("FRED", "수집 완료")

        # 텔레그램 알림 (알림이 있을 때만)
        if alerts:
            alert_msgs = "\n".join([f"• {a.message}" for a in alerts[:5]])
            send_telegram(f"📈 <b>FRED 경제지표 알림</b>\n\n{alert_msgs}")

        return True

    except Exception as e:
        log_message("FRED", f"수집 실패: {e}", "ERROR")
        send_telegram(f"❌ FRED 수집 실패: {e}")
        return False


def collect_cot():
    """COT 보고서 수집"""
    log_message("COT", "COT 보고서 수집 시작")

    try:
        from data_sources.cot_report import COTCollector, get_next_release_date

        collector = COTCollector()

        # 주간 리포트 생성
        report = collector.generate_weekly_report()

        if report['report_date']:
            log_message("COT", f"보고서 날짜: {report['report_date']}")
            log_message("COT", f"강세 시장: {report['summary']['bullish_markets']}")
            log_message("COT", f"약세 시장: {report['summary']['bearish_markets']}")

            # 알림
            for alert in report['alerts']:
                log_message("COT", f"시그널: {alert['market']} - {alert['signal']}", "ALERT")

            # 저장
            collector.save_report(report)
            log_message("COT", "수집 완료")

            # 텔레그램 알림 전송
            bullish = ', '.join(report['summary']['bullish_markets'][:3]) or '없음'
            bearish = ', '.join(report['summary']['bearish_markets'][:3]) or '없음'
            alert_count = len(report['alerts'])

            tg_msg = f"""📊 <b>COT 리포트 수집 완료</b>

📅 보고서 날짜: {report['report_date']}

🟢 <b>강세</b>: {bullish}
🔴 <b>약세</b>: {bearish}
⚠️ 시그널: {alert_count}개

📁 ~/.claude/modules/trading/reports/cot/"""

            send_telegram(tg_msg)

            return True
        else:
            log_message("COT", "보고서 데이터 없음", "WARN")
            send_telegram("⚠️ COT 리포트: 데이터 없음")
            return False

    except Exception as e:
        log_message("COT", f"수집 실패: {e}", "ERROR")
        send_telegram(f"❌ COT 리포트 수집 실패: {e}")
        return False


def collect_finviz():
    """Finviz 뉴스/데이터 수집"""
    log_message("FINVIZ", "Finviz 데이터 수집 시작")

    try:
        from sources.finviz_collector import FinvizCollector

        collector = FinvizCollector()

        # 시장 뉴스 수집
        news = collector.get_news(limit=30)
        log_message("FINVIZ", f"뉴스 {len(news)}개 수집")

        # 주요 종목 가격
        tickers = ['SPY', 'QQQ', 'AAPL', 'MSFT', 'NVDA']
        for ticker in tickers:
            quote = collector.get_quote(ticker)
            if quote:
                log_message("FINVIZ", f"{ticker}: ${quote.price:.2f} ({quote.change_percent:+.2f}%)")

        # 아카이브 저장
        if news:
            collector.save_to_archive(news, "news")

        log_message("FINVIZ", "수집 완료")
        return True

    except Exception as e:
        log_message("FINVIZ", f"수집 실패: {e}", "ERROR")
        return False


def collect_bloomberg():
    """Bloomberg 뉴스 수집"""
    log_message("BLOOMBERG", "Bloomberg 뉴스 수집 시작")

    try:
        from sources.bloomberg_collector import BloombergCollector

        collector = BloombergCollector()

        # 속보 체크
        breaking = collector.get_breaking_news()
        if breaking:
            log_message("BLOOMBERG", f"속보 {len(breaking)}개", "ALERT")
            for article in breaking[:5]:
                log_message("BLOOMBERG", f"  - {article.title[:50]}...")

        # 전체 뉴스 수집
        all_news = collector.get_all_news(limit_per_category=20)
        total = sum(len(v) for v in all_news.values())
        log_message("BLOOMBERG", f"총 {total}개 기사 수집")

        # 저장
        collector.save_to_archive(all_news)

        log_message("BLOOMBERG", "수집 완료")
        return True

    except Exception as e:
        log_message("BLOOMBERG", f"수집 실패: {e}", "ERROR")
        return False


def collect_calendar():
    """경제 지표 일정표 생성"""
    log_message("CALENDAR", "경제 지표 일정표 생성 시작")

    try:
        from data_sources.economic_calendar import EconomicCalendar

        calendar = EconomicCalendar()

        # 오늘/내일 알림 체크
        alerts = calendar.check_alerts()
        if alerts:
            log_message("CALENDAR", f"알림 {len(alerts)}개", "ALERT")
            for alert in alerts:
                log_message("CALENDAR", f"  {alert['message']}", "ALERT")

        # 이번 주 이벤트
        this_week = calendar.get_this_week_events()
        log_message("CALENDAR", f"이번 주 이벤트 {len(this_week)}개")

        # 30일 일정표 저장
        calendar.save_calendar(30)

        log_message("CALENDAR", "일정표 생성 완료")
        return True

    except Exception as e:
        log_message("CALENDAR", f"생성 실패: {e}", "ERROR")
        return False


def collect_news():
    """뉴스 전체 수집 (Finviz + Bloomberg)"""
    log_message("NEWS", "뉴스 수집 시작 (저녁 정리)")

    results = {
        'finviz': collect_finviz(),
        'bloomberg': collect_bloomberg()
    }

    success = sum(1 for v in results.values() if v)
    log_message("NEWS", f"완료: {success}/2 성공")

    return results


def generate_report():
    """일일 경제 보고서 생성 (저녁 10시) - v2"""
    log_message("REPORT", "일일 경제 보고서 v2 생성 시작")

    try:
        from reports.daily_economic_report_v2 import generate_daily_report_v2

        filepath, report = generate_daily_report_v2()

        log_message("REPORT", f"보고서 생성 완료: {filepath}")

        # 시세표 요약
        valid_quotes = [q for q in report.quotes if q['price'] > 0]
        log_message("REPORT", f"시세: {len(valid_quotes)}/{len(report.quotes)} 수집 성공")

        # SOFR
        if report.sofr_current:
            log_message("REPORT", f"SOFR: {report.sofr_current:.2f}% - {report.sofr_analysis}")

        # 내일 주요 일정 알림
        if report.tomorrow_events:
            critical_events = [e for e in report.tomorrow_events if e['importance'] == 'critical']
            if critical_events:
                log_message("REPORT", f"⚠️ 내일 중요 지표 {len(critical_events)}개", "ALERT")
                for event in critical_events:
                    log_message("REPORT", f"  - {event['time']}: {event['name']}", "ALERT")

        return True

    except Exception as e:
        log_message("REPORT", f"보고서 생성 실패: {e}", "ERROR")
        import traceback
        log_message("REPORT", traceback.format_exc(), "ERROR")
        return False


def generate_outlook():
    """경제 시황 및 전망 생성 (Haiku API)"""
    log_message("OUTLOOK", "경제 시황 생성 시작")

    try:
        from reports.market_outlook import generate_market_outlook, save_outlook
        from reports.export_report import load_report_json

        report = load_report_json()
        if report:
            outlook = generate_market_outlook(report)
            save_outlook(outlook, report.get('date'))

            if outlook.get('generated'):
                log_message("OUTLOOK", f"시황 생성 완료 (모델: {outlook['model']}, 비용: ${outlook['cost']:.4f})")
            else:
                log_message("OUTLOOK", "기본 시황 사용 (API 키 없음)", "WARN")

            return True
        else:
            log_message("OUTLOOK", "보고서 데이터 없음", "WARN")
            return False

    except Exception as e:
        log_message("OUTLOOK", f"시황 생성 실패: {e}", "ERROR")
        import traceback
        log_message("OUTLOOK", traceback.format_exc(), "ERROR")
        return False


def export_report():
    """보고서 내보내기 (Excel + 이미지 + 시황 포함)"""
    log_message("EXPORT", "보고서 내보내기 시작")

    try:
        from reports.export_report import export_all, load_report_json, load_outlook

        report = load_report_json()
        outlook = load_outlook()

        if report:
            files = export_all(report, outlook)
            log_message("EXPORT", f"내보내기 완료: {len(files)}개 파일")
            for name, path in files.items():
                log_message("EXPORT", f"  - {name}: {path}")
            return True
        else:
            log_message("EXPORT", "보고서 데이터 없음", "WARN")
            return False

    except Exception as e:
        log_message("EXPORT", f"내보내기 실패: {e}", "ERROR")
        import traceback
        log_message("EXPORT", traceback.format_exc(), "ERROR")
        return False


def evening_routine():
    """저녁 10시 루틴 (뉴스 + 보고서 + 시황 + 내보내기)"""
    log_message("EVENING", "저녁 루틴 시작")

    results = {
        'news': collect_news(),
        'calendar': collect_calendar(),
        'report': generate_report(),
        'outlook': generate_outlook(),  # 시황 생성 추가
        'export': export_report()
    }

    success = sum(1 for v in results.values() if v)
    total = len(results)
    log_message("EVENING", f"완료: {success}/{total} 성공")

    # 내보내기 파일 위치 안내
    export_dir = Path.home() / ".claude" / "modules" / "trading" / "reports" / "export"
    log_message("EVENING", f"📁 내보내기 폴더: {export_dir}")

    # 텔레그램 알림
    status_icons = {True: "✅", False: "❌"}
    status_text = "\n".join([
        f"{status_icons[bool(v)]} {k}" for k, v in results.items()
    ])

    tg_msg = f"""🌙 <b>저녁 리포트 완료</b> ({success}/{total})

{status_text}

📁 {export_dir}"""

    send_telegram(tg_msg)

    return results


def collect_all():
    """전체 수집"""
    log_message("ALL", "전체 수집 시작")

    results = {
        'fred': collect_fred(),
        'calendar': collect_calendar(),
        'finviz': collect_finviz(),
        'bloomberg': collect_bloomberg()
    }

    # COT는 금요일에만
    if datetime.now().weekday() == 4:  # 금요일
        results['cot'] = collect_cot()

    success = sum(1 for v in results.values() if v)
    total = len(results)
    log_message("ALL", f"완료: {success}/{total} 성공")

    return results


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    command = sys.argv[1].lower()

    collectors = {
        'fred': collect_fred,
        'cot': collect_cot,
        'finviz': collect_finviz,
        'bloomberg': collect_bloomberg,
        'calendar': collect_calendar,
        'news': collect_news,
        'report': generate_report,
        'outlook': generate_outlook,
        'evening': evening_routine,  # 저녁 10시 전체 루틴
        'all': collect_all
    }

    if command in collectors:
        collectors[command]()
    else:
        print(f"알 수 없는 명령: {command}")
        print(f"사용 가능: {', '.join(collectors.keys())}")
        sys.exit(1)
