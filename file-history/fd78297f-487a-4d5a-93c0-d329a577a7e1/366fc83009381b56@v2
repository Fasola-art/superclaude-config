## HIGH: STRUCTURE (Test Structure)

### STRUCT-001: Arrange-Act-Assert (AAA)

```typescript
it('should apply discount to order', () => {
  // Arrange: Set up test data
  const order = new Order();
  order.addItem({ name: 'Widget', price: 100 });
  const discount = new PercentDiscount(10);

  // Act: Execute the behavior
  order.applyDiscount(discount);

  // Assert: Verify the result
  expect(order.total).toBe(90);
});
```

### STRUCT-002: One Assertion Per Test (Logical)

```typescript
// BAD: Multiple unrelated assertions
it('should process order', () => {
  expect(order.isValid).toBe(true);
  expect(order.total).toBe(100);
  expect(order.items.length).toBe(3);
  expect(user.orders.length).toBe(1);
});

// GOOD: One logical concept per test
it('should validate order', () => {
  expect(order.isValid).toBe(true);
});

it('should calculate total from items', () => {
  expect(order.total).toBe(100);
});

it('should contain expected items', () => {
  expect(order.items).toHaveLength(3);
});
```

### STRUCT-003: Descriptive Test Names

```typescript
// BAD: Vague names
it('should work');
it('test user');
it('handles error');

// GOOD: Describe behavior
it('should return empty array when no users found');
it('should throw ValidationError when email is invalid');
it('should retry 3 times on network failure');
```

### STRUCT-004: Test Isolation

```typescript
// BAD: Tests depend on each other
let user: User;

it('should create user', () => {
  user = createUser({ name: 'Alice' });
  expect(user.id).toBeDefined();
});

it('should update user', () => {
  user.name = 'Bob';  // Depends on previous test!
  expect(user.name).toBe('Bob');
});

// GOOD: Independent tests
describe('User', () => {
  let user: User;

  beforeEach(() => {
    user = createUser({ name: 'Alice' });
  });

  it('should update name', () => {
    user.name = 'Bob';
    expect(user.name).toBe('Bob');
  });
});
```

